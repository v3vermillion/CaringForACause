# Search engines are blocked unless this is exactly "true".
# Leave it unset for private previews. Set it in Cloudflare build settings only at launch.
PUBLIC_ALLOW_INDEXING=false

# Absolute address of the deployment. Leave unset for production builds; set it
# on a preview deploy (e.g. the workers.dev address) so the canonical URL and the
# sharing image resolve on the host that is serving the page.
# PUBLIC_SITE_URL=https://caring-for-a-cause.forgetraining.workers.dev
