# Search engines are blocked unless this is exactly "true".
# Leave it unset for private previews. Set it in Cloudflare build settings only at launch.
PUBLIC_ALLOW_INDEXING=false

# Absolute site address for the canonical URL and link-preview image.
# Unset: builds use the production domain. Only a public build (indexing on)
# names it in the pages; a preview names no address. At launch, set it in Cloudflare to:
# PUBLIC_SITE_URL=https://caring4acausesupportiveservices.com
