{
  "name": "caring-for-a-cause",
  "version": "0.1.0",
  "private": true,
  "description": "Website for Caring for a Cause Supportive Services Inc. (Central Indiana)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/validate-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run build && npm run test:gate && npm run test",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test": "playwright test",
    "test:gate": "node --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "browserslist": "^4.29.1",
    "lightningcss": "^1.33.0",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.145.0"
  },
  "browserslist": [
    "defaults",
    "iOS >= 15",
    "Safari >= 15",
    "Chrome >= 100",
    "Firefox >= 100",
    "Samsung >= 20",
    "not dead"
  ]
}
