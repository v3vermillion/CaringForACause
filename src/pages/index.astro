---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Gallery from "../components/Gallery.astro";
import GetInvolved from "../components/GetInvolved.astro";
import Hero from "../components/Hero.astro";
import ProgramStrip from "../components/ProgramStrip.astro";
import Programs from "../components/Programs.astro";
import SeasonalBanner from "../components/SeasonalBanner.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
---

<Base preloadItalic>
  <SiteHeader />
  <main id="main">
    <!-- On desktop these three fill the first screen: the banner takes the
         slack so the season strip ends exactly at the fold. -->
    <div class="first-screen">
      <Hero />
      <ProgramStrip />
      <SeasonalBanner />
    </div>
    <!-- The first screen takes the window's height as it was when the page
         opened, and again whenever the window's width changes (a resize, a
         rotation). A change of height alone (a tablet's browser bar
         collapsing, a tool stretching the window to photograph the whole
         page) leaves it as it is, so nothing below it moves. Without
         JavaScript the stylesheet's own viewport height applies. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var width = innerWidth;
        var fit = function () {
          root.style.setProperty("--first-screen-vh", innerHeight + "px");
        };
        fit();
        addEventListener("resize", function () {
          if (innerWidth === width) return;
          width = innerWidth;
          fit();
        });
      })();
    </script>
    <Programs />
    <GetInvolved />
    <About />
    <Gallery />
    <Contact />
  </main>
  <SiteFooter />
</Base>

<style>
  /* Tablets and desktop: phones stay content-sized (no viewport-height units
     there; see docs/DESIGN.md). A tablet's or desktop browser's bars don't
     change the height while scrolling, so 100vh is stable. */
  @media (min-width: 36rem) {
    .first-screen {
      display: flex;
      flex-direction: column;
      min-height: calc(var(--first-screen-vh, 100vh) - var(--top-chrome));
    }
    .first-screen > :global(.hero) {
      flex: 1;
    }
  }

  /* Desktop: one composition at every screen size. The banner and the strip
     under it fill the first screen above the season strip, and every size in
     them is a multiple of --u, one pixel of the reference layout (a 1280 × 800
     screen, where the banner is 577px tall and the strip 136). Taller screens
     scale it up, shorter ones down, so the picture is the same on every
     computer. The width bounds it too (a portrait screen such as an iPad Pro
     12.9 upright is tall but narrow), so the text column never outgrows its
     45% of the screen and the headline keeps its four lines. Below two thirds
     the type would get too small, so the scale stops there and the season
     strip drops just under the fold instead; above 1.25 (a 1600px screen) it
     stops with the rest of the site (decision 53), and the photo fills the
     room left. */
  @media (min-width: 56rem) {
    .first-screen {
      --u: clamp(
        0.66px,
        min(
          calc((var(--first-screen-vh, 100vh) - var(--top-chrome) - var(--strips-h)) / 713),
          calc(100vw / 1280)
        ),
        1.25px
      );
    }
  }
</style>
