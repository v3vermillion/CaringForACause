---
import About from "../components/About.astro";
import Gallery from "../components/Gallery.astro";
import GetInvolved from "../components/GetInvolved.astro";
import Hero from "../components/Hero.astro";
import Programs from "../components/Programs.astro";
import SeasonalBanner from "../components/SeasonalBanner.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TrustFacts from "../components/TrustFacts.astro";
import Base from "../layouts/Base.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { hero } from "../data/site";

// Preload the first hero photo (the largest element on the first screen).
const photos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const first = photos[`../assets/photos/${hero.montage[0]!.file}`]!.default;
const preload = await getImage({
  src: first,
  format: "avif",
  quality: 55,
  widths: [480, 720],
});
const preloadImage = {
  srcset: preload.srcSet.attribute,
  sizes: "(min-width: 56rem) 560px, 100vw",
  type: "image/avif",
};
---

<Base preloadImage={preloadImage}>
  <SiteHeader />
  <main id="main">
    <Hero />
    <SeasonalBanner />
    <TrustFacts />
    <Programs />
    <GetInvolved />
    <About />
    <Gallery />
  </main>
  <SiteFooter />
</Base>
