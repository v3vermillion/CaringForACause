---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { show } from "../data/facts.ts";
import { facts } from "../data/site";

const phone = show(facts.phone);
---

<Base title="Page not found">
  <SiteHeader />
  <main id="main" class="section">
    <div class="wrap stack">
      <div>
        <span class="eyebrow">Page not found</span>
        <h1>This page doesn't exist</h1>
      </div>
      <p>
        The link may be out of date. Go to the <a href="/">home page</a>, or call us at{" "}
        <a href={phone.href}>{phone.display}</a>.
      </p>
      <p class="button-row">
        <a class="button button--purple" href="/">
          Home page
        </a>
        <a class="button button--outline" href="/apply">
          Help me
        </a>
        <a class="button button--outline" href="/donate">
          Donate
        </a>
      </p>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  /* A page-opener heading, not the banner's: one step down. */
  h1 {
    font-size: var(--step-3);
  }
</style>
