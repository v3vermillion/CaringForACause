---
import SiteFooter from "../components/SiteFooter.astro";
import Photo from "../components/Photo.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Wave from "../components/Wave.astro";
import Base from "../layouts/Base.astro";
import { claim, show } from "../data/facts.ts";
import { applyPage, facts, getHelp, links, org } from "../data/site";

const phone = show(facts.phone);
const email = show(facts.email);
const mailto = `mailto:${email}?subject=${encodeURIComponent(applyPage.emailSubject)}`;
const description = `Apply for holiday meals and gifts, monthly diapers, school supplies, or a free haircut in ${claim(facts.serviceArea)}. Anyone struggling right now can apply.`;

const steps = applyPage.steps;
const stepCount = steps.length;
const adults = ["1", "2", "3", "4", "5", "6 or more"];
const children = ["0", "1", "2", "3", "4", "5", "6", "7", "8 or more"];
const ages = ["Under 1", ...Array.from({ length: 17 }, (_, i) => String(i + 1))];
const heard = [
  "Facebook",
  "A friend or family member",
  "A school",
  "A church",
  "Another organization",
  "Other",
];
/** The follow-up list a kind of help opens, keyed as `applyPage.needs[].followUp` names it. */
const followUps = {
  holidays: { legend: "Which holidays?", options: applyPage.holidays },
  diaperSizes: { legend: "Which sizes?", options: applyPage.diaperSizes },
  grades: { legend: "Which grades?", options: applyPage.grades },
};
/**
 * The aside's heading asks the question, so its body is the home card's line
 * without the question it opens with.
 */
const sideBody = getHelp.talk.body;
---

<Base title={`Apply for help | ${org.shortName}`} description={description}>
  <SiteHeader />
  <main id="main">
    <section class="page-hero on-dark">
      <div class="wrap">
        <div class="opener-words">
          <span class="eyebrow">{applyPage.eyebrow}</span>
          <h1>{applyPage.heading}</h1>
          <p class="lede">{getHelp.whoCanApply}</p>
          <p class="talk">
            {applyPage.intro}{" "}
            <span class="talk-offer">
              Prefer to talk? Call <a href={phone.href}>{phone.display}</a> or email{" "}
              <a href={`mailto:${email}`}>{email}</a>.
            </span>
          </p>
        </div>
        <div class="opener-photo plate">
          <Photo
            photo={applyPage.photo}
            ratio="5 / 4"
            sizes="(min-width: 56rem) 352px, 1px"
            widths={[352, 704]}
          />
        </div>
      </div>
      <Wave kind="into-paper" id="wp" above="none" belowGround="paper" class="page-wave" />
    </section>

    <section class="section ground" aria-labelledby="form-title">
      <div class="wrap">
        <div class="layout">
          <div class="main">
            <h2 id="form-title" class="visually-hidden">
              Application form
            </h2>

            {links.familyApplication && (
              <p class="online">
                <a
                  class="button button--purple"
                  href={links.familyApplication}
                  target="_blank"
                  rel="noopener"
                >
                  Use our online application
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </p>
            )}

            <noscript>
              <p class="noscript">
                {applyPage.noScript} Call <a href={phone.href}>{phone.display}</a> or email{" "}
                <a href={mailto}>{email}</a>.
              </p>
            </noscript>

            <form class="apply" data-apply novalidate>
              <ol class="progress" aria-label="Steps">
                {steps.map((step, i) => (
                  <li data-progress={step.id} aria-current={i === 0 ? "step" : undefined}>
                    <button type="button" class="progress-go" data-goto={i} disabled>
                      <span class="num" aria-hidden="true">
                        {i + 1}
                      </span>
                      <span class="step-title">
                        <span class="step-prefix">
                          Step {i + 1} of {stepCount}:{" "}
                        </span>
                        {step.title}
                      </span>
                    </button>
                  </li>
                ))}
              </ol>
              <p class="visually-hidden" aria-live="polite" data-step-live></p>

              <div class="sheet surface">
                <!-- Step 1: about you -->
                <fieldset class="step" data-step="you">
                  <legend>
                    <span class="eyebrow">Step 1 of {stepCount}</span>
                    <span class="legend-title" tabindex="-1" data-step-title>
                      {steps[0]!.title}
                    </span>
                    <span class="legend-hint">{steps[0]!.hint}</span>
                  </legend>
                  <div class="fields two">
                    <div class="field">
                      <label for="firstName">First name</label>
                      <input
                        class="input"
                        id="firstName"
                        name="firstName"
                        autocomplete="given-name"
                        autocapitalize="words"
                        spellcheck="false"
                        enterkeyhint="next"
                        required
                      />
                    </div>
                    <div class="field">
                      <label for="lastName">Last name</label>
                      <input
                        class="input"
                        id="lastName"
                        name="lastName"
                        autocomplete="family-name"
                        autocapitalize="words"
                        spellcheck="false"
                        enterkeyhint="next"
                        required
                      />
                    </div>
                    <div class="field">
                      <label for="phone">Phone number</label>
                      <input
                        class="input"
                        id="phone"
                        name="phone"
                        type="tel"
                        autocomplete="tel"
                        inputmode="tel"
                        enterkeyhint="next"
                        maxlength="14"
                        required
                        data-kind="phone"
                      />
                    </div>
                    <div class="field">
                      <label for="email">
                        Email{" "}
                        <span class="optional" data-email-optional>
                          (optional)
                        </span>
                      </label>
                      <input
                        class="input"
                        id="email"
                        name="email"
                        type="email"
                        autocomplete="email"
                        inputmode="email"
                        autocapitalize="none"
                        spellcheck="false"
                        enterkeyhint="next"
                      />
                    </div>
                  </div>
                  <fieldset class="field">
                    <legend class="label">Best way to reach you</legend>
                    <div class="choices">
                      {applyPage.contactMethods.map((method, i) => (
                        <label class="choice">
                          <input
                            type="radio"
                            name="contactMethod"
                            value={method}
                            checked={i === 0}
                          />
                          {method}
                        </label>
                      ))}
                    </div>
                  </fieldset>
                </fieldset>

                <!-- Step 2: household -->
                <fieldset class="step" data-step="household" hidden>
                  <legend>
                    <span class="eyebrow">Step 2 of {stepCount}</span>
                    <span class="legend-title" tabindex="-1" data-step-title>
                      {steps[1]!.title}
                    </span>
                    <span class="legend-hint">{steps[1]!.hint}</span>
                  </legend>
                  <div class="fields">
                    <div class="field">
                      <label for="street">Street address</label>
                      <input
                        class="input"
                        id="street"
                        name="street"
                        autocomplete="address-line1"
                        enterkeyhint="next"
                        required
                      />
                    </div>
                  </div>
                  <div class="fields three">
                    <div class="field">
                      <label for="city">City</label>
                      <input
                        class="input"
                        id="city"
                        name="city"
                        autocomplete="address-level2"
                        autocapitalize="words"
                        enterkeyhint="next"
                        required
                      />
                    </div>
                    <div class="field">
                      <label for="zip">ZIP code</label>
                      <input
                        class="input"
                        id="zip"
                        name="zip"
                        autocomplete="postal-code"
                        inputmode="numeric"
                        enterkeyhint="next"
                        maxlength="10"
                        required
                        data-kind="zip"
                      />
                    </div>
                    <div class="field">
                      <label for="county">County</label>
                      <select class="select" id="county" name="county" enterkeyhint="next" required>
                        <option value="">Choose one</option>
                        {applyPage.counties.map((c) => (
                          <option value={c}>{c}</option>
                        ))}
                      </select>
                    </div>
                  </div>
                  <div class="fields two">
                    <div class="field">
                      <label for="adults">Adults in your household</label>
                      <select class="select" id="adults" name="adults" enterkeyhint="next" required>
                        {adults.map((n) => (
                          <option value={n}>{n}</option>
                        ))}
                      </select>
                    </div>
                    <div class="field">
                      <label for="childCount">Children in your household</label>
                      <select
                        class="select"
                        id="childCount"
                        name="childCount"
                        enterkeyhint="next"
                        required
                        data-child-count
                      >
                        {children.map((n) => (
                          <option value={n}>{n}</option>
                        ))}
                      </select>
                    </div>
                  </div>
                  <div class="children" data-children hidden>
                    <p class="children-label">About each child</p>
                    <p class="hint">
                      Ages help us match gifts and supplies. Everything else here is optional.
                    </p>
                    <div class="child-rows" data-child-rows></div>
                  </div>
                  <template data-child-template>
                    <div class="child-row">
                      <p class="child-heading" data-child-heading>
                        Child
                      </p>
                      <div class="child-fields">
                        <div class="field">
                          <label>
                            <span class="visually-hidden" data-child-prefix></span>Age
                          </label>
                          <select class="select" name="childAge" enterkeyhint="next" required>
                            <option value="">Choose one</option>
                            {ages.map((a) => (
                              <option value={a}>{a}</option>
                            ))}
                          </select>
                        </div>
                        <div class="field">
                          <label>
                            <span class="visually-hidden" data-child-prefix></span>Girl or boy{" "}
                            <span class="optional">(optional)</span>
                          </label>
                          <select class="select" name="childGender" enterkeyhint="next">
                            <option value="">Choose one</option>
                            <option value="Girl">Girl</option>
                            <option value="Boy">Boy</option>
                            <option value="Prefer not to say">Prefer not to say</option>
                          </select>
                        </div>
                        <div class="field">
                          <label>
                            <span class="visually-hidden" data-child-prefix></span>Clothing size{" "}
                            <span class="optional">(optional)</span>
                          </label>
                          <input
                            class="input"
                            name="childClothing"
                            autocomplete="off"
                            enterkeyhint="next"
                            placeholder="e.g. 5T, youth M"
                          />
                        </div>
                        <div class="field">
                          <label>
                            <span class="visually-hidden" data-child-prefix></span>Shoe size{" "}
                            <span class="optional">(optional)</span>
                          </label>
                          <input
                            class="input"
                            name="childShoe"
                            autocomplete="off"
                            enterkeyhint="next"
                            placeholder="e.g. 12C"
                          />
                        </div>
                      </div>
                    </div>
                  </template>
                </fieldset>

                <!-- Step 3: what you need -->
                <fieldset class="step" data-step="needs" hidden>
                  <legend>
                    <span class="eyebrow">Step 3 of {stepCount}</span>
                    <span class="legend-title" tabindex="-1" data-step-title>
                      {steps[2]!.title}
                    </span>
                    <span class="legend-hint">{steps[2]!.hint}</span>
                  </legend>
                  <fieldset class="needs">
                    <legend class="visually-hidden">Kinds of help</legend>
                    <p class="error" data-needs-error role="alert" hidden>
                      Choose at least one kind of help.
                    </p>
                    {applyPage.needs.map((need) => (
                      <div class="need">
                        <label class="need-card">
                          <input
                            type="checkbox"
                            name="need"
                            value={need.title}
                            data-toggle={need.id}
                          />
                          <span class="need-title">{need.title}</span>
                          <span class="need-line">{need.line}</span>
                        </label>
                        {need.followUp && (
                          <fieldset class="sub" data-sub={need.id} hidden>
                            <legend class="label">{followUps[need.followUp].legend}</legend>
                            <div class="choices">
                              {followUps[need.followUp].options.map((option) => (
                                <label class="choice">
                                  <input type="checkbox" name={need.followUp} value={option} />
                                  {option}
                                </label>
                              ))}
                            </div>
                          </fieldset>
                        )}
                      </div>
                    ))}
                  </fieldset>

                  <div class="field">
                    <label for="notes">
                      Anything else we should know? <span class="optional">(optional)</span>
                    </label>
                    <textarea class="textarea" id="notes" name="notes" rows="4"></textarea>
                  </div>
                  <div class="field">
                    <label for="heard">
                      How did you hear about us? <span class="optional">(optional)</span>
                    </label>
                    <select class="select" id="heard" name="heard" enterkeyhint="next">
                      <option value="">Choose one</option>
                      {heard.map((h) => (
                        <option value={h}>{h}</option>
                      ))}
                    </select>
                  </div>
                </fieldset>

                <!-- Step 4: review and send -->
                <fieldset class="step" data-step="review" hidden>
                  <legend>
                    <span class="eyebrow">Step 4 of {stepCount}</span>
                    <span class="legend-title" tabindex="-1" data-step-title>
                      {steps[3]!.title}
                    </span>
                    <span class="legend-hint">{steps[3]!.hint}</span>
                  </legend>
                  <div class="review" data-review></div>
                  <label class="consent">
                    <input type="checkbox" name="consent" required />
                    <span>
                      My answers are accurate, and {org.shortName} may contact me about help.
                    </span>
                  </label>
                  <p class="error" data-consent-error role="alert" hidden>
                    Check the box to send your application.
                  </p>
                  <p class="privacy">{applyPage.privacy}</p>
                </fieldset>

                <div class="nav">
                  <button type="button" class="button button--outline" data-back hidden>
                    Back
                  </button>
                  <button type="button" class="button button--purple" data-next>
                    Next: {steps[1]!.title}
                  </button>
                  <button type="submit" class="button button--signal" data-send hidden>
                    Send my application by email
                  </button>
                </div>
              </div>
            </form>

            <div class="done surface" data-done hidden tabindex="-1">
              <h2>{applyPage.done.heading}</h2>
              <p>{applyPage.done.body}</p>
              <textarea
                class="textarea"
                data-done-text
                readonly
                rows="10"
                aria-label="Your application text"
              ></textarea>
              <div class="button-row">
                <button type="button" class="button button--purple" data-copy>
                  Copy my application
                </button>
                <a class="button button--outline" href={phone.href}>
                  Call {phone.display}
                </a>
                <a class="arrow-link" href={mailto}>
                  Open a blank email to us
                </a>
              </div>
            </div>
          </div>

          <aside class="side surface surface--night on-dark" aria-labelledby="side-title">
            <h2 id="side-title">{getHelp.talk.heading}</h2>
            <p>{sideBody}</p>
            <a class="button button--glass" href={phone.href}>
              Call {phone.display}
            </a>
            <a class="arrow-link" href={mailto}>
              Email us
            </a>
            <p class="side-note">{applyPage.privacy}</p>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-apply]");
  if (form) {
    const done = document.querySelector<HTMLElement>("[data-done]")!;
    const doneText = done.querySelector<HTMLTextAreaElement>("[data-done-text]")!;
    const email = done.querySelector<HTMLAnchorElement>("a[href^='mailto:']")!.href;
    const subject = new URL(email).searchParams.get("subject") ?? "Application for help";
    const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>("[data-step]"));
    const titles = steps.map((step) =>
      (step.querySelector("[data-step-title]")!.textContent ?? "").trim(),
    );
    const last = steps.length - 1;
    const progress = Array.from(form.querySelectorAll<HTMLElement>("[data-progress]"));
    const live = form.querySelector<HTMLElement>("[data-step-live]")!;
    const back = form.querySelector<HTMLButtonElement>("[data-back]")!;
    const next = form.querySelector<HTMLButtonElement>("[data-next]")!;
    const send = form.querySelector<HTMLButtonElement>("[data-send]")!;
    const review = form.querySelector<HTMLElement>("[data-review]")!;
    let current = 0;
    /** Set when a Change button on the review opens a step: Next then returns there. */
    let returnToReview = false;

    // Validation: required fields, a phone with 10 digits, a 5-digit ZIP, and
    // an email address when it is the chosen way to reach the family. Each
    // message says what to enter; the label supplies the field's name.
    const labelOf = (input: Element) => {
      const label = input.closest(".field")?.querySelector("label");
      return Array.from(label?.childNodes ?? [])
        .filter((node) => node.nodeType === Node.TEXT_NODE)
        .map((node) => node.textContent)
        .join("")
        .trim()
        .toLowerCase();
    };
    const messageFor = (input: HTMLInputElement | HTMLSelectElement) => {
      const value = input.value.trim();
      if (input.dataset.kind === "zip" && !/^\d{5}(-\d{4})?$/.test(value))
        return "Enter your 5-digit ZIP code.";
      if (input.required && !value) {
        if (input instanceof HTMLSelectElement)
          return input.id === "county" ? "Choose your county." : "Choose one.";
        if (input.id === "email") return "Enter an email address, or choose Call or Text.";
        return `Enter your ${labelOf(input)}.`;
      }
      if (input.dataset.kind === "phone" && value.replace(/\D/g, "").length < 10)
        return "Enter a 10-digit phone number with the area code.";
      if (
        input instanceof HTMLInputElement &&
        input.type === "email" &&
        value &&
        !input.validity.valid
      )
        return "Enter an email address like name@example.com.";
      return "";
    };
    const setError = (input: HTMLInputElement | HTMLSelectElement, message: string) => {
      const field = input.closest(".field")!;
      let note = field.querySelector<HTMLElement>(".error");
      if (message) {
        if (!note) {
          note = document.createElement("p");
          note.className = "error";
          note.id = `${input.id}-error`;
          field.append(note);
        }
        note.textContent = message;
        input.setAttribute("aria-invalid", "true");
        input.setAttribute("aria-describedby", note.id);
      } else {
        note?.remove();
        input.removeAttribute("aria-invalid");
        input.removeAttribute("aria-describedby");
      }
    };
    const validate = (step: HTMLFieldSetElement) => {
      let first: HTMLElement | null = null;
      step
        .querySelectorAll<HTMLInputElement | HTMLSelectElement>(".input, .select")
        .forEach((input) => {
          const message = messageFor(input);
          setError(input, message);
          if (message && !first) first = input;
        });
      if (step.dataset.step === "needs") {
        const chosen = step.querySelectorAll<HTMLInputElement>("input[name=need]:checked").length;
        const error = step.querySelector<HTMLElement>("[data-needs-error]")!;
        error.hidden = chosen > 0;
        if (chosen === 0 && !first) first = step.querySelector("input[name=need]");
      }
      if (step.dataset.step === "review") {
        const consent = step.querySelector<HTMLInputElement>("input[name=consent]")!;
        const error = step.querySelector<HTMLElement>("[data-consent-error]")!;
        error.hidden = consent.checked;
        if (!consent.checked && !first) first = consent;
      }
      first?.focus();
      return !first;
    };
    // Nothing on the first blur of an empty field; errors on Next; then a live
    // re-check while the field is being corrected.
    const watch = (input: HTMLInputElement | HTMLSelectElement) => {
      input.addEventListener("blur", () => {
        if (input.value.trim() || input.getAttribute("aria-invalid"))
          setError(input, messageFor(input));
      });
      input.addEventListener("input", () => {
        if (input.getAttribute("aria-invalid")) setError(input, messageFor(input));
      });
    };

    // The phone number, formatted as typed: (317) 555-1234.
    const formatPhone = (raw: string) => {
      const d = raw.replace(/\D/g, "").slice(0, 10);
      if (d.length > 6) return `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`;
      if (d.length > 3) return `(${d.slice(0, 3)}) ${d.slice(3)}`;
      return d;
    };
    const phone = form.querySelector<HTMLInputElement>("#phone")!;
    phone.addEventListener("input", () => {
      // Only while typing at the end, so an edit in the middle keeps its caret.
      if (phone.selectionStart !== phone.value.length) return;
      phone.value = formatPhone(phone.value);
    });

    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>(".input, .select").forEach(watch);

    // Email is required when it is the chosen way to reach the family.
    const emailInput = form.querySelector<HTMLInputElement>("#email")!;
    const emailOptional = form.querySelector<HTMLElement>("[data-email-optional]")!;
    const syncEmail = () => {
      const byEmail =
        form.querySelector<HTMLInputElement>("input[name=contactMethod]:checked")?.value ===
        "Email";
      emailInput.required = byEmail;
      emailOptional.hidden = byEmail;
      if (emailInput.getAttribute("aria-invalid")) setError(emailInput, messageFor(emailInput));
    };
    form
      .querySelectorAll<HTMLInputElement>("input[name=contactMethod]")
      .forEach((radio) => radio.addEventListener("change", syncEmail));
    syncEmail();

    // Children: one row of fields per child.
    const count = form.querySelector<HTMLSelectElement>("[data-child-count]")!;
    const children = form.querySelector<HTMLElement>("[data-children]")!;
    const rows = form.querySelector<HTMLElement>("[data-child-rows]")!;
    const template = form.querySelector<HTMLTemplateElement>("[data-child-template]")!;
    const renderChildren = () => {
      const n = parseInt(count.value, 10) || 0;
      children.hidden = n === 0;
      while (rows.children.length > n) rows.lastElementChild!.remove();
      while (rows.children.length < n) {
        const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const index = rows.children.length + 1;
        row.querySelector("[data-child-heading]")!.textContent = `Child ${index}`;
        row.querySelectorAll("label").forEach((label, i) => {
          const control = label.nextElementSibling as HTMLInputElement | HTMLSelectElement;
          const id = `child-${index}-${i}`;
          control.id = id;
          label.setAttribute("for", id);
          label.querySelector("[data-child-prefix]")!.textContent = `Child ${index}: `;
          watch(control);
        });
        rows.append(row);
      }
    };
    count.addEventListener("change", renderChildren);
    renderChildren();

    // Needs: a follow-up list opens under each kind of help that has one.
    form.querySelectorAll<HTMLInputElement>("[data-toggle]").forEach((box) => {
      const sub = form.querySelector<HTMLElement>(`[data-sub="${box.dataset.toggle}"]`);
      if (!sub) return;
      const sync = () => {
        sub.hidden = !box.checked;
      };
      box.addEventListener("change", sync);
      sync();
    });

    // The answers, one group per step, for the review and the email.
    type Row = [string, string];
    type Group = { title: string; goto: number; rows: Row[] };
    const answers = (): Group[] => {
      const data = new FormData(form);
      const get = (name: string) => String(data.get(name) ?? "").trim();
      const all = (name: string) => data.getAll(name).map((value) => String(value).trim());
      const you: Row[] = [
        ["Name", `${get("firstName")} ${get("lastName")}`.trim()],
        ["Phone", formatPhone(get("phone"))],
      ];
      if (get("email")) you.push(["Email", get("email")]);
      you.push(["Reach me by", get("contactMethod")]);
      const household: Row[] = [
        [
          "Address",
          `${get("street")}, ${get("city")} ${get("zip")}${get("county") === "Other" ? "" : ` (${get("county")} County)`}`,
        ],
        ["Adults", get("adults")],
        ["Children", get("childCount")],
      ];
      const genders = all("childGender");
      const clothing = all("childClothing");
      const shoes = all("childShoe");
      all("childAge").forEach((age, i) => {
        const bits = [
          age && (age === "Under 1" ? "age under 1" : `age ${age}`),
          genders[i],
          clothing[i] && `clothing ${clothing[i]}`,
          shoes[i] && `shoes ${shoes[i]}`,
        ]
          .filter(Boolean)
          .join(", ");
        household.push([`Child ${i + 1}`, bits]);
      });
      const needs: Row[] = [["Help requested", all("need").join(", ")]];
      if (all("holidays").length) needs.push(["Holidays", all("holidays").join(", ")]);
      if (all("diaperSizes").length) needs.push(["Diaper sizes", all("diaperSizes").join(", ")]);
      if (all("grades").length) needs.push(["Grades", all("grades").join(", ")]);
      if (get("notes")) needs.push(["Notes", get("notes")]);
      if (get("heard")) needs.push(["How you heard about us", get("heard")]);
      return [
        { title: titles[0]!, goto: 0, rows: you },
        { title: titles[1]!, goto: 1, rows: household },
        { title: titles[2]!, goto: 2, rows: needs },
      ];
    };
    const renderReview = () => {
      review.replaceChildren(
        ...answers().map((group) => {
          const section = document.createElement("section");
          section.className = "review-group";
          const head = document.createElement("div");
          head.className = "review-head";
          const heading = document.createElement("h3");
          heading.textContent = group.title;
          const change = document.createElement("button");
          change.type = "button";
          change.className = "review-change";
          change.dataset.goto = String(group.goto);
          change.textContent = "Change";
          const which = document.createElement("span");
          which.className = "visually-hidden";
          which.textContent = ` ${group.title.toLowerCase()}`;
          change.append(which);
          head.append(heading, change);
          const list = document.createElement("dl");
          list.className = "review-list";
          group.rows.forEach(([label, value]) => {
            const row = document.createElement("div");
            const dt = document.createElement("dt");
            dt.textContent = label;
            const dd = document.createElement("dd");
            dd.textContent = value;
            row.append(dt, dd);
            list.append(row);
          });
          section.append(head, list);
          return section;
        }),
      );
    };

    const show = (index: number, moveFocus = true) => {
      current = index;
      form.dataset.current = String(index);
      steps.forEach((step, i) => {
        step.hidden = i !== index;
      });
      progress.forEach((item, i) => {
        if (i === index) item.setAttribute("aria-current", "step");
        else item.removeAttribute("aria-current");
        item.classList.toggle("passed", i < index);
        // A passed step can be reopened; the ones ahead wait for Next.
        item.querySelector<HTMLButtonElement>("[data-goto]")!.disabled = i >= index;
      });
      back.hidden = index === 0;
      next.hidden = index === last;
      send.hidden = index !== last;
      if (index < last)
        next.textContent = returnToReview ? "Back to review" : `Next: ${titles[index + 1]}`;
      if (index === last) renderReview();
      if (!moveFocus) return;
      live.textContent = `Step ${index + 1} of ${steps.length}, ${titles[index]}`;
      form.scrollIntoView({ block: "start", behavior: "instant" });
      steps[index]!.querySelector<HTMLElement>("[data-step-title]")!.focus({
        preventScroll: true,
      });
    };

    const advance = () => {
      if (!validate(steps[current]!)) return;
      if (returnToReview) {
        returnToReview = false;
        show(last);
      } else show(current + 1);
    };
    // Going back never loses answers and is never gated. A step reopened from
    // the review returns there on Next; any other way back walks forward again.
    const goTo = (index: number) => {
      if (index >= current) return;
      returnToReview = current === last;
      show(index);
    };
    next.addEventListener("click", advance);
    back.addEventListener("click", () => {
      returnToReview = false;
      show(current - 1);
    });
    form.querySelectorAll<HTMLButtonElement>(".progress-go").forEach((button) => {
      button.addEventListener("click", () => goTo(Number(button.dataset.goto)));
    });
    review.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-goto]");
      if (button) goTo(Number(button.dataset.goto));
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      // Enter on an earlier step means Next, never send.
      if (current < last) {
        advance();
        return;
      }
      if (!validate(steps[current]!)) return;
      const blocks = answers().map(
        (group) =>
          `${group.title}\n${group.rows.map(([label, value]) => `${label}: ${value}`).join("\n")}`,
      );
      const body = `${subject}\n\n${blocks.join("\n\n")}\n`;
      // Built by hand: URLSearchParams writes spaces as "+", which mail apps show literally.
      const url = new URL(email);
      url.search = `?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      doneText.value = body;
      form.hidden = true;
      done.hidden = false;
      done.focus();
      const sending = new CustomEvent("application:send", {
        detail: url.toString(),
        cancelable: true,
      });
      if (form.dispatchEvent(sending)) window.location.href = url.toString();
    });

    done
      .querySelector<HTMLButtonElement>("[data-copy]")!
      .addEventListener("click", async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        try {
          await navigator.clipboard.writeText(doneText.value);
          button.textContent = "Copied";
        } catch {
          doneText.select();
        }
      });

    show(0, false);
  }
</script>

