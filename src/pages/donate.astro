---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ProgramIcon from "../components/ProgramIcon.astro";
import ProgramIconDefs from "../components/ProgramIconDefs.astro";
import Wave from "../components/Wave.astro";
import Base from "../layouts/Base.astro";
import { claim, show } from "../data/facts.ts";
import { donatePage, facts, links, org, programStrip } from "../data/site";

const email = show(facts.email);
const taxExempt = claim(facts.taxExempt);
const portal = links.donate;
const description = `Give once or monthly to ${org.shortName}, a ${taxExempt.section} nonprofit. ${donatePage.intro}`;

// The default choice ($50, once) is written into the summary, the button and
// the email, so all three are right before the script runs and without it.
const defaultGift = `$${donatePage.amounts[1]}`;
const subject = `${donatePage.emailSubject}: ${defaultGift}`;
const body = `Hello,\n\nI'd like to make a one-time gift of ${defaultGift} to ${org.shortName}. What's the best way to send it?\n\nThank you,\n`;
// Encoded by hand: URLSearchParams writes spaces as "+", which mail apps show literally.
const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<Base title={`Donate | ${org.shortName}`} description={description}>
  <SiteHeader />
  <main id="main">
    <section class="page-hero on-dark">
      <div class="wrap">
        <span class="eyebrow">{donatePage.eyebrow}</span>
        <h1>{donatePage.heading}</h1>
        <p class="lede">{donatePage.intro}</p>
      </div>
      <Wave kind="into-paper" id="wp" above="none" belowGround="paper" class="page-wave" />
    </section>

    <section class="section give ground" aria-labelledby="give-title">
      <div class="wrap">
        <form
          class="card surface"
          data-give
          data-org={org.shortName}
          data-subject={donatePage.emailSubject}
          novalidate
        >
          <h2 id="give-title">{donatePage.giftHeading}</h2>

          <fieldset class="field">
            <legend class="label">How often</legend>
            <div class="choices" role="radiogroup">
              {donatePage.frequencies.map((f, i) => (
                <label class="choice">
                  <input type="radio" name="frequency" value={f.id} checked={i === 0} />
                  {f.label}
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="field">
            <legend class="label">Amount</legend>
            <div class="choices amounts">
              {donatePage.amounts.map((amount, i) => (
                <label class="choice">
                  <input type="radio" name="amount" value={amount} checked={i === 1} />${amount}
                </label>
              ))}
              <label class="choice choice--other">
                <span aria-hidden="true">$</span>
                <span class="visually-hidden">Other amount in dollars</span>
                <input
                  id="other-amount"
                  name="otherAmount"
                  type="number"
                  inputmode="numeric"
                  min="1"
                  step="1"
                  placeholder="Other"
                  enterkeyhint="go"
                />
              </label>
            </div>
          </fieldset>

          <p class="visually-hidden" aria-live="polite" data-summary>
            Your gift: {defaultGift}.
          </p>

          <div class="action">
            {portal ? (
              <a class="button button--signal go" href={portal} data-portal>
                {donatePage.continueLabel} {defaultGift}
              </a>
            ) : (
              <>
                <a class="button button--signal go" href={mailto} data-email>
                  Donate {defaultGift} by email
                </a>
                <p class="note">{donatePage.emailNote}</p>
              </>
            )}
          </div>

          <p class="tax">
            {claim(facts.legalName)} is a {taxExempt.section} nonprofit (EIN {claim(facts.ein)})
            helping families since {claim(facts.founded)}.
            {taxExempt.deductible && " Gifts are tax-deductible to the extent allowed by law."}
          </p>
        </form>

        <aside class="provides surface surface--night on-dark" aria-labelledby="provides-title">
          <ProgramIconDefs />
          <h2 id="provides-title">{donatePage.providesHeading}</h2>
          <ul class="programs">
            {programStrip.map((item) => (
              <li>
                <a class="program" href={item.href}>
                  <span class="icon">
                    <ProgramIcon kind={item.icon} />
                  </span>
                  <span class="words">
                    <span class="name">{item.title}</span>
                    <span class="line">{item.body}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<script>
  // Keeps the button's label, the hidden summary and the giving link in step
  // with the chosen gift. The chips and the dollar field are one choice:
  // typing in the field clears the chips, and choosing a chip clears the field.
  const form = document.querySelector<HTMLFormElement>("[data-give]");
  if (form) {
    const summary = form.querySelector<HTMLElement>("[data-summary]")!;
    const otherInput = form.querySelector<HTMLInputElement>("#other-amount")!;
    const chips = form.querySelectorAll<HTMLInputElement>('input[name="amount"]');
    const emailLink = form.querySelector<HTMLAnchorElement>("[data-email]");
    const portalLink = form.querySelector<HTMLAnchorElement>("[data-portal]");
    const orgName = form.dataset.org ?? "";
    const subjectPrefix = form.dataset.subject ?? "Donation";

    const read = () => {
      const data = new FormData(form);
      const monthly = data.get("frequency") === "monthly";
      // The typed amount, whole dollars only, wins while the field holds one.
      const amount =
        otherInput.value !== ""
          ? Math.floor(Number(otherInput.value)) || 0
          : Number(data.get("amount")) || 0;
      return { monthly, amount };
    };

    const update = () => {
      const { monthly, amount } = read();
      const dollars = amount > 0 ? `$${amount.toLocaleString("en-US")}` : "";
      const gift = dollars && monthly ? `${dollars} a month` : dollars;
      summary.textContent = gift ? `Your gift: ${gift}.` : "Enter an amount.";
      if (emailLink) {
        emailLink.textContent = gift ? `Donate ${gift} by email` : "Donate by email";
        const subject = gift ? `${subjectPrefix}: ${gift}` : subjectPrefix;
        const body = dollars
          ? `Hello,\n\nI'd like to make a ${monthly ? "monthly" : "one-time"} gift of ${dollars} to ${orgName}. What's the best way to send it?\n\nThank you,\n`
          : `Hello,\n\nI'd like to give to ${orgName}. What's the best way to send it?\n\nThank you,\n`;
        // Encoded by hand: URLSearchParams writes spaces as "+", which mail apps show literally.
        const address = emailLink.href.split("?")[0];
        emailLink.href = `${address}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      }
      if (portalLink) {
        portalLink.textContent = gift ? `Donate ${gift}` : "Donate";
        // Amount and frequency ride along as a hint; the payment page has the final say.
        const url = new URL(portalLink.href);
        if (amount > 0) url.searchParams.set("amount", String(amount));
        else url.searchParams.delete("amount");
        url.searchParams.set("frequency", monthly ? "monthly" : "once");
        portalLink.href = url.toString();
      }
    };

    otherInput.addEventListener("input", () => {
      for (const chip of chips) chip.checked = false;
      update();
    });
    form.addEventListener("change", (event) => {
      if ((event.target as HTMLInputElement).name === "amount") otherInput.value = "";
      update();
    });
    // Enter or Go in the dollar field follows the button.
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      (portalLink ?? emailLink)?.click();
    });
    update();
  }
</script>

<style>
  /* The chooser: a surface (global.css), lifted off the ground with a rim
     of light, so it reads as a panel and not a flat form. */
  .card {
    max-width: 44rem;
    display: grid;
    gap: var(--space-m);
    padding: var(--space-m);
  }

  /* What the gift provides: the banner's four programs, their neon icons
     on a lit night surface, each a link to its program. */
  .provides {
    display: grid;
    gap: var(--space-m);
    align-content: start;
    max-width: 44rem;
    margin-top: var(--space-l);
    padding: var(--space-m);
  }

  .provides h2 {
    font-size: var(--step-2);
    color: #fff;
  }

  .programs {
    display: grid;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .programs li + li {
    border-top: var(--hairline) solid rgb(255 255 255 / 0.1);
  }

  .program {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: center;
    min-height: max(44px, 3rem);
    padding: 0.75rem 0.25rem;
    border-radius: var(--r-img);
    color: #fff;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .program:hover .name {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .program:hover .icon {
    filter: brightness(1.15) drop-shadow(0 0 0.5rem rgb(160 108 255 / 0.6));
  }

  /* One scale for the four icons, as the strip sizes them: the backpack (81
     tall in its box) sets the row's height, and each icon's width is its
     box's times that scale. */
  .icon {
    --k: calc(2.75rem / 81);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    width: 4.5rem;
    transition: filter 0.25s ease;
  }

  .icon :global(.pi) {
    width: calc(var(--pi-w) * var(--k));
    height: auto;
    max-width: 100%;
  }

  .words {
    display: grid;
    gap: 0.15rem;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1.2;
  }

  .line {
    font-size: var(--step--1);
    color: var(--night-soft);
  }

  .card h2 {
    font-size: var(--step-2);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 0.5rem;
  }

  /* The amounts: four chips and a dollar field that is the fifth choice.
     Three columns on phones ($25 $50 $100 / $250 [$ Other]); one row from
     tablets up, the field taking what is left. */
  .field .amounts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .amounts .choice {
    min-width: 0;
    justify-content: center;
  }

  .amounts .choice--other {
    grid-column: span 2;
    gap: 0.25rem;
    padding-inline: 0.875rem;
    cursor: text;
  }

  /* The field is the pill's text, not an invisible overlay like the radios. */
  .amounts .choice--other input {
    position: static;
    inset: auto;
    width: 100%;
    min-width: 0;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    opacity: 1;
    font: inherit;
    color: inherit;
    outline: none;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .amounts .choice--other input::-webkit-inner-spin-button,
  .amounts .choice--other input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }

  .amounts .choice--other input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  /* While the field holds a value it is the choice: it turns purple, and a
     chip still checked (JavaScript off) looks unselected. */
  .field .amounts .choice--other:has(input:not(:placeholder-shown)) {
    background: var(--purple);
    color: #fff;
    box-shadow: inset 0 0 0 0.125rem var(--purple);
  }

  .amounts:has(#other-amount:not(:placeholder-shown)) .choice:has([name="amount"]:checked) {
    background: #fff;
    color: inherit;
    box-shadow: inset 0 0 0 var(--hairline) var(--rule-strong);
  }

  /* The button and, while giving is by email, one line under it saying what
     the button does. The trust line follows as the card's last words. */
  .action {
    display: grid;
    gap: var(--space-s);
  }

  .go {
    justify-self: start;
  }

  @media (max-width: 35.99rem) {
    .go {
      justify-self: stretch;
    }
  }

  .note {
    max-width: 40ch;
  }

  .note,
  .tax {
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (min-width: 36rem) {
    .field .amounts {
      grid-template-columns: repeat(4, 1fr) minmax(8rem, 1.5fr);
    }

    .amounts .choice--other {
      grid-column: auto;
    }
  }

  /* Desktop: the card stands beside the opener's words and crosses the wave,
     so the first screen holds the choices and the button. The opener keeps
     the card's column free; the card is pulled up by the opener's bottom
     padding, the wave and the height of the opener's words, so its top
     aligns with the eyebrow. */
  @media (min-width: 56rem) {
    .page-hero .wrap {
      padding-right: 36rem;
    }

    .page-hero .lede {
      max-width: 30ch;
    }

    .page-hero + .section.give {
      --overlap: calc(var(--wave-h) + var(--space-l) + 15.875rem);
      position: relative;
      padding-top: 0;
      margin-top: calc(-1 * var(--overlap));
    }

    /* The section reaches up under the opener to hold the card; its ground
       (the wash and the grain) starts where the opener's wave ends. */
    .give::before,
    .give::after {
      top: var(--overlap);
    }

    .give .wrap {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 34rem;
      column-gap: var(--space-xl);
    }

    .card {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      max-width: none;
      z-index: 1;
      padding: var(--space-l);
      box-shadow:
        0 1.5rem 3rem rgb(27 15 46 / 0.24),
        0 0.125rem 0.375rem rgb(27 15 46 / 0.12),
        inset 0 1px 0 rgb(255 255 255 / 0.9);
    }

    /* The programs panel takes the opener's empty half, under its words and
       the wave, beside the card. */
    .provides {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      max-width: 34rem;
      margin-top: calc(var(--overlap) + var(--space-l));
      padding: var(--space-l);
    }

    /* Tighter rows, so the panel ends near the card's foot. */
    .program {
      padding-block: 0.5rem;
    }
  }
</style>
