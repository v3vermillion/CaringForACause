---
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "@fontsource/atkinson-hyperlegible-next/400.css";
import "@fontsource/atkinson-hyperlegible-next/700.css";
import "../styles/global.css";
import BrandPaint from "../components/BrandPaint.astro";
import displayFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import bodyFont from "@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url";
import bodyBoldFont from "@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-700-normal.woff2?url";
import { assertLaunchReady, claim, pendingFacts, show } from "../data/facts.ts";
import { facts, org } from "../data/site";

type Props = {
  title?: string;
  description?: string;
  /** Preload the largest above-the-fold image so it doesn't wait behind fonts. */
  preloadImage?: { srcset: string; sizes: string; type: string };
  /** The home page paints the serif's italic on its first screen; nothing else does. */
  preloadItalic?: boolean;
};

const {
  preloadImage,
  preloadItalic = false,
  title = `${org.name} | ${claim(facts.serviceArea)}`,
  description = `${org.shortName} helps families in ${claim(facts.serviceArea)} with holiday meals and gifts, monthly diapers, and school supplies.`,
} = Astro.props;

// Search engines are blocked unless PUBLIC_ALLOW_INDEXING is exactly "true".
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === "true";

// Launch check: a public (indexed) build fails while any fact is unconfirmed.
assertLaunchReady(facts, allowIndexing);
const pending = pendingFacts(facts);
if (pending.length > 0 && Astro.url.pathname === "/") {
  console.warn(
    `[facts] ${pending.length} detail(s) still need confirmation: ${pending.map((p) => p.name).join(", ")}`,
  );
}
const phone = show(facts.phone);

// The commit this page was built from, so a live check can confirm what is deployed.
const version = (process.env.GITHUB_SHA || process.env.WORKERS_CI_COMMIT_SHA || "local").slice(
  0,
  7,
);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.jpg", Astro.site);

// Structured data so search engines recognize a registered nonprofit.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: claim(facts.legalName),
  alternateName: org.shortName,
  url: Astro.site?.href,
  logo: new URL("/icon-512.png", Astro.site).href,
  description: org.mission,
  foundingDate: String(claim(facts.founded)),
  founder: { "@type": "Person", name: claim(facts.founder) },
  taxID: claim(facts.ein),
  nonprofitStatus: claim(facts.taxExempt).section === "501(c)(3)" ? "Nonprofit501c3" : undefined,
  areaServed: claim(facts.serviceArea),
  address: {
    "@type": "PostalAddress",
    addressLocality: show(facts.city).split(",")[0],
    addressRegion: "IN",
    addressCountry: "US",
  },
  telephone: phone.href.replace("tel:", ""),
  email: show(facts.email),
  sameAs: [show(facts.facebook)],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Stop iOS from turning numbers like the EIN into phone links; real phone links use tel:. -->
    <meta name="format-detection" content="telephone=no, date=no, email=no, address=no" />
    <!-- The design is light-only; keep browsers from auto-darkening it. -->
    <meta name="color-scheme" content="light only" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        type={preloadImage.type}
        fetchpriority="high"
      />
    )}
    <!-- Every face the first paint uses, so text is never painted in a
         fallback and moved when the face arrives (a layout shift on every
         bold label of the application form when the runner was slow). -->
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyBoldFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/serif.woff2" as="font" type="font/woff2" crossorigin />
    {preloadItalic && (
      <link
        rel="preload"
        href="/fonts/serif-italic.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    <link rel="preload" href="/fonts/footer-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1b0f2e" />
    <meta name="version" content={version} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={org.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${org.name} logo`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <!-- The two doors' pages are fetched and rendered when a visitor shows
         intent (a hover or a touch on their link), so the change of page
         is immediate; browsers without speculation rules ignore this. -->
    <script is:inline type="speculationrules">
      {
        "prerender": [
          { "where": { "href_matches": ["/donate", "/apply"] }, "eagerness": "moderate" }
        ]
      }
    </script>
    <!-- Marks the document before anything is painted, so a page can show
         its JavaScript-only parts from the first paint instead of revealing
         them later and moving what is below (the application form). -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <!-- Where a page opens when its address has a section in it (#contact,
         /#volunteer). The page places the reader itself rather than leaving it
         to the browser, because browsers disagree: on a refresh they jump back
         to the section wherever the reader had scrolled since (on a phone
         Contact is the bottom of the page), Safari on a phone then re-applies
         a stale position of its own, and Safari scrolls smoothly on arrival
         and can stop short. So the section is held out of the address before
         the browser can act on it; a refresh puts the reader back where they
         were (each page remembers its position as it is left), and any other
         arrival lands on the section at once. Then the section goes back into
         the address, so it can still be copied. For a moment after load the
         place is held against the browser moving the page on its own, until
         the reader touches, scrolls or types. Back and forward are left to the
         browser. The tabs read the held section (GetInvolved.astro). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var key = "scroll:" + location.pathname + location.search;
        var managed = false;
        addEventListener("pagehide", function () {
          try {
            sessionStorage.setItem(key, String(Math.round(scrollY)));
            if (managed) history.scrollRestoration = "auto";
          } catch (e) {}
        });
        try {
          var hash = location.hash;
          var nav = performance.getEntriesByType("navigation")[0];
          if (!hash || (nav && nav.type === "back_forward")) return;
          var saved = nav && nav.type === "reload" ? sessionStorage.getItem(key) : null;
          managed = true;
          history.scrollRestoration = "manual";
          root.dataset.heldHash = hash;
          history.replaceState(history.state, "", location.pathname + location.search);
          var touched = false;
          ["wheel", "touchstart", "keydown", "pointerdown"].forEach(function (type) {
            addEventListener(
              type,
              function () {
                touched = true;
              },
              { capture: true, passive: true },
            );
          });
          var place = function () {
            if (touched) return;
            var smooth = root.style.scrollBehavior;
            root.style.scrollBehavior = "auto";
            if (saved !== null) {
              scrollTo(0, Number(saved));
            } else {
              var target = document.getElementById(decodeURIComponent(hash.slice(1)));
              // A tab's panel sits in its section; land on the section.
              if (target && target.matches("[data-panel]"))
                target = target.closest("section") || target;
              if (target) target.scrollIntoView(true);
            }
            root.style.scrollBehavior = smooth;
          };
          addEventListener("DOMContentLoaded", place);
          addEventListener("load", function () {
            place();
            history.replaceState(history.state, "", location.pathname + location.search + hash);
            delete root.dataset.heldHash;
            var hold = function () {
              place();
            };
            addEventListener("scroll", hold);
            setTimeout(function () {
              removeEventListener("scroll", hold);
            }, 1000);
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <slot name="after" />
    <BrandPaint />
  </body>
</html>
