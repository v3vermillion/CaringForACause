---
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "@fontsource/atkinson-hyperlegible-next/400.css";
import "@fontsource/atkinson-hyperlegible-next/700.css";
import "../styles/global.css";
import { org } from "../data/site";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = `${org.name} | ${org.serviceArea}`,
  description = `${org.shortName} helps families in ${org.serviceArea} with holiday meals and gifts, monthly diapers, and school supplies.`,
} = Astro.props;

// Search engines are blocked unless PUBLIC_ALLOW_INDEXING is exactly "true".
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === "true";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/icon-512.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1b0f2e" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={org.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
