---
import { navigation, org } from "../data/site";
import Brand from "./Brand.astro";

const { items, donate, help } = navigation;
// The page's own path, so the bar's pill and the menu's rows can say "you
// are here" on the two door pages (/donate, /apply). Section links are
// marked by the script below as their section crosses the window.
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const current = (href: string) => (href.replace(/\/+$/, "") === here ? "page" : undefined);
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href="/">
      <Brand kind="mark" class="brand-icon" label="" />
      <Brand kind="lockup" class="brand-lockup" label={org.name} />
    </a>

    <!-- Inline links on wide screens, and everywhere without JavaScript. -->
    <nav class="inline-nav" aria-label="Main">
      <ul>
        {items.map((item) => (
          <li>
            <a class="nav-link" href={item.href} data-section={item.href.replace("/#", "")}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="button button--crimson donate" href={donate.href} aria-current={current(donate.href)}>
      {donate.label}
      <svg class="chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="m9 5 7 7-7 7"></path>
      </svg>
    </a>

    <!-- The corner wedge: the menu's home on phones. -->
    <button
      class="menu-button"
      type="button"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="menu"
    >
      <span class="band" aria-hidden="true"></span>
      <span class="corner" aria-hidden="true"></span>
      <span class="edge" aria-hidden="true"></span>
      <span class="lines" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="visually-hidden">Open menu</span>
    </button>
  </div>
</header>

<!--
  The phone menu: one list, the same map as the desktop links, with the two
  doors at either end. Nothing else lives here; contact details are in the
  Contact section it links to.
-->
<dialog
  id="menu"
  class="menu on-dark"
  aria-labelledby="menu-title"
  tabindex="-1"
  style={`--menu-rows: ${items.length + 2};`}
>
  <div class="menu-art" aria-hidden="true">
    <svg class="menu-ribbon" viewBox="440 0 412 300" focusable="false">
      <defs>
        <linearGradient id="mr-above" x1="0" y1="0" x2="1" y2="0.3">
          <stop offset="0" stop-color="#1c0832" />
          <stop offset="0.45" stop-color="#2e0a40" />
          <stop offset="1" stop-color="#5e0d58" />
        </linearGradient>
        <linearGradient id="mr-band" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#6a1466" stop-opacity="0" />
          <stop offset="0.5" stop-color="#7a1268" stop-opacity="0.7" />
          <stop offset="1" stop-color="#a8187c" />
        </linearGradient>
        <linearGradient id="mr-line" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#5a38e0" stop-opacity="0.5" />
          <stop offset="0.45" stop-color="#9a2eb8" />
          <stop offset="1" stop-color="#f062c4" />
        </linearGradient>
        <radialGradient id="mr-below" cx="1" cy="0.75" r="0.9">
          <stop offset="0" stop-color="#2a0a64" />
          <stop offset="0.6" stop-color="#1c0848" stop-opacity="0.6" />
          <stop offset="1" stop-color="#140630" stop-opacity="0" />
        </radialGradient>
        <filter id="mr-soft" x="-40%" y="-60%" width="180%" height="220%">
          <feGaussianBlur stdDeviation="3" />
        </filter>
        <filter id="mr-glow" x="-10%" y="-40%" width="120%" height="180%">
          <feGaussianBlur stdDeviation="5" />
        </filter>
      </defs>
      <rect x="440" y="0" width="412" height="300" fill="url(#mr-below)" />
      <path d="M455,0 C560,45 690,115 852,205 L852,0 Z" fill="url(#mr-above)" />
      <path
        d="M590,0 C680,55 760,120 852,152 L852,205 C700,120 600,60 520,22 C540,12 565,5 590,0 Z"
        fill="url(#mr-band)"
        filter="url(#mr-soft)"
      />
      <path
        d="M455,0 C560,45 690,115 852,205"
        fill="none"
        stroke="url(#mr-line)"
        stroke-width="8"
        opacity="0.35"
        filter="url(#mr-glow)"
      />
      <path
        d="M455,0 C560,45 690,115 852,205"
        fill="none"
        stroke="url(#mr-line)"
        stroke-width="2.6"
      />
      <path
        d="M590,0 C680,55 760,120 852,152"
        fill="none"
        stroke="#b02a90"
        stroke-width="2"
        opacity="0.55"
        filter="url(#mr-soft)"
      />
    </svg>
    <svg class="menu-waves" viewBox="0 1440 852 406" focusable="false">
      <defs>
        <linearGradient id="mw-low" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="560" y2="0">
          <stop offset="0" stop-color="#860a22" />
          <stop offset="0.11" stop-color="#5e0826" />
          <stop offset="0.22" stop-color="#3e0729" />
          <stop offset="0.36" stop-color="#2a0630" />
          <stop offset="0.6" stop-color="#20063a" />
          <stop offset="1" stop-color="#1c0748" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="mw-ab" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="600" y2="0">
          <stop offset="0" stop-color="#7a0a24" />
          <stop offset="0.25" stop-color="#6a0a2a" />
          <stop offset="0.45" stop-color="#420834" />
          <stop offset="0.7" stop-color="#2c0a5a" />
          <stop offset="1" stop-color="#2a0a6a" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="mw-bc" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="780" y2="0">
          <stop offset="0" stop-color="#c4163a" />
          <stop offset="0.15" stop-color="#b41c48" />
          <stop offset="0.3" stop-color="#9a1a66" />
          <stop offset="0.45" stop-color="#6c1682" />
          <stop offset="0.62" stop-color="#3e0e82" />
          <stop offset="0.85" stop-color="#2c0a72" />
          <stop offset="1" stop-color="#2a0870" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="mw-edge" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="800" y2="0">
          <stop offset="0" stop-color="#ff4a6a" />
          <stop offset="0.2" stop-color="#f25a86" />
          <stop offset="0.4" stop-color="#b0309a" />
          <stop offset="0.65" stop-color="#5a22b0" />
          <stop offset="1" stop-color="#3c14a0" stop-opacity="0.2" />
        </linearGradient>
        <linearGradient id="mw-ring" x1="0" y1="0" x2="1" y2="0.4">
          <stop offset="0" stop-color="#220850" />
          <stop offset="0.6" stop-color="#2c0b66" />
          <stop offset="1" stop-color="#3e1296" />
        </linearGradient>
      </defs>
      <path
        d="M0,1448 C120,1470 260,1560 360,1650 C440,1720 500,1790 560,1846 L0,1846 Z"
        fill="url(#mw-low)"
      />
      <path
        d="M0,1448 C120,1470 260,1560 360,1650 C440,1720 500,1790 560,1846 L780,1846 C680,1830 560,1810 420,1745 C300,1680 150,1580 0,1533 Z"
        fill="url(#mw-ab)"
        opacity="0.9"
      />
      <path
        d="M0,1533 C150,1580 300,1680 420,1745 C560,1810 680,1830 780,1846 L440,1846 C380,1805 320,1765 240,1712 C160,1660 80,1625 0,1611 Z"
        fill="url(#mw-bc)"
        opacity="0.92"
      />
      <path
        d="M0,1448 C120,1470 260,1560 360,1650 C440,1720 500,1790 560,1846"
        fill="none"
        stroke="url(#mw-edge)"
        stroke-width="9"
        opacity="0.18"
      />
      <path
        d="M0,1448 C120,1470 260,1560 360,1650 C440,1720 500,1790 560,1846"
        fill="none"
        stroke="url(#mw-edge)"
        stroke-width="2.4"
      />
      <path
        d="M0,1533 C150,1580 300,1680 420,1745 C560,1810 680,1830 780,1846"
        fill="none"
        stroke="url(#mw-edge)"
        stroke-width="9"
        opacity="0.2"
      />
      <path
        d="M0,1533 C150,1580 300,1680 420,1745 C560,1810 680,1830 780,1846"
        fill="none"
        stroke="url(#mw-edge)"
        stroke-width="2.4"
      />
      <path
        d="M0,1611 C80,1625 160,1660 240,1712 C320,1765 380,1805 440,1846"
        fill="none"
        stroke="url(#mw-edge)"
        stroke-width="1.8"
        opacity="0.75"
      />
    </svg>
    <Brand kind="mark" class="menu-watermark" label="" />
  </div>

  <div class="menu-inner">
    <div class="menu-top">
      <p id="menu-title" class="menu-brand">
        <Brand kind="mark" class="menu-icon" label="" />
        <Brand kind="lockup" class="menu-lockup" label={org.name} />
      </p>
      <button class="menu-close" type="button" data-menu-close>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path
            d="M3.5 3.5l13 13M16.5 3.5l-13 13"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
          />
        </svg>
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>

    <nav aria-label="Menu">
      <ol class="menu-list">
        {[help, ...items, donate].map((item, i) => (
          <li class:list={[i === 0 && "menu-help"]} style={`--n: ${i};`}>
            <a href={item.href} data-menu-close aria-current={current(item.href)}>
              <span class="menu-label">{item.label}</span>
              <svg class="menu-chevron" viewBox="0 0 10 17" aria-hidden="true">
                <path
                  d="M1.5 1.5l7 7-7 7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const menu = document.getElementById("menu") as HTMLDialogElement | null;
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");

  // The bar's layout (inline links on wide screens, the wedge on phones) is
  // set by the head's html.js mark before the first paint, not here, so
  // nothing moves when this script arrives (decision 42). A browser that
  // cannot open a dialog gets the no-script layout back: the links inline.
  if (header && menu && openButton && typeof menu.showModal === "function") {
    // showModal() focuses the close button, and Safari then draws its
    // keyboard ring on a tap. Start focus on the dialog itself instead; Tab
    // still reaches the button first.
    const open = () => {
      menu.showModal();
      menu.focus({ preventScroll: true });
      document.documentElement.classList.add("menu-open");
    };
    const close = () => {
      if (menu.open) menu.close();
    };
    openButton.addEventListener("click", open);
    menu.querySelectorAll("[data-menu-close]").forEach((el) => el.addEventListener("click", close));
    // Tap on the backdrop (outside the panel) closes.
    menu.addEventListener("click", (event) => {
      if (event.target === menu) close();
    });
    menu.addEventListener("close", () => {
      document.documentElement.classList.remove("menu-open");
      openButton.focus({ preventScroll: true });
    });
  } else if (header) {
    header.classList.add("no-menu");
  }

  // The section links mark the section on screen: the links whose section
  // crosses the middle of the window carry aria-current, which draws the
  // desktop link's underline and marks the menu's row. Nothing is marked on
  // the first screen. Without IntersectionObserver the links simply have no
  // current state. (The door pages' "page" marks are set in the markup.)
  const sectionLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      '.inline-nav a[data-section], #menu a[href^="/#"]',
    ),
  );
  const sectionOf = (a: HTMLAnchorElement) => a.dataset.section ?? a.getAttribute("href")!.slice(2);
  if (header && sectionLinks.length && "IntersectionObserver" in window) {
    const ids = new Set(sectionLinks.map(sectionOf));
    const mark = (id: string | null) => {
      sectionLinks.forEach((a) => {
        if (id !== null && sectionOf(a) === id) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      });
    };
    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && ids.has(entry.target.id)) mark(entry.target.id);
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    ids.forEach((id) => {
      const section = document.getElementById(id);
      if (section) watcher.observe(section);
    });
    // Back at the top, nothing is current.
    const top = document.querySelector(".hero");
    if (top) {
      new IntersectionObserver(
        ([entry]) => {
          if (entry?.isIntersecting) mark(null);
        },
        { rootMargin: "-45% 0px -50% 0px" },
      ).observe(top);
    }
  }
</script>

<style>
  /* The bar is night, from the owner's reference: her lockup beside the
     mark, the links, the glossy Donate pill, and on phones the wedge. It is
     lit the way her artwork lights the footer: a violet glow behind the mark,
     the pink glow under the Donate pill, and a rule along its bottom edge
     that runs violet to crimson and fades out to the right. Its height and
     every size in it are multiples of --sp (below); the 1px rule under it is
     part of --header-h. Nothing here is a fixed pixel except the 44px tap
     floors. The glows are placed from the bar's edges in reference pixels,
     never in percent of the bar (docs/DESIGN.md). */
  .site-header {
    --focus: #fff; /* the bar is night: keyboard rings are white here */
    position: sticky;
    top: 0;
    z-index: 50;
    isolation: isolate;
    overflow: hidden;
    /* The 1px rule of --header-h is the lit rule itself: the border row,
       painted with the gradient, runs the whole width under the wedge too. */
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(
        90deg,
        #7a3cf0 0%,
        #b13ae0 30%,
        #ee3c86 55%,
        #ff4a6a 70%,
        rgb(255 74 106 / 0) 100%
      )
      1;
    background:
      radial-gradient(
        calc(27.5 * var(--sp)) calc(18 * var(--sp)) at calc(100% - 83 * var(--sp)) 100%,
        rgb(200 120 255 / 0.5),
        transparent 100%
      ),
      radial-gradient(
        calc(63 * var(--sp)) calc(20 * var(--sp)) at calc(100% - 126 * var(--sp)) 84%,
        rgb(240 90 170 / 0.28),
        transparent 100%
      ),
      radial-gradient(
        calc(120 * var(--sp)) calc(58 * var(--sp)) at calc(var(--gutter) + 18 * var(--sp)) 55%,
        rgb(120 60 255 / 0.38),
        transparent 100%
      ),
      linear-gradient(180deg, #200d4c 0%, #190a3e 45%, #140832 100%);
  }

  /* Keyboard rings sit inside the bar, which clips at its edge on a narrow
     phone; a ring at the default offset would lose its top and bottom. */
  .site-header :focus-visible {
    outline-offset: -2px;
  }

  /* As the page scrolls under the bar, the bar takes a shadow so it reads
     as lifted off the light sections; at the top of the page there is none.
     Scroll-driven, so the compositor runs it and no script is needed;
     browsers without the timeline show no shadow. */
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: bar-lift linear both;
      animation-timeline: scroll(root);
      animation-range: 0 8rem;
    }
  }

  @keyframes bar-lift {
    from {
      box-shadow: 0 0.5rem 1.5rem rgb(27 15 46 / 0);
    }
    to {
      box-shadow: 0 0.5rem 1.5rem rgb(27 15 46 / 0.35);
    }
  }

  /* On phones and tablets the header scales with the class like the banner:
     every size is a multiple of --sp (see docs/DESIGN.md), with the 44px tap
     targets as floors. On desktop --sp is 1px and these are fixed sizes; the
     bar's height plus its rule is --header-h, which the first screen uses. */
  .bar {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--sp));
    min-height: max(44px, calc(60 * var(--sp))); /* --header-h, less the rule */
  }

  /* Her mark and her lockup, as in the footer, both lit. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: calc(5 * var(--sp));
    min-height: max(44px, calc(44 * var(--sp)));
    min-width: 0;
    margin-right: auto;
    text-decoration: none;
  }

  .brand :global(.brand-icon) {
    width: calc(38 * var(--sp));
    flex: none;
    filter: drop-shadow(0 0 calc(2 * var(--sp)) rgb(160 100 255 / 0.9))
      drop-shadow(0 0 calc(8 * var(--sp)) rgb(120 60 255 / 0.55));
  }

  /* The lockup (decisions 45 and 49) in its lit lavender paint, with the
     footer's violet glow; its width sets its height (about 4.84 to 1). Its
     size per class follows the owner's reference, where the lockup stands
     about two thirds of the bar's height (decision 60): phones are held a
     little under that by the Donate pill beside it (164 is the widest that
     leaves the brand its own box beside the pill at 393). */
  .brand :global(.brand-lockup) {
    width: calc(164 * var(--sp));
    flex: none;
    filter: drop-shadow(0 0 calc(5 * var(--sp)) rgb(170 110 255 / 0.45));
  }

  /* The Donate pill. The link stays 44px tall for touch; the visible pill
     (38 reference px) is painted by ::after, centred inside it. The chevron
     joins it where there is room (tablets and desktop). */
  .donate {
    --pill: calc(38 * var(--sp));
    --pill-gap: calc((100% - var(--pill)) / 2);
    position: relative;
    isolation: isolate;
    flex: none;
    gap: calc(2 * var(--sp));
    width: calc(82 * var(--sp));
    min-height: max(44px, calc(44 * var(--sp)));
    padding: 0; /* the chevron's offset comes with the chevron (tablets up) */
    font-size: calc(16.3 * var(--sp));
    font-weight: 800;
    letter-spacing: -0.045em;
    color: #fff;
    background: none;
    box-shadow: none;
  }

  .donate .chev {
    display: none;
    width: 1.15em;
    height: 1.15em;
    margin-right: -0.35em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .donate::after {
    content: "";
    position: absolute;
    inset: var(--pill-gap) 0;
    z-index: -2;
    border-radius: var(--r-pill);
    background:
      radial-gradient(45% 80% at 8% 40%, rgb(230 60 60 / 0.3), transparent 70%),
      linear-gradient(180deg, #d4262a 0%, #b41d22 16%, #a91a20 40%, #9b1119 72%, #8f0914 100%);
    box-shadow:
      0 0 0 calc(0.5 * var(--sp)) #f0222e,
      0 0 0 calc(1.3 * var(--sp)) rgb(255 225 240 / 0.45),
      0 calc(1.2 * var(--sp)) calc(1.5 * var(--sp)) calc(0.3 * var(--sp)) rgb(240 50 140 / 0.6),
      0 calc(3 * var(--sp)) calc(6 * var(--sp)) calc(1.5 * var(--sp)) rgb(236 60 140 / 0.55),
      0 0 calc(13 * var(--sp)) calc(3 * var(--sp)) rgb(245 150 215 / 0.45),
      inset var(--sp) var(--sp) var(--sp) rgb(255 90 90 / 0.35),
      inset 0 calc(-2 * var(--sp)) calc(5 * var(--sp)) rgb(90 0 10 / 0.25);
  }

  /* Glossy crescent inside the right end. */
  .donate::before {
    content: "";
    position: absolute;
    inset: calc(var(--pill-gap) + 2.5 * var(--sp)) calc(4 * var(--sp))
      calc(var(--pill-gap) + 5 * var(--sp)) 50%;
    z-index: -1;
    border: calc(1.5 * var(--sp)) solid rgb(255 190 190 / 0.09);
    border-left: 0;
    border-bottom-color: transparent;
    border-radius: 0 999px 999px 0;
    background: linear-gradient(200deg, rgb(70 0 8 / 0.12), transparent 70%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 50%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 50%);
    pointer-events: none;
  }

  .donate:hover {
    background: none;
  }

  /* Hover is more of the same: brighter, with a wider glow; the sheen and
     the ring stay. */
  .donate::after {
    transition:
      filter 150ms ease,
      box-shadow 150ms ease;
  }

  .donate:hover::after {
    filter: brightness(1.08);
    box-shadow:
      0 0 0 calc(0.5 * var(--sp)) #f0222e,
      0 0 0 calc(1.3 * var(--sp)) rgb(255 225 240 / 0.5),
      0 calc(1.2 * var(--sp)) calc(1.5 * var(--sp)) calc(0.3 * var(--sp)) rgb(240 50 140 / 0.65),
      0 calc(3 * var(--sp)) calc(7 * var(--sp)) calc(2 * var(--sp)) rgb(236 60 140 / 0.6),
      0 0 calc(16 * var(--sp)) calc(4 * var(--sp)) rgb(245 150 215 / 0.5),
      inset var(--sp) var(--sp) var(--sp) rgb(255 90 90 / 0.35),
      inset 0 calc(-2 * var(--sp)) calc(5 * var(--sp)) rgb(90 0 10 / 0.25);
  }

  /* On the donation page the pill is where you are: a little quieter, and
     it stays so under the hand. Nothing else about it changes. */
  .donate[aria-current="page"]::after {
    filter: saturate(0.8);
  }

  .donate[aria-current="page"]:hover::after {
    filter: saturate(0.8) brightness(1.08);
  }

  /* Inline links: hidden on phones once the menu is available. Each link
     draws a short violet-to-rose underline when hovered, focused, or current
     (the section on screen, marked by the script above). */
  .inline-nav > ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: max(44px, 2.75rem);
    padding: 0 0.75rem;
    border-radius: var(--r-pill);
    color: rgb(255 255 255 / 0.86);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.55rem;
    height: 0.125rem;
    border-radius: 0.125rem;
    background: linear-gradient(90deg, #a06cff, #e0489a);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current] {
    color: #fff;
  }

  .nav-link:hover::after,
