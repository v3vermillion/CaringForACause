---
import { show } from "../data/facts.ts";
import { facts, navigation, org } from "../data/site";
import Brand from "./Brand.astro";

const phone = show(facts.phone);
const email = show(facts.email);
const { items, donate, help } = navigation;
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href="/">
      <Brand kind="mark" class="brand-icon" label="" />
      <span class="brand-name">{org.shortName}</span>
    </a>

    <!-- Inline links on wide screens, and everywhere without JavaScript. -->
    <nav class="inline-nav" aria-label="Main">
      <ul>
        {items.map((item) =>
          item.children ? (
            <li class="has-menu">
              <button
                type="button"
                class="nav-link"
                aria-expanded="false"
                aria-controls={`sub-${item.id}`}
                data-submenu-button
              >
                {item.label}
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  <path
                    d="M3 6l5 5 5-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <ul id={`sub-${item.id}`} class="submenu" data-submenu>
                <li class="submenu-parent">
                  <a href={item.href}>All ways to help</a>
                </li>
                {item.children.map((child) => (
                  <li>
                    <a href={child.href}>{child.label}</a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a class="nav-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <a class="button button--crimson donate" href={donate.href}>
      {donate.label}
    </a>

    <!-- The corner wedge: the menu's home on phones. -->
    <button
      class="menu-button"
      type="button"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="menu"
      hidden
    >
      <span class="lines" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="visually-hidden">Open menu</span>
    </button>
  </div>
</header>

<dialog id="menu" class="menu on-dark" aria-labelledby="menu-title">
  <div class="menu-inner">
    <div class="menu-top">
      <p id="menu-title" class="menu-brand">
        <Brand kind="mark" class="menu-icon" label="" />
        <span>{org.name}</span>
      </p>
      <button class="menu-close" type="button" data-menu-close>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path
            d="M4 4l12 12M16 4L4 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
          />
        </svg>
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>

    <nav aria-label="Menu">
      <ol class="menu-list">
        {items.map((item, i) => (
          <li style={`--n: ${i};`}>
            <a href={item.href} data-menu-close>
              <span class="menu-label">{item.label}</span>
              <span class="menu-detail">{item.detail}</span>
            </a>
            {item.children && (
              <ul class="menu-sub" aria-label={`${item.label} options`}>
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} data-menu-close>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <div class="menu-foot">
      <div class="menu-doors">
        <a class="button button--signal" href={help.href} data-menu-close>
          {help.label}
        </a>
        <a class="button button--glass" href={donate.href} data-menu-close>
          {donate.label}
        </a>
      </div>
      <p class="menu-contact">
        <a href={phone.href}>{phone.display}</a>
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
  </div>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const menu = document.getElementById("menu") as HTMLDialogElement | null;
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");

  if (header && menu && openButton && typeof menu.showModal === "function") {
    header.classList.add("has-menu");
    openButton.hidden = false;

    const open = () => {
      menu.showModal();
      document.documentElement.classList.add("menu-open");
    };
    const close = () => {
      if (menu.open) menu.close();
    };
    openButton.addEventListener("click", open);
    menu.querySelectorAll("[data-menu-close]").forEach((el) => el.addEventListener("click", close));
    // Tap on the backdrop (outside the panel) closes.
    menu.addEventListener("click", (event) => {
      if (event.target === menu) close();
    });
    menu.addEventListener("close", () => {
      document.documentElement.classList.remove("menu-open");
      openButton.focus();
    });
  }

  // Desktop dropdown: click or keyboard toggles; Escape and clicks elsewhere close.
  document.querySelectorAll<HTMLButtonElement>("[data-submenu-button]").forEach((button) => {
    const item = button.parentElement!;
    const setOpen = (on: boolean) => {
      button.setAttribute("aria-expanded", String(on));
      item.classList.toggle("open", on);
    };
    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });
    item.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
        button.focus();
      }
    });
    item.addEventListener("focusout", (event) => {
      if (!item.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    document.addEventListener("click", (event) => {
      if (!item.contains(event.target as Node)) setOpen(false);
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(250 247 253 / 0.94);
    border-bottom: 1px solid var(--rule);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    min-width: 0;
    margin-right: auto;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(0.95rem, 0.6rem + 1.6vw, 1.25rem);
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand :global(.brand-icon) {
    width: 2rem;
    flex: none;
  }

  .donate {
    min-height: 42px;
    padding-inline: 1rem;
    font-size: 0.95rem;
  }

  /* Inline links: hidden on phones once the menu is available. */
  .inline-nav > ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .inline-nav > ul > li {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: var(--ink);
    font: inherit;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-link:hover,
  .has-menu.open > .nav-link {
    background: var(--lilac);
    color: var(--purple);
  }

  .has-menu.open > .nav-link svg {
    transform: rotate(180deg);
  }

  .submenu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    display: none;
    min-width: 14rem;
    padding: 0.5rem;
    margin: 0;
    list-style: none;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 16px;
    box-shadow: 0 18px 48px rgb(27 15 46 / 0.18);
  }

  .has-menu.open > .submenu {
    display: grid;
  }

  .submenu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: 10px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .submenu a:hover {
    background: var(--lilac);
    color: var(--purple);
  }

  .submenu-parent {
    padding-bottom: 0.35rem;
    margin-bottom: 0.35rem;
    border-bottom: 1px solid var(--rule);
  }

  .submenu-parent a {
    color: var(--purple);
  }

  /* Without JavaScript the inline links wrap under the brand row on phones,
     and the dropdown shows its links inline. */
  .site-header:not(.has-menu) .bar {
    flex-wrap: wrap;
  }

  .site-header:not(.has-menu) .inline-nav {
    order: 3;
    flex-basis: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-header:not(.has-menu) .submenu {
    position: static;
    display: flex;
    flex-wrap: wrap;
    box-shadow: none;
    border: 0;
    padding: 0;
    background: none;
  }

  .site-header:not(.has-menu) .submenu-parent {
    display: none;
  }

  .site-header.has-menu .inline-nav {
    display: none;
  }

  /* The wedge: a diagonal cut in the top-right corner. */
  .menu-button {
    position: relative;
    flex: none;
    align-self: stretch;
    width: 4.25rem;
    margin-right: calc(-1 * var(--gutter));
    border: 0;
    padding: 0 0 0 1.25rem;
    background: linear-gradient(135deg, var(--purple) 0%, var(--purple-deep) 100%);
    clip-path: polygon(38% 0, 100% 0, 100% 100%, 0 100%);
    color: #fff;
    cursor: pointer;
  }

  .menu-button[hidden] {
    display: none;
  }

  .menu-button:hover {
    background: linear-gradient(135deg, #6f1de6 0%, var(--purple) 100%);
  }

  .lines {
    display: grid;
    gap: 5px;
    width: 22px;
    margin-left: auto;
    margin-right: 1.1rem;
  }

  .lines i {
    display: block;
    height: 2px;
    background: #fff;
    border-radius: 2px;
  }

  .lines i:nth-child(2) {
    width: 70%;
  }

  @media (min-width: 56rem) {
    .bar {
      gap: var(--space-m);
    }
    .site-header.has-menu .inline-nav {
      display: block;
      margin-left: auto;
    }
    .site-header.has-menu .menu-button {
      display: none;
    }
    .brand {
      margin-right: 0;
    }
    .donate {
      min-height: 44px;
      font-size: 1rem;
    }
  }

  /* The menu: full screen, dark, typographic. */
  .menu {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background:
      radial-gradient(80% 50% at 100% 0%, rgb(96 8 215 / 0.45), transparent 60%),
      radial-gradient(60% 40% at 0% 100%, rgb(226 32 44 / 0.18), transparent 60%), var(--night);
  }

  .menu::backdrop {
    background: rgb(27 15 46 / 0.6);
  }

  .menu[open] {
    display: grid;
    animation: menu-in 260ms ease-out;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .menu-inner {
    display: grid;
    grid-template-rows: auto 1fr auto;
    width: min(100% - 2 * var(--gutter), 40rem);
    height: 100%;
    margin-inline: auto;
    padding-block: 0.6rem var(--space-m);
    overflow-y: auto;
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 3.75rem;
  }

  .menu-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step--1);
    color: var(--night-soft);
    max-width: none;
  }

  .menu-brand :global(.menu-icon) {
    width: 1.75rem;
    flex: none;
  }

  .menu-close {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    cursor: pointer;
  }

  .menu-inner > nav {
    display: grid;
    align-content: center;
  }

  .menu-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-list > li {
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    animation: item-in 420ms ease-out both;
    animation-delay: calc(80ms + var(--n) * 60ms);
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateX(-0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .menu-list > li > a {
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 0;
    color: #fff;
    text-decoration: none;
  }

  .menu-label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .menu-detail {
    font-size: var(--step--1);
    color: var(--night-soft);
  }

  .menu-list > li > a:hover .menu-label {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .menu-sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 0 0.9rem;
    margin: 0;
    list-style: none;
  }

  .menu-sub a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: var(--r-pill);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    text-decoration: none;
  }

  .menu-sub a:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .menu-foot {
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-m);
  }

  .menu-doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .menu-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
    max-width: none;
  }

  .menu-contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--night-soft);
    font-size: var(--step--1);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu[open],
    .menu-list > li {
      animation: none;
    }
  }
</style>

<style is:global>
  html.menu-open {
    overflow: hidden;
  }
</style>
