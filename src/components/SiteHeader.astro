---
import { navigation, org } from "../data/site";
import Brand from "./Brand.astro";

const { items, donate, help } = navigation;
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href="/">
      <Brand kind="mark" class="brand-icon" label="" />
      <span class="brand-name">{org.shortName}</span>
    </a>

    <!-- Inline links on wide screens, and everywhere without JavaScript. -->
    <nav class="inline-nav" aria-label="Main">
      <ul>
        {items.map((item) => (
          <li>
            <a class="nav-link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="button button--crimson donate" href={donate.href}>
      {donate.label}
    </a>

    <!-- The corner wedge: the menu's home on phones. -->
    <button
      class="menu-button"
      type="button"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="menu"
      hidden
    >
      <span class="lines" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="visually-hidden">Open menu</span>
    </button>
  </div>
</header>

<!--
  The phone menu: one list, the same map as the desktop links, with the two
  doors at either end. Nothing else lives here; contact details are in the
  Contact section it links to.
-->
<dialog id="menu" class="menu on-dark" aria-labelledby="menu-title">
  <div class="menu-inner">
    <div class="menu-top">
      <p id="menu-title" class="menu-brand">
        <Brand kind="mark" class="menu-icon" label="" />
        <span>{org.name}</span>
      </p>
      <button class="menu-close" type="button" data-menu-close>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path
            d="M4 4l12 12M16 4L4 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
          />
        </svg>
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>

    <nav aria-label="Menu">
      <ol class="menu-list">
        <li class="menu-help" style="--n: 0;">
          <a href={help.href} data-menu-close>
            <span class="menu-label">{help.label}</span>
          </a>
        </li>
        {items.map((item, i) => (
          <li style={`--n: ${i + 1};`}>
            <a href={item.href} data-menu-close>
              <span class="menu-label">{item.label}</span>
            </a>
          </li>
        ))}
        <li style={`--n: ${items.length + 1};`}>
          <a href={donate.href} data-menu-close>
            <span class="menu-label">{donate.label}</span>
          </a>
        </li>
      </ol>
    </nav>
  </div>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const menu = document.getElementById("menu") as HTMLDialogElement | null;
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");

  if (header && menu && openButton && typeof menu.showModal === "function") {
    header.classList.add("has-menu");
    openButton.hidden = false;

    const open = () => {
      menu.showModal();
      document.documentElement.classList.add("menu-open");
    };
    const close = () => {
      if (menu.open) menu.close();
    };
    openButton.addEventListener("click", open);
    menu.querySelectorAll("[data-menu-close]").forEach((el) => el.addEventListener("click", close));
    // Tap on the backdrop (outside the panel) closes.
    menu.addEventListener("click", (event) => {
      if (event.target === menu) close();
    });
    menu.addEventListener("close", () => {
      document.documentElement.classList.remove("menu-open");
      openButton.focus();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(250 247 253 / 0.94);
    border-bottom: 1px solid var(--rule);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  /* On phones and tablets the header scales with the class like the banner:
     every size is a multiple of --rp (see docs/DESIGN.md), with the 44px tap
     targets as floors. On desktop --rp is 1px and these are fixed sizes; the
     bar's 60px plus its border is --header-h, which the first screen uses. */
  .bar {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--sp));
    min-height: calc(60 * var(--sp));
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: calc(8.8 * var(--sp));
    min-height: max(44px, calc(44 * var(--sp)));
    min-width: 0;
    margin-right: auto;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 750;
    font-size: calc(15.9 * var(--sp));
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand :global(.brand-icon) {
    width: calc(32 * var(--sp));
    flex: none;
  }

  .donate {
    min-height: max(44px, calc(42 * var(--sp)));
    padding: calc(11.2 * var(--sp)) calc(16 * var(--sp));
    font-size: calc(15.2 * var(--sp));
  }

  /* Inline links: hidden on phones once the menu is available. */
  .inline-nav > ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: max(44px, 2.75rem);
    padding: 0 0.75rem;
    border-radius: var(--r-pill);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-link:hover {
    background: var(--lilac);
    color: var(--purple);
  }

  /* Without JavaScript the inline links wrap under the brand row on phones. */
  .site-header:not(.has-menu) .bar {
    flex-wrap: wrap;
  }

  .site-header:not(.has-menu) .inline-nav {
    order: 3;
    flex-basis: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-header.has-menu .inline-nav {
    display: none;
  }

  /* The wedge: a diagonal cut in the top-right corner. */
  .menu-button {
    position: relative;
    flex: none;
    align-self: stretch;
    width: calc(68 * var(--sp));
    margin-right: calc(-1 * var(--gutter));
    border: 0;
    padding: 0 0 0 calc(20 * var(--sp));
    background: linear-gradient(135deg, var(--purple) 0%, var(--purple-deep) 100%);
    clip-path: polygon(38% 0, 100% 0, 100% 100%, 0 100%);
    color: #fff;
    cursor: pointer;
  }

  .menu-button[hidden] {
    display: none;
  }

  .menu-button:hover {
    background: linear-gradient(135deg, #6f1de6 0%, var(--purple) 100%);
  }

  .lines {
    display: grid;
    gap: calc(5 * var(--sp));
    width: calc(22 * var(--sp));
    margin-left: auto;
    margin-right: calc(17.6 * var(--sp));
  }

  .lines i {
    display: block;
    height: max(2px, calc(2 * var(--sp)));
    background: #fff;
    border-radius: 2px;
  }

  .lines i:nth-child(2) {
    width: 70%;
  }

  /* Tablets: the name at the 768px reference's size. */
  @media (min-width: 36rem) {
    .brand {
      font-size: calc(20 * var(--sp));
    }
    .menu-label {
      font-size: 2.448rem;
    }
  }

  @media (min-width: 56rem) {
    .bar {
      gap: var(--space-m);
    }
    .site-header.has-menu .inline-nav {
      display: block;
      margin-left: auto;
    }
    .site-header.has-menu .menu-button {
      display: none;
    }
    .brand {
      margin-right: 0;
    }
    .donate {
      min-height: max(44px, 2.75rem);
      font-size: 1rem;
    }
    .menu-label {
      font-size: 2.5rem;
    }
  }

  /* The menu: full screen, dark, typographic. */
  .menu {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background:
      radial-gradient(80% 50% at 100% 0%, rgb(96 8 215 / 0.45), transparent 60%),
      radial-gradient(60% 40% at 0% 100%, rgb(226 32 44 / 0.18), transparent 60%), var(--night);
  }

  .menu::backdrop {
    background: rgb(27 15 46 / 0.6);
  }

  .menu[open] {
    display: grid;
    animation: menu-in 260ms ease-out;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .menu-inner {
    display: grid;
    grid-template-rows: auto 1fr;
    width: min(100% - 2 * var(--gutter), var(--wide)); /* the same column as the header */
    height: 100%;
    margin-inline: auto;
    padding-block: 0.6rem var(--space-m);
    overflow-y: auto;
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 3.75rem;
  }

  .menu-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step--1);
    color: var(--night-soft);
    max-width: none;
  }

  .menu-brand :global(.menu-icon) {
    width: 1.75rem;
    flex: none;
  }

  .menu-close {
    display: grid;
    place-items: center;
    flex: none;
    width: max(44px, 2.75rem);
    height: max(44px, 2.75rem);
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    cursor: pointer;
  }

  .menu-inner > nav {
    display: grid;
    align-content: center;
  }

  .menu-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-list > li {
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    animation: item-in 420ms ease-out both;
    animation-delay: calc(80ms + var(--n) * 60ms);
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateX(-0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .menu-list > li > a {
    display: block;
    padding: 0.8rem 0;
    color: #fff;
    text-decoration: none;
  }

  .menu-label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.839rem; /* one value per class, like --step-3 (see the media blocks above) */
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  /* Help me first, in the signal colour: the site's job is to route people. */
  .menu-help .menu-label {
    color: var(--signal);
  }

  .menu-list > li > a:hover .menu-label {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu[open],
    .menu-list > li {
      animation: none;
    }
  }
</style>

<style is:global>
  html.menu-open {
    overflow: hidden;
  }
</style>
