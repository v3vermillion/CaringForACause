---
import { navigation, org } from "../data/site";
import Brand from "./Brand.astro";

const { items, donate, help } = navigation;
---

<header class="site-header" data-header>
  <!-- Decorative light sweep behind the left of the bar: the violet and
       crimson bands of her logo files, and a white lens toward Donate. -->
  <svg
    class="sweep"
    viewBox="0 0 1400 352"
    preserveAspectRatio="xMinYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="sw-top" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="80" y2="72">
        <stop offset="0" stop-color="#6424da" />
        <stop offset="1" stop-color="#2a0676" />
      </linearGradient>
      <linearGradient id="sw-rib" gradientUnits="userSpaceOnUse" x1="300" y1="0" x2="530" y2="0">
        <stop offset="0" stop-color="#9f0c5a" stop-opacity="0" />
        <stop offset="0.25" stop-color="#9f0c5a" />
        <stop offset="1" stop-color="#b3042c" />
      </linearGradient>
      <linearGradient id="sw-bot" gradientUnits="userSpaceOnUse" x1="0" y1="300" x2="330" y2="352">
        <stop offset="0" stop-color="#b08cf8" />
        <stop offset="0.35" stop-color="#8a62da" />
        <stop offset="0.7" stop-color="#5a2fae" />
        <stop offset="1" stop-color="#3c128c" />
      </linearGradient>
      <linearGradient id="sw-ustroke" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="200" y2="0">
        <stop offset="0" stop-color="#f2a8dc" stop-opacity="0.75" />
        <stop offset="0.45" stop-color="#e8307a" stop-opacity="0.7" />
        <stop offset="1" stop-color="#ec1f48" />
      </linearGradient>
      <linearGradient id="sw-pstroke" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="360" y2="0">
        <stop offset="0" stop-color="#f06a9a" stop-opacity="0.15" />
        <stop offset="0.45" stop-color="#f02a60" stop-opacity="0.7" />
        <stop offset="1" stop-color="#f5184a" />
      </linearGradient>
      <linearGradient id="sw-bandT2" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="300" y2="0">
        <stop offset="0" stop-color="#ab84fb" />
        <stop offset="0.5" stop-color="#9468e4" />
        <stop offset="0.8" stop-color="#6a2cc0" />
        <stop offset="1" stop-color="#5e22c1" />
      </linearGradient>
      <linearGradient id="sw-bandB" gradientUnits="userSpaceOnUse" x1="180" y1="0" x2="400" y2="0">
        <stop offset="0" stop-color="#b893fb" />
        <stop offset="0.5" stop-color="#9a7af6" />
        <stop offset="1" stop-color="#7a2cd0" />
      </linearGradient>
      <linearGradient id="sw-wT" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="360" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
        <stop offset="0.6" stop-color="#fff" stop-opacity="0.6" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="sw-wB" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="420" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
        <stop offset="0.6" stop-color="#fff" stop-opacity="0.8" />
        <stop offset="1" stop-color="#fff" stop-opacity="0.2" />
      </linearGradient>
      <linearGradient id="sw-low" gradientUnits="userSpaceOnUse" x1="0" y1="250" x2="0" y2="352">
        <stop offset="0" stop-color="#dccdfd" />
        <stop offset="0.6" stop-color="#d3c1fb" />
        <stop offset="1" stop-color="#c9b3f8" />
      </linearGradient>
      <linearGradient
        id="sw-lowm-g"
        gradientUnits="userSpaceOnUse"
        x1="520"
        y1="0"
        x2="1300"
        y2="0"
      >
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.15" stop-color="#fff" />
        <stop offset="0.8" stop-color="#fff" />
        <stop offset="1" stop-color="#fff" stop-opacity="0.2" />
      </linearGradient>
      <mask id="sw-lowm" maskUnits="userSpaceOnUse" x="500" y="200" width="820" height="170">
        <rect x="500" y="200" width="820" height="170" fill="url(#sw-lowm-g)" />
      </mask>
      <linearGradient id="sw-t0" gradientUnits="userSpaceOnUse" x1="10" y1="0" x2="150" y2="0">
        <stop offset="0" stop-color="#b0287e" stop-opacity="0" />
        <stop offset="1" stop-color="#b0287e" stop-opacity="1" />
      </linearGradient>
      <linearGradient id="sw-t1" gradientUnits="userSpaceOnUse" x1="10" y1="0" x2="150" y2="0">
        <stop offset="0" stop-color="#a0288f" stop-opacity="0" />
        <stop offset="1" stop-color="#a0288f" stop-opacity="0.95" />
      </linearGradient>
      <linearGradient id="sw-t2" gradientUnits="userSpaceOnUse" x1="10" y1="0" x2="150" y2="0">
        <stop offset="0" stop-color="#93329f" stop-opacity="0" />
        <stop offset="1" stop-color="#93329f" stop-opacity="0.85" />
      </linearGradient>
      <linearGradient id="sw-t3" gradientUnits="userSpaceOnUse" x1="10" y1="0" x2="150" y2="0">
        <stop offset="0" stop-color="#8741b0" stop-opacity="0" />
        <stop offset="1" stop-color="#8741b0" stop-opacity="0.7" />
      </linearGradient>
      <linearGradient id="sw-t4" gradientUnits="userSpaceOnUse" x1="10" y1="0" x2="150" y2="0">
        <stop offset="0" stop-color="#8a50c8" stop-opacity="0" />
        <stop offset="1" stop-color="#8a50c8" stop-opacity="0.5" />
      </linearGradient>
      <linearGradient id="sw-b0" gradientUnits="userSpaceOnUse" x1="190" y1="0" x2="270" y2="0">
        <stop offset="0" stop-color="#ad1a70" stop-opacity="0" />
        <stop offset="1" stop-color="#ad1a70" stop-opacity="1" />
      </linearGradient>
      <linearGradient id="sw-b1" gradientUnits="userSpaceOnUse" x1="190" y1="0" x2="270" y2="0">
        <stop offset="0" stop-color="#9c3b9c" stop-opacity="0" />
        <stop offset="1" stop-color="#9c3b9c" stop-opacity="0.95" />
      </linearGradient>
      <linearGradient id="sw-b2" gradientUnits="userSpaceOnUse" x1="190" y1="0" x2="270" y2="0">
        <stop offset="0" stop-color="#9a4ebe" stop-opacity="0" />
        <stop offset="1" stop-color="#9a4ebe" stop-opacity="0.85" />
      </linearGradient>
      <linearGradient id="sw-b3" gradientUnits="userSpaceOnUse" x1="190" y1="0" x2="270" y2="0">
        <stop offset="0" stop-color="#955cd3" stop-opacity="0" />
        <stop offset="1" stop-color="#955cd3" stop-opacity="0.7" />
      </linearGradient>
      <linearGradient id="sw-b4" gradientUnits="userSpaceOnUse" x1="190" y1="0" x2="270" y2="0">
        <stop offset="0" stop-color="#9767e8" stop-opacity="0" />
        <stop offset="1" stop-color="#9767e8" stop-opacity="0.5" />
      </linearGradient>
      <filter id="sw-soft" x="-20%" y="-50%" width="140%" height="200%">
        <feGaussianBlur stdDeviation="3" />
      </filter>
      <filter id="sw-hair" x="-20%" y="-50%" width="140%" height="200%">
        <feGaussianBlur stdDeviation="1.2" />
      </filter>
      <filter id="sw-glow" x="-30%" y="-80%" width="160%" height="260%">
        <feGaussianBlur stdDeviation="22" />
      </filter>
    </defs>
    <!-- white lens -->
    <ellipse
      cx="560"
      cy="172"
      rx="560"
      ry="90"
      fill="#fdfbff"
      filter="url(#sw-glow)"
      opacity="0.8"
    />
    <!-- lower edge of the light lens, sweeping toward the Donate button -->
    <path
      d="M520.0,240.0 C782.1,260.9 1046.1,289.4 1300.0,360.0 L1300,366 L520,366 Z"
      fill="url(#sw-low)"
      filter="url(#sw-hair)"
      mask="url(#sw-lowm)"
    />
    <!-- top-left: dark corner, violet band with a white edge, crimson line -->
    <path
      d="M-6.0,99.0 C121.7,38.7 260.3,9.8 400.0,-5.0 L560,-8 L560.0,-2.0 C366.7,16.5 164.4,33.0 -6.0,136.0 Z"
      fill="url(#sw-bandT2)"
    />
    <path
      d="M-6.0,99.0 C121.7,38.7 260.3,9.8 400.0,-5.0"
      transform="translate(0,4)"
      fill="none"
      stroke="url(#sw-t0)"
      stroke-width="4.6"
      filter="url(#sw-hair)"
    />
    <path
      d="M-6.0,99.0 C121.7,38.7 260.3,9.8 400.0,-5.0"
      transform="translate(0,8)"
      fill="none"
      stroke="url(#sw-t1)"
      stroke-width="4.6"
      filter="url(#sw-hair)"
    />
    <path
      d="M-6.0,99.0 C121.7,38.7 260.3,9.8 400.0,-5.0"
      transform="translate(0,12)"
      fill="none"
      stroke="url(#sw-t2)"
      stroke-width="4.6"
      filter="url(#sw-hair)"
    />
    <path
      d="M-6.0,99.0 C121.7,38.7 260.3,9.8 400.0,-5.0"
      transform="translate(0,16)"
      fill="none"
      stroke="url(#sw-t3)"
      stroke-width="4.6"
      filter="url(#sw-hair)"
    />
    <path
      d="M-6.0,99.0 C121.7,38.7 260.3,9.8 400.0,-5.0"
      transform="translate(0,20)"
      fill="none"
      stroke="url(#sw-t4)"
      stroke-width="4.6"
      filter="url(#sw-hair)"
    />
    <path
      d="M-6.0,136.0 C164.4,33.0 366.7,16.5 560.0,-2.0"
      fill="none"
      stroke="url(#sw-wT)"
      stroke-width="3.5"
    />
    <path d="M-6.0,99.0 C121.7,38.7 260.3,9.8 400.0,-5.0 L400,-8 L-6,-8 Z" fill="url(#sw-top)" />
    <path
      d="M300.0,7.5 C333.6,5.7 366.8,-0.2 400.0,-5.0 L535,-6 L535.0,-3.0 C466.8,5.6 398.8,18.5 330.0,21.0 Z"
      fill="url(#sw-rib)"
    />
    <path
      d="M-6.0,99.0 C121.7,38.7 260.3,9.8 400.0,-5.0"
      fill="none"
      stroke="url(#sw-ustroke)"
      stroke-width="7"
      opacity="0.35"
      filter="url(#sw-soft)"
    />
    <path
      d="M-6.0,99.0 C121.7,38.7 260.3,9.8 400.0,-5.0"
      fill="none"
      stroke="url(#sw-ustroke)"
      stroke-width="4.5"
    />
    <path
      d="M330.0,21.0 C398.8,18.5 466.8,5.6 535.0,-3.0"
      fill="none"
      stroke="#e8081e"
      stroke-width="3.6"
    />
    <!-- bottom-left: violet band with a white edge, purple, crimson line -->
    <path
      d="M-6.0,200.0 C182.1,297.1 394.3,324.5 600.0,361.0 L600,366 L420.0,360.0 C275.3,326.8 133.7,282.1 -6.0,232.0 Z"
      fill="url(#sw-bandB)"
    />
    <path
      d="M-6.0,232.0 C133.7,282.1 275.3,326.8 420.0,360.0"
      transform="translate(0,-4)"
      fill="none"
      stroke="url(#sw-b0)"
      stroke-width="4.6"
      filter="url(#sw-hair)"
    />
    <path
      d="M-6.0,232.0 C133.7,282.1 275.3,326.8 420.0,360.0"
      transform="translate(0,-8)"
      fill="none"
      stroke="url(#sw-b1)"
      stroke-width="4.6"
      filter="url(#sw-hair)"
    />
    <path
      d="M-6.0,232.0 C133.7,282.1 275.3,326.8 420.0,360.0"
      transform="translate(0,-12)"
      fill="none"
      stroke="url(#sw-b2)"
      stroke-width="4.6"
      filter="url(#sw-hair)"
    />
    <path
      d="M-6.0,232.0 C133.7,282.1 275.3,326.8 420.0,360.0"
      transform="translate(0,-16)"
      fill="none"
      stroke="url(#sw-b3)"
      stroke-width="4.6"
      filter="url(#sw-hair)"
    />
    <path
      d="M-6.0,232.0 C133.7,282.1 275.3,326.8 420.0,360.0"
      transform="translate(0,-20)"
      fill="none"
      stroke="url(#sw-b4)"
      stroke-width="4.6"
      filter="url(#sw-hair)"
    />
    <path
      d="M-6.0,200.0 C182.1,297.1 394.3,324.5 600.0,361.0"
      fill="none"
      stroke="url(#sw-wB)"
      stroke-width="4"
    />
    <path
      d="M-6.0,232.0 C133.7,282.1 275.3,326.8 420.0,360.0 L420,366 L-6,366 Z"
      fill="url(#sw-bot)"
    />
    <path
      d="M-6.0,232.0 C133.7,282.1 275.3,326.8 420.0,360.0"
      fill="none"
      stroke="url(#sw-pstroke)"
      stroke-width="7"
      opacity="0.35"
      filter="url(#sw-soft)"
    />
    <path
      d="M-6.0,232.0 C133.7,282.1 275.3,326.8 420.0,360.0"
      fill="none"
      stroke="url(#sw-pstroke)"
      stroke-width="5.5"
    />
  </svg>
  <div class="wrap bar">
    <a class="brand" href="/">
      <Brand kind="mark" class="brand-icon" label="" />
      <span class="brand-name">{org.shortName}</span>
    </a>

    <!-- Inline links on wide screens, and everywhere without JavaScript. -->
    <nav class="inline-nav" aria-label="Main">
      <ul>
        {items.map((item) => (
          <li>
            <a class="nav-link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="button button--crimson donate" href={donate.href}>
      {donate.label}
    </a>

    <!-- The corner wedge: the menu's home on phones. -->
    <button
      class="menu-button"
      type="button"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="menu"
      hidden
    >
      <span class="band" aria-hidden="true"></span>
      <span class="corner" aria-hidden="true"></span>
      <span class="edge" aria-hidden="true"></span>
      <span class="lines" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="visually-hidden">Open menu</span>
    </button>
  </div>
</header>

<!--
  The phone menu: one list, the same map as the desktop links, with the two
  doors at either end. Nothing else lives here; contact details are in the
  Contact section it links to.
-->
<dialog
  id="menu"
  class="menu on-dark"
  aria-labelledby="menu-title"
  tabindex="-1"
  style={`--menu-rows: ${items.length + 2};`}
>
  <div class="menu-art" aria-hidden="true">
    <svg class="menu-ribbon" viewBox="440 0 412 300" focusable="false">
      <defs>
        <linearGradient id="mr-above" x1="0" y1="0" x2="1" y2="0.3">
          <stop offset="0" stop-color="#1c0832" />
          <stop offset="0.45" stop-color="#2e0a40" />
          <stop offset="1" stop-color="#5e0d58" />
        </linearGradient>
        <linearGradient id="mr-band" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#6a1466" stop-opacity="0" />
          <stop offset="0.5" stop-color="#7a1268" stop-opacity="0.7" />
          <stop offset="1" stop-color="#a8187c" />
        </linearGradient>
        <linearGradient id="mr-line" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#5a38e0" stop-opacity="0.5" />
          <stop offset="0.45" stop-color="#9a2eb8" />
          <stop offset="1" stop-color="#f062c4" />
        </linearGradient>
        <radialGradient id="mr-below" cx="1" cy="0.75" r="0.9">
          <stop offset="0" stop-color="#2a0a64" />
          <stop offset="0.6" stop-color="#1c0848" stop-opacity="0.6" />
          <stop offset="1" stop-color="#140630" stop-opacity="0" />
        </radialGradient>
        <filter id="mr-soft" x="-40%" y="-60%" width="180%" height="220%">
          <feGaussianBlur stdDeviation="3" />
        </filter>
        <filter id="mr-glow" x="-10%" y="-40%" width="120%" height="180%">
          <feGaussianBlur stdDeviation="5" />
        </filter>
      </defs>
      <rect x="440" y="0" width="412" height="300" fill="url(#mr-below)" />
      <path d="M455,0 C560,45 690,115 852,205 L852,0 Z" fill="url(#mr-above)" />
      <path
        d="M590,0 C680,55 760,120 852,152 L852,205 C700,120 600,60 520,22 C540,12 565,5 590,0 Z"
        fill="url(#mr-band)"
        filter="url(#mr-soft)"
      />
      <path
        d="M455,0 C560,45 690,115 852,205"
        fill="none"
        stroke="url(#mr-line)"
        stroke-width="8"
        opacity="0.35"
        filter="url(#mr-glow)"
      />
      <path
        d="M455,0 C560,45 690,115 852,205"
        fill="none"
        stroke="url(#mr-line)"
        stroke-width="2.6"
      />
      <path
        d="M590,0 C680,55 760,120 852,152"
        fill="none"
        stroke="#b02a90"
        stroke-width="2"
        opacity="0.55"
        filter="url(#mr-soft)"
      />
    </svg>
    <svg class="menu-waves" viewBox="0 1440 852 406" focusable="false">
      <defs>
        <linearGradient id="mw-low" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="560" y2="0">
          <stop offset="0" stop-color="#860a22" />
          <stop offset="0.11" stop-color="#5e0826" />
          <stop offset="0.22" stop-color="#3e0729" />
          <stop offset="0.36" stop-color="#2a0630" />
          <stop offset="0.6" stop-color="#20063a" />
          <stop offset="1" stop-color="#1c0748" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="mw-ab" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="600" y2="0">
          <stop offset="0" stop-color="#7a0a24" />
          <stop offset="0.25" stop-color="#6a0a2a" />
          <stop offset="0.45" stop-color="#420834" />
          <stop offset="0.7" stop-color="#2c0a5a" />
          <stop offset="1" stop-color="#2a0a6a" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="mw-bc" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="780" y2="0">
          <stop offset="0" stop-color="#c4163a" />
          <stop offset="0.15" stop-color="#b41c48" />
          <stop offset="0.3" stop-color="#9a1a66" />
          <stop offset="0.45" stop-color="#6c1682" />
          <stop offset="0.62" stop-color="#3e0e82" />
          <stop offset="0.85" stop-color="#2c0a72" />
          <stop offset="1" stop-color="#2a0870" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="mw-edge" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="800" y2="0">
          <stop offset="0" stop-color="#ff4a6a" />
          <stop offset="0.2" stop-color="#f25a86" />
          <stop offset="0.4" stop-color="#b0309a" />
          <stop offset="0.65" stop-color="#5a22b0" />
          <stop offset="1" stop-color="#3c14a0" stop-opacity="0.2" />
        </linearGradient>
        <linearGradient id="mw-ring" x1="0" y1="0" x2="1" y2="0.4">
          <stop offset="0" stop-color="#220850" />
          <stop offset="0.6" stop-color="#2c0b66" />
          <stop offset="1" stop-color="#3e1296" />
        </linearGradient>
      </defs>
      <path
        d="M0,1448 C120,1470 260,1560 360,1650 C440,1720 500,1790 560,1846 L0,1846 Z"
        fill="url(#mw-low)"
      />
      <path
        d="M0,1448 C120,1470 260,1560 360,1650 C440,1720 500,1790 560,1846 L780,1846 C680,1830 560,1810 420,1745 C300,1680 150,1580 0,1533 Z"
        fill="url(#mw-ab)"
        opacity="0.9"
      />
      <path
        d="M0,1533 C150,1580 300,1680 420,1745 C560,1810 680,1830 780,1846 L440,1846 C380,1805 320,1765 240,1712 C160,1660 80,1625 0,1611 Z"
        fill="url(#mw-bc)"
        opacity="0.92"
      />
      <path
        d="M0,1448 C120,1470 260,1560 360,1650 C440,1720 500,1790 560,1846"
        fill="none"
        stroke="url(#mw-edge)"
        stroke-width="9"
        opacity="0.18"
      />
      <path
        d="M0,1448 C120,1470 260,1560 360,1650 C440,1720 500,1790 560,1846"
        fill="none"
        stroke="url(#mw-edge)"
        stroke-width="2.4"
      />
      <path
        d="M0,1533 C150,1580 300,1680 420,1745 C560,1810 680,1830 780,1846"
        fill="none"
        stroke="url(#mw-edge)"
        stroke-width="9"
        opacity="0.2"
      />
      <path
        d="M0,1533 C150,1580 300,1680 420,1745 C560,1810 680,1830 780,1846"
        fill="none"
        stroke="url(#mw-edge)"
        stroke-width="2.4"
      />
      <path
        d="M0,1611 C80,1625 160,1660 240,1712 C320,1765 380,1805 440,1846"
        fill="none"
        stroke="url(#mw-edge)"
        stroke-width="1.8"
        opacity="0.75"
      />
    </svg>
    <Brand kind="mark" class="menu-watermark" label="" />
  </div>

  <div class="menu-inner">
    <div class="menu-top">
      <p id="menu-title" class="menu-brand">
        <Brand kind="mark" class="menu-icon" label="" />
        <span class="menu-brand-text">
          <span class="menu-brand-name">{org.shortName}</span>
          <span class="menu-brand-sub">{org.name.replace(org.shortName, "").trim()}</span>
        </span>
      </p>
      <button class="menu-close" type="button" data-menu-close>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path
            d="M3.5 3.5l13 13M16.5 3.5l-13 13"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
          />
        </svg>
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>

