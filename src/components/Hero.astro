---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { hero } from "../data/site";

const { doors, montage } = hero;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const slides = montage.map((photo, i) => {
  const match = files[`../assets/photos/${photo.file}`];
  if (!match) throw new Error(`Hero photo not found: src/assets/photos/${photo.file}`);
  return { ...photo, src: match.default, index: i };
});
const cycle = slides.length * 6; // seconds for one full rotation

export const MONTAGE_IMAGE = {
  formats: ["avif", "webp"] as ("avif" | "webp")[],
  quality: 60,
  widths: [480, 640, 720],
  sizes: "(min-width: 56rem) 560px, calc(100vw - 2.5rem)",
};
---

<!--
  The first screen is a routing system: the two doors come first, then the
  caption that says who she is, then her photos with nothing written on them.
-->
<section
  class="hero"
  aria-labelledby="hero-title"
  style={`--slides: ${slides.length}; --cycle: ${cycle}s;`}
>
  <div class="wrap frame">
    <div class="doors">
      <a class="door door--help" href={doors.getHelp.href}>
        <span class="door-text">
          <span class="door-title">{doors.getHelp.title}</span>
          <span class="door-body">{doors.getHelp.body}</span>
        </span>
        <span class="door-go" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path
              d="M9 5l7 7-7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </a>
      <a class="door door--give" href={doors.giveHelp.href}>
        <span class="door-text">
          <span class="door-title">{doors.giveHelp.title}</span>
          <span class="door-body">{doors.giveHelp.body}</span>
        </span>
        <span class="door-go" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path
              d="M9 5l7 7-7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </a>
    </div>

    <div class="copy">
      <h1 id="hero-title">{hero.headline}</h1>
      <p class="subhead">{hero.subhead}</p>
    </div>

    <figure class="panel">
      <div class="montage" aria-hidden="true" data-montage>
        {slides.map((slide) => (
          <div class="slide-wrap" hidden={slide.index > 0} style={`--i: ${slide.index};`}>
            <Picture
              src={slide.src}
              formats={MONTAGE_IMAGE.formats}
              alt=""
              quality={MONTAGE_IMAGE.quality}
              widths={MONTAGE_IMAGE.widths}
              sizes={MONTAGE_IMAGE.sizes}
              loading={slide.index === 0 ? "eager" : "lazy"}
              decoding="async"
              style={`object-position: ${slide.focus ?? "center"};`}
            />
          </div>
        ))}
      </div>
      <figcaption class="tagline">{hero.tagline}</figcaption>
    </figure>
  </div>
</section>

<script>
  // The first photo loads with the page. The rest are hidden (so they don't
  // download) until the page has loaded, then the crossfade starts. Without
  // JavaScript, or with reduced motion, the first photo simply stays.
  const montage = document.querySelector<HTMLElement>("[data-montage]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (montage && !reduce) {
    const start = () => {
      montage.querySelectorAll<HTMLElement>(".slide-wrap[hidden]").forEach((el) => {
        el.hidden = false;
      });
      montage.classList.add("play");
    };
    if (document.readyState === "complete") setTimeout(start, 1200);
    else addEventListener("load", () => setTimeout(start, 1200), { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--night);
    color: #fff;
    padding-block: var(--space-m) var(--space-xl);
  }

  /* One quiet glow behind everything, so the dark isn't flat. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 45% at 100% 0%, rgb(96 8 215 / 0.45), transparent 65%),
      radial-gradient(60% 40% at 0% 100%, rgb(186 1 12 / 0.18), transparent 60%);
  }

  .frame {
    display: grid;
    gap: var(--space-m);
  }

  /* The doors: the page's signature element. */
  .doors {
    display: grid;
    gap: 0.6rem;
  }

  .door {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 5.25rem;
    padding: 1rem 1rem 1rem 1.25rem;
    border-radius: 22px;
    text-decoration: none;
    transition:
      transform 150ms ease,
      box-shadow 150ms ease,
      background-color 150ms ease;
  }

  .door:hover {
    transform: translateY(-2px);
  }

  .door-text {
    display: grid;
    gap: 0.2rem;
    flex: 1;
    min-width: 0;
  }

  .door-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .door-body {
    font-size: var(--step--1);
    line-height: 1.35;
  }

  .door-go {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
  }

  /* Help me: crimson with a soft signal glow. */
  .door--help {
    background: linear-gradient(135deg, #d0101c 0%, var(--crimson) 60%, #9c000a 100%);
    color: #fff;
    box-shadow:
      0 14px 40px rgb(186 1 12 / 0.4),
      0 0 0 1px rgb(255 255 255 / 0.12) inset;
  }

  .door--help .door-go {
    background: rgb(255 255 255 / 0.18);
  }

  .door--help:hover {
    box-shadow:
      0 18px 48px rgb(186 1 12 / 0.55),
      0 0 0 1px rgb(255 255 255 / 0.18) inset;
  }

  /* I want to help: glass. */
  .door--give {
    position: relative;
    background: rgb(255 255 255 / 0.09);
    color: #fff;
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .door--give .door-go {
    background: rgb(255 255 255 / 0.12);
  }

  .door--give:hover {
    background: rgb(255 255 255 / 0.15);
  }

  /* Hairline gradient edge (the "light on glass" line). */
  .door--give::before,
  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.55),
      rgb(96 8 215 / 0.6) 45%,
      rgb(186 1 12 / 0.45)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .copy {
    display: grid;
    gap: 0.6rem;
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(1.75rem, 1.1rem + 3vw, 3.25rem);
  }

  .subhead {
    color: #d9cef2;
    font-size: var(--step-0);
    line-height: 1.45;
    max-width: 36ch;
  }

  /* The photo panel: her photos, nothing written on them. */
  .panel {
    position: relative;
    margin: 0;
    border-radius: 24px;
  }

  .montage {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: inherit;
    background: #2a1640;
  }

  .slide-wrap,
  .montage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide-wrap[hidden] {
    display: none;
  }

  .montage :global(img) {
    object-fit: cover;
    transform: scale(1.03);
  }

  .slide-wrap:first-child :global(img) {
    opacity: 1;
  }

  .montage.play .slide-wrap :global(img) {
    opacity: 0;
    animation: crossfade var(--cycle) infinite;
    animation-delay: calc(var(--i) * (var(--cycle) / var(--slides)) - var(--cycle) * 0.08);
  }

  @keyframes crossfade {
    0% {
      opacity: 0;
    }
    8%,
    25% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  .tagline {
    position: absolute;
    right: 1rem;
    bottom: -0.9rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--night);
    color: var(--night-soft);
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step--1);
    letter-spacing: -0.01em;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .montage :global(img) {
      animation: none !important;
      transform: none;
    }
    .slide-wrap:first-child :global(img) {
      opacity: 1 !important;
    }
  }

  @media (min-width: 40rem) {
    .door {
      min-height: 6rem;
      padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    }
  }

  /* Desktop: doors and caption on the left, the photo panel on the right. */
  @media (min-width: 56rem) {
    .hero {
      padding-block: var(--space-xl);
    }
    .frame {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      grid-template-areas:
        "doors panel"
        "copy panel";
      column-gap: var(--space-xl);
      align-items: center;
    }
    .doors {
      grid-area: doors;
      align-self: end;
    }
    .copy {
      grid-area: copy;
      align-self: start;
    }
    .panel {
      grid-area: panel;
      justify-self: end;
      width: min(100%, 30rem);
    }
    .montage {
      aspect-ratio: 5 / 6;
    }
    .door-title {
      font-size: var(--step-3);
    }
    .door-body {
      font-size: var(--step-0);
    }
  }
</style>
