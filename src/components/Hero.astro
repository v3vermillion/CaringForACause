---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { hero } from "../data/site";

const { doors, montage } = hero;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const slides = montage.map((photo, i) => {
  const match = files[`../assets/photos/${photo.file}`];
  if (!match) throw new Error(`Hero photo not found: src/assets/photos/${photo.file}`);
  return { ...photo, src: match.default, index: i };
});
const cycle = slides.length * 6; // seconds for one full rotation

/** Image options shared with the preload in the page head. Keep in sync. */
export const MONTAGE_IMAGE = {
  formats: ["avif", "webp"] as ("avif" | "webp")[],
  quality: 50,
  widths: [480, 640],
  sizes: "(min-width: 56rem) 560px, 100vw",
};
---

<section
  class="hero"
  aria-labelledby="hero-title"
  style={`--slides: ${slides.length}; --cycle: ${cycle}s;`}
>
  <div class="wrap frame">
    <!-- Decorative montage of the organization's own event photos. -->
    <div class="montage" aria-hidden="true" data-montage>
      {slides.map((slide) => (
        <div class="slide-wrap" hidden={slide.index > 0} style={`--i: ${slide.index};`}>
          <Picture
            src={slide.src}
            formats={MONTAGE_IMAGE.formats}
            alt=""
            quality={MONTAGE_IMAGE.quality}
            widths={MONTAGE_IMAGE.widths}
            sizes={MONTAGE_IMAGE.sizes}
            loading={slide.index === 0 ? "eager" : "lazy"}
            fetchpriority={slide.index === 0 ? "high" : "auto"}
            decoding="async"
            style={`object-position: ${slide.focus ?? "center"};`}
          />
        </div>
      ))}
      <div class="veil"></div>
    </div>

    <div class="content">
      <h1 id="hero-title">{hero.headline}</h1>
      <p class="subhead">{hero.subhead}</p>

      <div class="doors">
        <a class="door door--help" href={doors.getHelp.href}>
          <span class="door-title">{doors.getHelp.title}</span>
          <span class="door-body">{doors.getHelp.body}</span>
        </a>
        <a class="door door--give" href={doors.giveHelp.href}>
          <span class="door-title">{doors.giveHelp.title}</span>
          <span class="door-body">{doors.giveHelp.body}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // The first photo loads with the page. The rest are hidden (so they don't
  // download) until the page has loaded, then the crossfade starts. Without
  // JavaScript, or with reduced motion, the first photo simply stays.
  const montage = document.querySelector<HTMLElement>("[data-montage]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (montage && !reduce) {
    const start = () => {
      montage.querySelectorAll<HTMLElement>(".slide-wrap[hidden]").forEach((el) => {
        el.hidden = false;
      });
      montage.classList.add("play");
    };
    if (document.readyState === "complete") setTimeout(start, 1200);
    else addEventListener("load", () => setTimeout(start, 1200), { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--night);
    color: #fff;
    /* Fill the first screen below the header on phones, no more. */
    /* Fill the first screen below the header on phones, no more. On a real
       iPhone Safari (URL bar plus toolbar) that screen is about 660px tall. */
    min-height: calc(100svh - 9.6rem);
    display: grid;
    align-items: end;
  }

  /* Photo montage: crossfading, darkened, blended into the night purple. */
  .montage {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .slide-wrap,
  .montage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide-wrap[hidden] {
    display: none;
  }

  .montage :global(img) {
    object-fit: cover;
    transform: scale(1.04);
  }

  /* Before the crossfade starts (and without JavaScript), the first photo shows. */
  .slide-wrap:first-child :global(img) {
    opacity: 1;
  }

  .montage.play .slide-wrap :global(img) {
    opacity: 0;
    animation: crossfade var(--cycle) infinite;
    /* Start 8% into the cycle so the first photo begins fully visible (no dip). */
    animation-delay: calc(var(--i) * (var(--cycle) / var(--slides)) - var(--cycle) * 0.08);
  }

  @keyframes crossfade {
    0% {
      opacity: 0;
    }
    8%,
    25% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  .veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgb(27 15 46 / 0.62) 0%,
        rgb(27 15 46 / 0.5) 30%,
        rgb(27 15 46 / 0.86) 55%,
        rgb(27 15 46 / 0.97) 75%,
        var(--night) 100%
      ),
      radial-gradient(120% 80% at 100% 0%, rgb(96 8 215 / 0.4), transparent 60%);
  }

  /* Brand tint: photos read as part of the purple world, not pasted on. */
  .montage :global(img) {
    filter: saturate(0.8) contrast(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .montage :global(img) {
      animation: none !important;
      transform: none;
    }
    .slide-wrap:first-child :global(img) {
      opacity: 1 !important;
    }
  }

  /* On phones the montage is positioned against the whole section. */
  .frame {
    position: static;
  }

  .content {
    display: grid;
    gap: 0.75rem;
    padding-block: clamp(5.5rem, 18vh, 14rem) var(--space-s);
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(2rem, 1.3rem + 3.4vw, 4rem);
    text-shadow: 0 2px 24px rgb(27 15 46 / 0.7);
  }

  .subhead {
    color: #e9e1fa;
    font-size: var(--step-0);
    line-height: 1.45;
    max-width: 34ch;
  }

  /* The two doors: the page's signature element. */
  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .door {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    min-height: 44px;
    padding: 0.9rem 1rem 1rem;
    border-radius: 20px;
    text-decoration: none;
    transition:
      transform 150ms ease,
      background-color 150ms ease;
  }

  .door:hover {
    transform: translateY(-2px);
  }

  .door--help {
    background: var(--crimson);
    color: #fff;
    box-shadow: 0 12px 40px rgb(186 1 12 / 0.35);
  }

  .door--help:hover {
    background: #950009;
  }

  .door--give {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.28);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .door--give:hover {
    background: rgb(255 255 255 / 0.2);
  }

  .door-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .door-body {
    font-size: 0.85rem;
    line-height: 1.35;
  }

  @media (max-width: 22.4rem) {
    .doors {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 40rem) {
    .door {
      padding: 1.4rem 1.5rem;
      gap: 0.4rem;
    }
    .door-title {
      font-size: var(--step-2);
    }
    .door-body {
      font-size: var(--step-0);
    }
  }

  /* Desktop: copy on the left, the montage becomes a tall framed panel on the
     right so the 720px photos are never stretched across the full width. */
  @media (min-width: 56rem) {
    .hero {
      min-height: 0;
      align-items: center;
      padding-block: var(--space-xl);
    }
    .frame {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-xl);
      align-items: center;
    }
    .content {
      padding-block: 0;
      gap: var(--space-m);
    }
    .content > * {
      grid-area: auto;
    }
    h1 {
      max-width: 15ch;
    }
    .doors {
      max-width: 40rem;
      margin-top: var(--space-s);
    }
    .montage {
      position: relative;
      inset: auto;
      z-index: 0;
      order: 2;
      aspect-ratio: 5 / 6;
      max-height: 34rem;
      align-self: center;
      border-radius: 28px;
      overflow: hidden;
      box-shadow:
        0 30px 80px rgb(0 0 0 / 0.45),
        0 0 0 1px rgb(255 255 255 / 0.12);
    }
    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: radial-gradient(70% 60% at 85% 50%, rgb(96 8 215 / 0.3), transparent 70%);
    }
    .veil {
      background: linear-gradient(180deg, rgb(27 15 46 / 0.08) 0%, rgb(27 15 46 / 0.55) 100%);
    }
  }
</style>
