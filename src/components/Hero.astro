---
import { Image } from "astro:assets";
import mark from "../assets/brand/logo-mark-night.png";
import { about, hero, org } from "../data/site";
import YouTubeLite from "./YouTubeLite.astro";

const { doors } = hero;
---

<!--
  The identity block. Her name and tagline in her logo's lettering, the heart
  and hands large, and "Help me" held in the palms. Then "I want to help".
-->
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <h1 id="hero-title" class="script name">
      {org.shortName}
    </h1>
    <p class="script together">
      <span>Together</span>
      <span class="we-can">
        we can.
        <svg class="underline" viewBox="0 0 220 14" aria-hidden="true" preserveAspectRatio="none">
          <path
            d="M4 9 C 60 2, 140 2, 216 8"
            fill="none"
            stroke="currentColor"
            stroke-width="4"
            stroke-linecap="round"
          />
        </svg>
      </span>
    </p>

    <div class="mark">
      <Image
        src={mark}
        alt=""
        width={640}
        densities={[1, 1.5, 2]}
        loading="eager"
        fetchpriority="high"
      />
      <a class="door door--help" href={doors.getHelp.href}>
        <span class="help-label">{doors.getHelp.title}</span>
        <span class="help-go" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16">
            <path
              d="M9 5l7 7-7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </span>
        <span class="visually-hidden">: {doors.getHelp.body}</span>
      </a>
    </div>

    <a class="door door--give" href={doors.giveHelp.href}>
      <span class="door-text">
        <span class="door-title">{doors.giveHelp.title}</span>
        <span class="door-body">{doors.giveHelp.body}</span>
      </span>
      <span class="door-go" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22">
          <path
            d="M9 5l7 7-7 7"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    </a>

    <!-- Her story, dead center: the video that shows what all of this is. -->
    <div class="film">
      <YouTubeLite video={about.video} />
    </div>

    <div class="copy">
      <h2>{hero.headline}</h2>
      <p class="subhead">{hero.subhead}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--night);
    color: #fff;
    padding-block: 1.1rem var(--space-xl);
    text-align: center;
  }

  /* The light behind everything: one glow up top, a faint crimson at the base. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 34% at 50% 38%, rgb(150 90 255 / 0.28), transparent 70%),
      radial-gradient(70% 45% at 100% 0%, rgb(96 8 215 / 0.4), transparent 65%),
      radial-gradient(60% 40% at 0% 100%, rgb(186 1 12 / 0.16), transparent 60%),
      linear-gradient(180deg, var(--night) 0%, #150b26 100%);
  }

  .script {
    font-family: var(--font-script);
    font-weight: 400;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .name {
    margin: 0;
    font-size: clamp(2.4rem, 1.2rem + 6vw, 4.5rem);
    line-height: 1.05;
    color: #fff;
    text-shadow: 0 2px 30px rgb(96 8 215 / 0.55);
  }

  .together {
    display: grid;
    justify-items: center;
    gap: 0;
    margin: 0.4rem auto 0;
    font-size: clamp(1.7rem, 0.9rem + 4vw, 3rem);
    line-height: 1.05;
    color: var(--night-soft);
    max-width: none;
  }

  .we-can {
    position: relative;
    display: inline-block;
    padding-bottom: 0.45rem;
  }

  .underline {
    position: absolute;
    left: -2%;
    bottom: 0;
    width: 104%;
    height: 0.34em;
    color: #ff5a63;
  }

  /* The heart and hands, holding the button. */
  .mark {
    position: relative;
    width: min(100%, 22.5rem);
    margin: -0.35rem auto 0;
    container-type: inline-size;
  }

  .mark::before {
    content: "";
    position: absolute;
    inset: 4% -8% -2%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(140 70 255 / 0.35),
      rgb(96 8 215 / 0.12) 62%,
      transparent 100%
    );
  }

  .mark :global(img) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 18px rgb(120 50 255 / 0.35)) drop-shadow(0 22px 30px rgb(0 0 0 / 0.45));
  }

  /*
    Help me sits in the open red space above the fingertips (about 36% down the
    heart, where the clear width is about half the heart). Sized in container
    units so it stays in that space at every mark size.
  */
  .door--help {
    position: absolute;
    left: 50%;
    top: 36%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3cqi;
    width: 50cqi;
    height: 15.5cqi;
    min-height: 44px;
    padding: 0 3cqi 0 5cqi;
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.22) 0%, rgb(255 255 255 / 0) 48%),
      linear-gradient(135deg, #ef2a37 0%, #c3000d 55%, #8a0008 100%);
    box-shadow:
      0 0 0 1.5px rgb(255 255 255 / 0.85),
      0 0 0 5px rgb(255 60 70 / 0.18),
      0 10px 26px rgb(90 0 6 / 0.55),
      0 0 34px rgb(255 50 62 / 0.45);
    animation: breathe 3.6s ease-in-out infinite;
    transition: transform 160ms ease;
  }

  .door--help:hover,
  .door--help:focus-visible {
    transform: translate(-50%, -50%) scale(1.04);
  }

  .door--help:active {
    transform: translate(-50%, -50%) scale(0.98);
  }

  @keyframes breathe {
    0%,
    100% {
      box-shadow:
        0 0 0 1.5px rgb(255 255 255 / 0.85),
        0 0 0 5px rgb(255 60 70 / 0.18),
        0 10px 26px rgb(90 0 6 / 0.55),
        0 0 34px rgb(255 50 62 / 0.45);
    }
    50% {
      box-shadow:
        0 0 0 1.5px rgb(255 255 255 / 0.95),
        0 0 0 8px rgb(255 60 70 / 0.12),
        0 10px 26px rgb(90 0 6 / 0.55),
        0 0 48px rgb(255 70 80 / 0.7);
    }
  }

  .help-label {
    font-family: var(--font-script);
    font-size: 8.4cqi;
    line-height: 1;
    padding-bottom: 0.08em;
    text-shadow: 0 1px 2px rgb(90 0 6 / 0.45);
  }

  .help-go {
    flex: none;
    display: grid;
    place-items: center;
    width: 8cqi;
    height: 8cqi;
    border-radius: 50%;
    background: #fff;
    color: #c3000d;
    box-shadow: 0 2px 6px rgb(90 0 6 / 0.35);
  }

  .help-go :global(svg) {
    width: 4.4cqi;
    height: 4.4cqi;
  }

  .door-go {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }

  /* I want to help: glass bar under the mark. */
  .door--give {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: min(100%, 26rem);
    min-height: 4.75rem;
    margin: 0.9rem auto 0;
    padding: 0.9rem 0.9rem 0.9rem 1.25rem;
    border-radius: 22px;
    background: rgb(255 255 255 / 0.09);
    color: #fff;
    text-align: left;
    text-decoration: none;
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    transition: background-color 150ms ease;
  }

  .door--give:hover {
    background: rgb(255 255 255 / 0.15);
  }

  .door--give::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.55),
      rgb(96 8 215 / 0.6) 45%,
      rgb(186 1 12 / 0.45)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .door-text {
    display: grid;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }

  .door--give .door-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .door-body {
    font-size: var(--step--1);
    line-height: 1.35;
  }

  .door--give .door-go {
    width: 2.75rem;
    height: 2.75rem;
    background: rgb(255 255 255 / 0.12);
  }

  .film {
    width: min(100%, 40rem);
    margin: var(--space-xl) auto 0;
    border-radius: 24px;
    box-shadow:
      0 30px 80px rgb(0 0 0 / 0.5),
      0 0 0 1px rgb(255 255 255 / 0.14);
  }

  .copy {
    display: grid;
    gap: 0.5rem;
    max-width: 34rem;
    margin: var(--space-l) auto 0;
  }

  .copy h2 {
    font-size: clamp(1.4rem, 1rem + 2vw, 2rem);
  }

  .subhead {
    margin: 0 auto;
    color: #d9cef2;
    font-size: var(--step-0);
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .door--help {
      animation: none;
    }
  }

  @media (min-width: 56rem) {
    .hero {
      padding-block: var(--space-xl);
    }
    .mark {
      width: 24rem;
    }
    .door--give {
      width: 30rem;
    }
  }
</style>
