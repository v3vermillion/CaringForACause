---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { hero, org } from "../data/site";
import Brand from "./Brand.astro";

const { doors } = hero;

// Her event photos, crossfading slowly behind the banner. Only the first one
// loads with the page; the others load after, then the crossfade starts.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const slides = hero.montage.map((photo, index) => {
  const match = files[`../assets/photos/${photo.file}`];
  if (!match) throw new Error(`Photo not found: src/assets/photos/${photo.file}`);
  return { ...photo, src: match.default, index };
});
const cycle = slides.length * 7;
---

<!--
  The banner: her photos, her lettering, one sentence, two doors.
  On desktop it fills the first screen (see src/pages/index.astro and docs/DESIGN.md).
-->
<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="montage" aria-hidden="true" data-montage style={`--cycle: ${cycle}s;`}>
    {slides.map((slide) => (
      <div class="slide" hidden={slide.index > 0} style={`--i: ${slide.index};`}>
        <Picture
          src={slide.src}
          formats={["avif", "webp"]}
          alt=""
          quality={62}
          widths={[480, 640, 720]}
          sizes="(min-width: 56rem) 62vw, 100vw"
          loading={slide.index === 0 ? "eager" : "lazy"}
          fetchpriority={slide.index === 0 ? "high" : "auto"}
          decoding="async"
          style={`object-position: ${slide.focus ?? "center"};`}
        />
      </div>
    ))}
  </div>
  <div class="scrim"></div>

  <div class="wrap">
    <div class="content">
      <Brand kind="lockup" class="wordmark" label={org.name} />
      <p class="tagline">{hero.tagline}</p>
      <h1 id="hero-title">{hero.headline}</h1>
      <p class="sub">{hero.subhead}</p>

      <div class="doors">
        <a class="door door--help" href={doors.getHelp.href}>
          <span class="door-title">{doors.getHelp.title}</span>
          <span class="door-body">{doors.getHelp.body}</span>
        </a>
        <a class="door door--give" href={doors.donate.href}>
          <span class="door-title">{doors.donate.title}</span>
          <span class="door-body">{doors.donate.body}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-montage]").forEach((montage) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const start = () => {
      montage.querySelectorAll<HTMLElement>(".slide[hidden]").forEach((el) => {
        el.hidden = false;
      });
      montage.classList.add("play");
    };
    if (document.readyState === "complete") setTimeout(start, 1500);
    else addEventListener("load", () => setTimeout(start, 1500), { once: true });
  });
</script>

<style>
  /*
    Phones and tablets: the same words, scaled by the screen width. Every size
    below is a multiple of --rp, one pixel of the 393px-wide phone reference;
    on tablets --rp is larger so the same column is 56% of the screen, with
    the photo beside it. Nothing here is sized by the screen height: on phones
    it changes as the address bar collapses. Desktop has its own block at the
    end.
  */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--night);
    padding-block: calc(24 * var(--rp)) calc(40 * var(--rp));
  }

  .montage {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: #2a1640;
  }

  .slide,
  .montage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide[hidden] {
    display: none;
  }

  .montage :global(img) {
    object-fit: cover;
    filter: saturate(0.85);
    transform: scale(1.02);
  }

  .slide:first-child :global(img) {
    opacity: 1;
  }

  .montage.play .slide :global(img) {
    opacity: 0;
    animation: crossfade var(--cycle) infinite;
    animation-delay: calc(var(--i) * (var(--cycle) / 4) - var(--cycle) * 0.08);
  }

  @keyframes crossfade {
    0% {
      opacity: 0;
    }
    8%,
    25% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  /* The veil. The words start at the top, so the top is veiled enough for her
     lettering and tagline to read over every photo. */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(27 15 46 / 0.5) 0%, rgb(27 15 46 / 0.65) 35%, #1b0f2e 78%),
      linear-gradient(90deg, rgb(27 15 46 / 0.35), transparent 60%);
  }

  .content {
    display: grid;
    gap: 0;
    max-width: calc(353.7 * var(--rp)); /* the reference column; stops with the scale */
  }

  /* Her lockup, as in the footer (decision 45): the script over "Supportive
     Services" in its lit lavender, with the footer's violet glow, over a
     dark shadow that keeps it clear of the photo behind. It fills the column
     on a phone. The tagline stands a little further off than the lines below
     it, so the lockup's capitals and her phrase read as two things. */
  .content :global(.wordmark) {
    width: 100%;
    filter: drop-shadow(0 0 calc(8 * var(--rp)) rgb(170 110 255 / 0.45))
      drop-shadow(0 6px 24px rgb(0 0 0 / 0.45));
  }

  .tagline {
    margin-top: calc(20 * var(--rp));
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(18 * var(--rp));
    color: var(--night-soft);
  }

  h1 {
    margin-top: calc(24 * var(--rp));
    font-size: calc(29.4 * var(--rp));
    line-height: 1.05;
    color: #fff;
  }

  .sub {
    margin-top: calc(12 * var(--rp));
    font-size: calc(18 * var(--rp));
    line-height: 1.5;
    color: #e3daf6;
  }

  /* Two doors, equal weight. Crimson is the signal; the other is glass. */
  .doors {
    display: grid;
    grid-auto-rows: 1fr; /* stacked or side by side, the doors stay the same size */
    gap: calc(12 * var(--rp));
    margin-top: calc(24 * var(--rp));
  }

  .door {
    position: relative;
    display: grid;
    align-content: center;
    gap: calc(3.2 * var(--rp));
    min-height: calc(84 * var(--rp));
    padding: calc(14.4 * var(--rp)) calc(48 * var(--rp)) calc(14.4 * var(--rp)) calc(20 * var(--rp));
    border-radius: calc(20 * var(--rp));
    color: #fff;
    text-decoration: none;
    transition:
      transform 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }

  .door::after {
    content: "";
    position: absolute;
    right: calc(17.6 * var(--rp));
    top: 50%;
    width: calc(11.2 * var(--rp));
    height: calc(11.2 * var(--rp));
    border-right: calc(3 * var(--rp)) solid currentColor;
    border-top: calc(3 * var(--rp)) solid currentColor;
    transform: translateY(-50%) rotate(45deg);
    transition: transform 150ms ease;
  }

  .door:hover {
    transform: translateY(-2px);
  }

  .door:hover::after {
    transform: translateY(-50%) translateX(3px) rotate(45deg);
  }

  .door-title {
    font-family: var(--font-display);
    font-size: calc(25.5 * var(--rp));
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .door-body {
    font-size: calc(14.4 * var(--rp));
    line-height: 1.35;
    opacity: 0.92;
  }

  .door--help {
    background: linear-gradient(135deg, #ef2f3a 0%, var(--signal) 45%, #a3000a 100%);
    box-shadow:
      0 14px 40px rgb(226 32 44 / 0.4),
      0 0 0 1px rgb(255 255 255 / 0.18) inset;
  }

  .door--help:hover {
    box-shadow:
      0 18px 48px rgb(226 32 44 / 0.5),
      0 0 0 1px rgb(255 255 255 / 0.25) inset;
  }

  .door--give {
    background: rgb(255 255 255 / 0.1);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.35) inset;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .door--give:hover {
    background: rgb(255 255 255 / 0.17);
  }

  /* Tablets in portrait: the phone's words, unchanged, in a column 56% of the
     screen (--rp does that), her photo on the right as on desktop, and the
     banner filling the first screen down to the season strip
     (src/pages/index.astro). The photo's edge and the veil are measured from
     the text column, as on desktop. */
  @media (min-width: 36rem) {
    .hero {
      --wrap-left: calc((100% - min(100% - 2 * var(--gutter), var(--wide))) / 2);
      display: grid;
      align-content: center;
    }
    .montage {
      left: calc(var(--wrap-left) + 134 * var(--rp));
    }
    .scrim {
      background:
        linear-gradient(
          90deg,
          #1b0f2e 0,
          #1b0f2e calc(var(--wrap-left) + 196 * var(--rp)),
          rgb(27 15 46 / 0.75) calc(var(--wrap-left) + 338 * var(--rp)),
          rgb(27 15 46 / 0.2) calc(var(--wrap-left) + 511 * var(--rp)),
          rgb(27 15 46 / 0.15) 100%
        ),
        linear-gradient(180deg, rgb(27 15 46 / 0.2) 0%, transparent 40%, rgb(27 15 46 / 0.85) 100%);
    }
  }

  @media (min-width: 56rem) {
    /* Desktop: one composition at every screen size. The banner fills the
       first screen (src/pages/index.astro), and every size in it is a multiple
       of --u, one pixel of the reference layout (a 1280 × 800 screen, where
       the banner is 589px tall). Taller screens scale it up, shorter ones
       down, so the picture is the same on every computer. The width bounds
       it too (a portrait screen such as an iPad Pro 12.9 upright is tall but
       narrow), so the text column never outgrows its 45% of the screen and
       the headline keeps its three lines. Below seven tenths the type would
       get too small, so the scale stops there and the season strip drops just
       under the fold instead. */
    .hero {
      --u: clamp(
        0.7px,
        min(calc((100vh - var(--top-chrome) - var(--strips-h)) / 589), calc(100vw / 1280)),
        2px
      );
      /* Where the text column starts: the .wrap's left edge. */
      --wrap-left: calc((100% - min(100% - 2 * var(--gutter), var(--wide))) / 2);
      display: grid;
      align-content: center;
      /* A few reference pixels of slack under the doors absorb font rounding
         differences between browsers, so the strip never slips under the fold. */
      padding-block: calc(40 * var(--u)) calc(36 * var(--u));
    }
    /* Her photos sit to the right of the words; night takes the left, and the
       veil hides the photo's edge. Both are measured from the text column so
       the words always sit on the same part of the veil. */
    .montage {
      left: calc(var(--wrap-left) + 218 * var(--u));
    }
    .scrim {
      background:
        linear-gradient(
          90deg,
          #1b0f2e 0,
          #1b0f2e calc(var(--wrap-left) + 320 * var(--u)),
          rgb(27 15 46 / 0.75) calc(var(--wrap-left) + 550 * var(--u)),
          rgb(27 15 46 / 0.2) calc(var(--wrap-left) + 832 * var(--u)),
          rgb(27 15 46 / 0.15) 100%
        ),
        linear-gradient(180deg, rgb(27 15 46 / 0.2) 0%, transparent 40%, rgb(27 15 46 / 0.85) 100%);
    }
    .content {
      max-width: calc(576 * var(--u));
    }
    .doors {
      grid-template-columns: 1fr 1fr;
    }
    .content :global(.wordmark) {
      width: min(100%, calc(512 * var(--u)));
      filter: drop-shadow(0 0 calc(8 * var(--u)) rgb(170 110 255 / 0.45))
        drop-shadow(0 6px 24px rgb(0 0 0 / 0.45));
    }
    .tagline {
      margin-top: calc(20 * var(--u));
      font-size: calc(18 * var(--u));
    }
    h1 {
      margin-top: calc(24 * var(--u));
      font-size: calc(50.5 * var(--u));
    }
    .sub {
      margin-top: calc(12 * var(--u));
      font-size: calc(18 * var(--u));
    }
    .doors {
      gap: calc(12 * var(--u));
      margin-top: calc(24 * var(--u));
    }
    .door {
      gap: calc(3.2 * var(--u));
      min-height: calc(84 * var(--u));
      padding: calc(14.4 * var(--u)) calc(48 * var(--u)) calc(14.4 * var(--u)) calc(20 * var(--u));
      border-radius: calc(20 * var(--u));
    }
    .door::after {
      right: calc(17.6 * var(--u));
      width: calc(11.2 * var(--u));
      height: calc(11.2 * var(--u));
      border-width: calc(3 * var(--u));
    }
    .door-title {
      font-size: calc(30.4 * var(--u));
    }
    .door-body {
      font-size: calc(14.4 * var(--u));
    }
  }
</style>
