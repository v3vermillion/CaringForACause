---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { hero } from "../data/site";
import Wave from "./Wave.astro";

const { doors } = hero;

// Her event photos, crossfading slowly behind the banner. Only the first one
// loads with the page; the others load after, then the crossfade starts.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const slides = hero.montage.map((photo, index) => {
  const match = files[`../assets/photos/${photo.file}`];
  if (!match) throw new Error(`Photo not found: src/assets/photos/${photo.file}`);
  return { ...photo, src: match.default, index };
});
const cycle = slides.length * 7;
---

<!--
  The banner, from the owner's reference (decision 51): her tagline as a small
  tracked line between two rules, the headline in the serif with its last
  line in lavender italic, one sentence, and the two doors as pills with a
  line under each, over her photos under the night veil. The wave ribbon at
  the bottom cuts the photo and lands on the night band below. Her lockup is
  in the header now. On desktop the banner fills the first screen (see
  src/pages/index.astro and docs/DESIGN.md).
-->
<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="montage" aria-hidden="true" data-montage style={`--cycle: ${cycle}s;`}>
    {slides.map((slide) => (
      <div class="slide" hidden={slide.index > 0} style={`--i: ${slide.index};`}>
        <Picture
          src={slide.src}
          formats={["avif", "webp"]}
          alt=""
          quality={62}
          widths={[480, 640, 720]}
          sizes="(min-width: 56rem) 78vw, (min-width: 36rem) 80vw, 100vw"
          loading={slide.index === 0 ? "eager" : "lazy"}
          fetchpriority={slide.index === 0 ? "high" : "auto"}
          decoding="async"
          style={`object-position: ${slide.focus ?? "center"};`}
        />
      </div>
    ))}
  </div>
  <div class="tint"></div>
  <div class="scrim"></div>

  <div class="wrap">
    <div class="content">
      <p class="tagline">{hero.tagline}</p>
      <h1 id="hero-title">
        <span class="lead">{hero.headline}</span>
        <span class="accent">{hero.headlineAccent}</span>
      </h1>
      <p class="sub">{hero.subhead}</p>

      <div class="doors">
        <a class="door door--help" href={doors.getHelp.href}>
          <span class="door-pill">
            <span class="door-title">{doors.getHelp.title}</span>
            <svg class="chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9 5 7 7-7 7"></path>
            </svg>
          </span>
          <span class="door-body">{doors.getHelp.body}</span>
        </a>
        <a class="door door--give" href={doors.donate.href}>
          <span class="door-pill">
            <span class="door-title">{doors.donate.title}</span>
            <svg class="chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9 5 7 7-7 7"></path>
            </svg>
          </span>
          <span class="door-body">{doors.donate.body}</span>
        </a>
      </div>
    </div>
  </div>

  <Wave kind="into-night" id="wa" class="hero-wave" />
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-montage]").forEach((montage) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const start = () => {
      montage.querySelectorAll<HTMLElement>(".slide[hidden]").forEach((el) => {
        el.hidden = false;
      });
      montage.classList.add("play");
    };
    if (document.readyState === "complete") setTimeout(start, 1500);
    else addEventListener("load", () => setTimeout(start, 1500), { once: true });
  });
</script>

<style>
  /*
    Phones and tablets: the same words, scaled by the screen width. Every size
    below is a multiple of --rp, one pixel of the 393px-wide phone reference;
    on tablets --rp is larger so the same column is 56% of the screen, with
    the photo beside it. Nothing here is sized by the screen height: on phones
    it changes as the address bar collapses. Desktop has its own block at the
    end.

    On a phone the photo shows in a band above the words (96 reference px),
    then the words and the doors, then the wave; the whole banner fits an
    iPhone 12 mini's Safari screen (a test checks).
  */
  .hero {
    --wave-h: calc(84 * var(--rp));
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--night);
    /* The bottom padding clears the wave's ribbons where they sit highest,
       at the left edge (26% of the wave's height from its top), plus a gap. */
    padding-block: calc(96 * var(--rp)) calc(16 * var(--rp) + var(--wave-h) * 0.74);
  }

  .montage {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: #2a1640;
  }

  .slide,
  .montage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide[hidden] {
    display: none;
  }

  .montage :global(img) {
    object-fit: cover;
    filter: saturate(0.85);
    transform: scale(1.02);
  }

  .slide:first-child :global(img) {
    opacity: 1;
  }

  /* Each photo drifts a little larger while it shows, so the crossfade
     breathes; the drift begins where the still photo sat (1.02 at the 8%
     mark), so the first photo does not jump when the cycle starts. */
  .montage.play .slide :global(img) {
    opacity: 0;
    animation:
      crossfade var(--cycle) infinite,
      drift var(--cycle) linear infinite;
    animation-delay: calc(var(--i) * (var(--cycle) / 4) - var(--cycle) * 0.08);
  }

  @keyframes crossfade {
    0% {
      opacity: 0;
    }
    8%,
    25% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  @keyframes drift {
    0% {
      transform: scale(1);
    }
    33% {
      transform: scale(1.085);
    }
    33.01%,
    100% {
      transform: scale(1);
    }
  }

  /* A violet grade over the photo, multiplied in, so its shadows go violet
     and it belongs to the night as the reference's photo does. */
  .tint {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #7a3ae0;
    mix-blend-mode: multiply;
    opacity: 0.3;
  }

  /* The veil. On a phone the photo shows through the band above the words;
     by the row the eyebrow sits on (about 17% down) it is night at four
     fifths, so every line of text reads over it whichever photo is behind
     (the eyebrow's lavender measured under 4.5:1 over the lightest photo
     before). The wave takes over at the bottom, so the veil never reaches
     solid night and the photo is still there above the ribbon. */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        180deg,
        rgb(27 15 46 / 0.16) 0%,
        rgb(27 15 46 / 0.3) 10%,
        rgb(27 15 46 / 0.8) 17%,
        rgb(27 15 46 / 0.86) 45%,
        rgb(27 15 46 / 0.82) 100%
      ),
      linear-gradient(90deg, rgb(27 15 46 / 0.3), transparent 60%);
  }

  .content {
    display: grid;
    gap: 0;
    max-width: calc(353.7 * var(--rp)); /* the reference column; stops with the scale */
  }

  /* Her tagline as the eyebrow: small tracked capitals between two short
     rules, as the reference sets it. The text stays sentence case in the
     document and is set in capitals here. */
  .tagline {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--rp));
    max-width: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(13 * var(--rp));
    line-height: calc(16 * var(--rp));
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #d4c6f8;
    text-shadow: 0 max(1px, calc(1 * var(--rp))) calc(12 * var(--rp)) rgb(27 15 46 / 0.7);
  }

  .tagline::before,
  .tagline::after {
    content: "";
    flex: none;
    width: calc(36 * var(--rp));
    height: max(1px, calc(1 * var(--rp)));
    background: rgb(212 198 248 / 0.75);
  }

  /* The tracking is added after the last letter too; take it back so the
     two rules stand the same distance from the words. */
  .tagline::after {
    margin-left: -0.22em;
  }

  /* The headline in the serif: the lead in white, the last line in lavender
     italic, each its own block so the accent always starts a line. Greedy
     wrapping (not balance) keeps the reference's breaks. */
  h1 {
    margin-top: calc(14 * var(--rp));
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: calc(33 * var(--rp));
    line-height: 1.08;
    letter-spacing: -0.012em;
    text-wrap: wrap;
    color: #fff;
    text-shadow: 0 max(1px, calc(2 * var(--rp))) calc(24 * var(--rp)) rgb(27 15 46 / 0.55);
  }

  h1 .lead,
  h1 .accent {
    display: block;
  }

  /* The lead breaks after "Holiday meals," on every screen: "Holiday meals,
     gifts," is 9.9em wide in the serif and "gifts, and diapers" 8.4em, so a
     9.2em limit lands between them with room for another engine's metrics.
     The accent's second line ("for Central Indiana", 9.1em) fits the column. */
  h1 .lead {
    max-width: 9.2em;
  }

  h1 .accent {
    font-style: italic;
    color: #c9b0ff;
  }

  /* Two lines, breaking before "financial": the first line is 13em wide and
     the sentence up to "financial" 17em. */
  .sub {
    margin-top: calc(12 * var(--rp));
    max-width: 15em;
    font-size: calc(18 * var(--rp));
    line-height: 1.45;
    color: #ece4fb;
    text-shadow: 0 max(1px, calc(1 * var(--rp))) calc(14 * var(--rp)) rgb(27 15 46 / 0.6);
  }

  /* Two doors, equal, side by side: a pill and one line under it. Crimson is
     the signal; the other is an outlined pill. The whole door is the link, so
     the line under the pill is part of the tap target too, and the door is
     never shorter than 44px; the pill itself carries no floor, so it scales
     with the class like everything else (a floor on it changed the
     composition on short laptops). */
  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 1fr; /* the doors stay the same size whatever their lines */
    gap: calc(12 * var(--rp));
    margin-top: calc(20 * var(--rp));
  }

  .door {
    display: grid;
    align-content: start;
    gap: calc(8 * var(--rp));
    min-width: 0;
    color: #fff;
    text-decoration: none;
  }

  /* The label sits to the left with the chevron after it, as the reference
     sets it, so the pills range with the lines above and below them. */
  .door-pill {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: calc(8 * var(--rp));
    min-height: calc(50 * var(--rp));
    padding: 0 calc(14 * var(--rp)) 0 calc(24 * var(--rp));
    border-radius: var(--r-pill);
    font-family: var(--font-display);
    font-size: calc(18 * var(--rp));
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    transition:
      transform 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }

  .door-title {
    position: relative;
    top: calc(-0.5 * var(--rp));
  }

  .chev {
    flex: none;
    width: 1.2em;
    height: 1.2em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 150ms ease;
  }

  .door:hover .door-pill {
    transform: translateY(-2px);
  }

  .door:hover .chev {
    transform: translateX(3px);
  }

  /* The line under each pill balances its lines, so neither door ends in a
     word on its own. */
  .door-body {
    font-size: calc(15 * var(--rp));
    line-height: 1.4;
    text-wrap: balance;
    color: #e6ddf8;
    text-shadow: 0 max(1px, calc(1 * var(--rp))) calc(12 * var(--rp)) rgb(27 15 46 / 0.6);
  }

  /* The signal: a glossy crimson pill, lit along its top rim, with its glow.
     The sheen is thin and the gradient starts at the signal itself, so the
     white label reads at 4.5:1 on every part of the pill. */
  .door--help .door-pill {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0) 30%),
      linear-gradient(135deg, var(--signal) 0%, #d1141f 55%, #a80c17 100%);
    box-shadow:
      0 0 0 max(1px, calc(1 * var(--rp))) rgb(255 255 255 / 0.22) inset,
      0 calc(10 * var(--rp)) calc(30 * var(--rp)) rgb(226 32 44 / 0.42),
      0 calc(2 * var(--rp)) calc(6 * var(--rp)) rgb(120 0 10 / 0.35);
  }

  .door--help:hover .door-pill {
    box-shadow:
      0 0 0 max(1px, calc(1 * var(--rp))) rgb(255 255 255 / 0.3) inset,
      0 calc(14 * var(--rp)) calc(36 * var(--rp)) rgb(226 32 44 / 0.55),
      0 calc(2 * var(--rp)) calc(6 * var(--rp)) rgb(120 0 10 / 0.35);
  }

  /* The other door: a pale ring on the night, a whisper of glass. */
  .door--give .door-pill {
    background: rgb(255 255 255 / 0.06);
    box-shadow:
      0 0 0 max(1px, calc(1.5 * var(--rp))) rgb(226 214 255 / 0.85) inset,
      0 0 calc(18 * var(--rp)) rgb(170 110 255 / 0.2);
    -webkit-backdrop-filter: blur(calc(10 * var(--rp)));
    backdrop-filter: blur(calc(10 * var(--rp)));
  }

  .door--give:hover .door-pill {
    background: rgb(255 255 255 / 0.14);
    box-shadow:
      0 0 0 max(1px, calc(1.5 * var(--rp))) #fff inset,
      0 0 calc(22 * var(--rp)) rgb(170 110 255 / 0.35);
  }

  /* The wave at the foot of the banner: it cuts the photo and lands on the
     night band below (its night is the band's night, so the seam is
     invisible). Sized in the class's reference pixel like everything else. */
  .hero :global(.hero-wave) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    height: var(--wave-h);
  }

  .wrap {
    position: relative;
    z-index: 1;
  }

  /* Tablets in portrait: the phone's words, unchanged, in a column 56% of the
     screen (--rp does that), her photo on the right as on desktop, and the
     banner filling the first screen down to the season strip
     (src/pages/index.astro). The photo's edge and the veil are measured from
     the text column, as on desktop. No band above the words: the photo is
     beside them. */
  @media (min-width: 36rem) {
    .hero {
      --wrap-left: calc((100% - min(100% - 2 * var(--gutter), var(--wide))) / 2);
      display: grid;
      align-content: center;
      padding-block: calc(36 * var(--rp)) calc(16 * var(--rp) + var(--wave-h) * 0.74);
    }
    .montage {
      left: calc(var(--wrap-left) + 134 * var(--rp));
    }
    .scrim {
      background:
        linear-gradient(
          90deg,
          #1b0f2e 0,
          #1b0f2e calc(var(--wrap-left) + 196 * var(--rp)),
          rgb(27 15 46 / 0.78) calc(var(--wrap-left) + 338 * var(--rp)),
          rgb(27 15 46 / 0.22) calc(var(--wrap-left) + 511 * var(--rp)),
          rgb(27 15 46 / 0.12) 100%
        ),
        linear-gradient(
          180deg,
          rgb(27 15 46 / 0.22) 0%,
          transparent 35%,
          rgb(27 15 46 / 0.5) 80%,
          rgb(27 15 46 / 0.62) 100%
        );
    }
  }

  @media (min-width: 56rem) {
    /* Desktop: one composition at every screen size. The banner fills the
       first screen (src/pages/index.astro), and every size in it is a multiple
       of --u, one pixel of the reference layout (a 1280 × 800 screen, where
       the banner is 577px tall). Taller screens scale it up, shorter ones
       down, so the picture is the same on every computer. The width bounds
       it too (a portrait screen such as an iPad Pro 12.9 upright is tall but
       narrow), so the text column never outgrows its 45% of the screen and
       the headline keeps its four lines. Below seven tenths the type would
       get too small, so the scale stops there and the season strip drops just
       under the fold instead; above 1.25 (a 1600px screen) it stops with the
       rest of the site (decision 53), and the photo fills the room left. */
    .hero {
      --u: clamp(
        0.7px,
        min(
          calc((var(--first-screen-vh, 100vh) - var(--top-chrome) - var(--strips-h)) / 577),
          calc(100vw / 1280)
        ),
        1.25px
      );
      --wave-h: calc(92 * var(--u));
      /* Where the text column starts: the .wrap's left edge. */
      --wrap-left: calc((100% - min(100% - 2 * var(--gutter), var(--wide))) / 2);
      display: grid;
      align-content: center;
      /* A few reference pixels of slack under the doors absorb font rounding
         differences between browsers, so the strip never slips under the fold. */
      padding-block: calc(36 * var(--u)) calc(16 * var(--u) + var(--wave-h) * 0.74);
    }
    /* Her photos sit to the right of the words; night takes the left, and the
       veil hides the photo's edge. Both are measured from the text column so
       the words always sit on the same part of the veil. */
    .montage {
      left: calc(var(--wrap-left) + 218 * var(--u));
    }
    .scrim {
      background:
        linear-gradient(
          90deg,
          #1b0f2e 0,
          #1b0f2e calc(var(--wrap-left) + 320 * var(--u)),
          rgb(27 15 46 / 0.78) calc(var(--wrap-left) + 550 * var(--u)),
          rgb(27 15 46 / 0.2) calc(var(--wrap-left) + 832 * var(--u)),
          rgb(27 15 46 / 0.12) 100%
        ),
        linear-gradient(
          180deg,
          rgb(27 15 46 / 0.22) 0%,
          transparent 35%,
          rgb(27 15 46 / 0.5) 80%,
          rgb(27 15 46 / 0.62) 100%
        );
    }
    .content {
      max-width: calc(576 * var(--u));
    }
    .tagline {
      gap: calc(14 * var(--u));
      font-size: calc(13 * var(--u));
      line-height: calc(16 * var(--u));
      text-shadow: 0 max(1px, calc(1 * var(--u))) calc(12 * var(--u)) rgb(27 15 46 / 0.7);
    }
    .tagline::before,
    .tagline::after {
      width: calc(44 * var(--u));
      height: max(1px, calc(1 * var(--u)));
    }
    h1 {
      margin-top: calc(14 * var(--u));
      font-size: calc(52 * var(--u));
      line-height: 1.05;
      text-shadow: 0 max(1px, calc(2 * var(--u))) calc(24 * var(--u)) rgb(27 15 46 / 0.55);
    }
    .sub {
      margin-top: calc(14 * var(--u));
      font-size: calc(19 * var(--u));
      text-shadow: 0 max(1px, calc(1 * var(--u))) calc(14 * var(--u)) rgb(27 15 46 / 0.6);
    }
    .doors {
      gap: calc(16 * var(--u));
      margin-top: calc(24 * var(--u));
    }
    .door {
      gap: calc(10 * var(--u));
    }
    .door-pill {
      gap: calc(8 * var(--u));
      min-height: calc(54 * var(--u));
      padding: 0 calc(16 * var(--u)) 0 calc(28 * var(--u));
      font-size: calc(20 * var(--u));
    }
    .door-title {
      top: calc(-0.5 * var(--u));
    }
    .door-body {
      font-size: calc(15 * var(--u));
      text-shadow: 0 max(1px, calc(1 * var(--u))) calc(12 * var(--u)) rgb(27 15 46 / 0.6);
    }
    .door--give .door-pill {
      -webkit-backdrop-filter: blur(calc(10 * var(--u)));
      backdrop-filter: blur(calc(10 * var(--u)));
    }
    .door--help .door-pill {
      box-shadow:
        0 0 0 max(1px, calc(1 * var(--u))) rgb(255 255 255 / 0.22) inset,
        0 calc(10 * var(--u)) calc(30 * var(--u)) rgb(226 32 44 / 0.42),
        0 calc(2 * var(--u)) calc(6 * var(--u)) rgb(120 0 10 / 0.35);
    }
    .door--help:hover .door-pill {
      box-shadow:
        0 0 0 max(1px, calc(1 * var(--u))) rgb(255 255 255 / 0.3) inset,
        0 calc(14 * var(--u)) calc(36 * var(--u)) rgb(226 32 44 / 0.55),
        0 calc(2 * var(--u)) calc(6 * var(--u)) rgb(120 0 10 / 0.35);
    }
    .door--give .door-pill {
      box-shadow:
        0 0 0 max(1px, calc(1.5 * var(--u))) rgb(226 214 255 / 0.85) inset,
        0 0 calc(18 * var(--u)) rgb(170 110 255 / 0.2);
    }
    .door--give:hover .door-pill {
      box-shadow:
        0 0 0 max(1px, calc(1.5 * var(--u))) #fff inset,
        0 0 calc(22 * var(--u)) rgb(170 110 255 / 0.35);
    }
  }

  /* As the banner scrolls away, her photo moves at three quarters of the
     page's speed (a scroll-driven animation, so the main thread never runs
     it): at the top of the page nothing is moved, so the first screen is
     what it is; browsers without the timeline show the photo still. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .montage {
        animation: hero-parallax linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes hero-parallax {
    to {
      transform: translateY(24%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .montage :global(img) {
      animation: none;
    }
  }
</style>
