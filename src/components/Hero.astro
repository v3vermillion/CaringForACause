---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { hero } from "../data/site";
import Brand from "./Brand.astro";

const { doors } = hero;

// Her event photos, crossfading slowly behind the banner. Only the first one
// loads with the page; the others load after, then the crossfade starts.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const slides = hero.montage.map((photo, index) => {
  const match = files[`../assets/photos/${photo.file}`];
  if (!match) throw new Error(`Photo not found: src/assets/photos/${photo.file}`);
  return { ...photo, src: match.default, index };
});
const cycle = slides.length * 7;
---

<!--
  The banner: her photos, her lettering, one sentence, two doors.
  Nothing here is sized with viewport-height units (see docs/DESIGN.md).
-->
<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="montage" aria-hidden="true" data-montage style={`--cycle: ${cycle}s;`}>
    {slides.map((slide) => (
      <div class="slide" hidden={slide.index > 0} style={`--i: ${slide.index};`}>
        <Picture
          src={slide.src}
          formats={["avif", "webp"]}
          alt=""
          quality={62}
          widths={[480, 640, 720]}
          sizes="(min-width: 56rem) 62vw, 100vw"
          loading={slide.index === 0 ? "eager" : "lazy"}
          fetchpriority={slide.index === 0 ? "high" : "auto"}
          decoding="async"
          style={`object-position: ${slide.focus ?? "center"};`}
        />
      </div>
    ))}
  </div>
  <div class="scrim"></div>

  <div class="wrap">
    <div class="content">
      <Brand kind="wordmark" class="wordmark" />
      <p class="tagline">{hero.tagline}</p>
      <h1 id="hero-title">{hero.headline}</h1>
      <p class="sub">{hero.subhead}</p>

      <div class="doors">
        <a class="door door--help" href={doors.getHelp.href}>
          <span class="door-title">{doors.getHelp.title}</span>
          <span class="door-body">{doors.getHelp.body}</span>
        </a>
        <a class="door door--give" href={doors.donate.href}>
          <span class="door-title">{doors.donate.title}</span>
          <span class="door-body">{doors.donate.body}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-montage]").forEach((montage) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const start = () => {
      montage.querySelectorAll<HTMLElement>(".slide[hidden]").forEach((el) => {
        el.hidden = false;
      });
      montage.classList.add("play");
    };
    if (document.readyState === "complete") setTimeout(start, 1500);
    else addEventListener("load", () => setTimeout(start, 1500), { once: true });
  });
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--night);
    padding-block: clamp(8rem, 6rem + 9vw, 14rem) var(--space-l);
  }

  .montage {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: #2a1640;
  }

  .slide,
  .montage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide[hidden] {
    display: none;
  }

  .montage :global(img) {
    object-fit: cover;
    filter: saturate(0.85);
    transform: scale(1.02);
  }

  .slide:first-child :global(img) {
    opacity: 1;
  }

  .montage.play .slide :global(img) {
    opacity: 0;
    animation: crossfade var(--cycle) infinite;
    animation-delay: calc(var(--i) * (var(--cycle) / 4) - var(--cycle) * 0.08);
  }

  @keyframes crossfade {
    0% {
      opacity: 0;
    }
    8%,
    25% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  /* The veil: photos stay bright at the top, the words sit on night at the bottom. */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(27 15 46 / 0.35) 0%, rgb(27 15 46 / 0.55) 35%, #1b0f2e 78%),
      linear-gradient(90deg, rgb(27 15 46 / 0.35), transparent 60%);
  }

  .content {
    display: grid;
    gap: 0;
    max-width: 38rem;
  }

  .content :global(.wordmark) {
    width: min(100%, 30rem);
    color: #fff;
    filter: drop-shadow(0 6px 24px rgb(0 0 0 / 0.45));
  }

  .tagline {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--night-soft);
  }

  h1 {
    margin-top: var(--space-m);
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 3.1rem);
    line-height: 1.05;
    color: #fff;
  }

  .sub {
    margin-top: 0.75rem;
    font-size: var(--step-0);
    line-height: 1.5;
    color: #e3daf6;
  }

  /* Two doors, equal weight. Crimson is the signal; the other is glass. */
  .doors {
    display: grid;
    grid-auto-rows: 1fr; /* stacked or side by side, the doors stay the same size */
    gap: 0.75rem;
    margin-top: var(--space-m);
  }

  .door {
    position: relative;
    display: grid;
    align-content: center;
    gap: 0.2rem;
    min-height: 5.25rem;
    padding: 0.9rem 3rem 0.9rem 1.25rem;
    border-radius: var(--r-card);
    color: #fff;
    text-decoration: none;
    transition:
      transform 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }

  .door::after {
    content: "";
    position: absolute;
    right: 1.1rem;
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border-right: 3px solid currentColor;
    border-top: 3px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
    transition: transform 150ms ease;
  }

  .door:hover {
    transform: translateY(-2px);
  }

  .door:hover::after {
    transform: translateY(-50%) translateX(3px) rotate(45deg);
  }

  .door-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .door-body {
    font-size: var(--step--1);
    line-height: 1.35;
    opacity: 0.92;
  }

  .door--help {
    background: linear-gradient(135deg, #ef2f3a 0%, var(--signal) 45%, #a3000a 100%);
    box-shadow:
      0 14px 40px rgb(226 32 44 / 0.4),
      0 0 0 1px rgb(255 255 255 / 0.18) inset;
  }

  .door--help:hover {
    box-shadow:
      0 18px 48px rgb(226 32 44 / 0.5),
      0 0 0 1px rgb(255 255 255 / 0.25) inset;
  }

  .door--give {
    background: rgb(255 255 255 / 0.1);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.35) inset;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .door--give:hover {
    background: rgb(255 255 255 / 0.17);
  }

  @media (min-width: 36rem) {
    .doors {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 56rem) {
    .hero {
      padding-block: clamp(6rem, 3rem + 6vw, 8rem) var(--space-xl);
      min-height: 40rem;
      display: grid;
      align-items: center;
    }
    /* Her photos sit on the right at close to their native size; night takes the
       left, and the veil hides the photo's edge. */
    .montage {
      left: 22%;
    }
    .scrim {
      background:
        linear-gradient(
          90deg,
          #1b0f2e 0%,
          #1b0f2e 30%,
          rgb(27 15 46 / 0.75) 48%,
          rgb(27 15 46 / 0.2) 70%,
          rgb(27 15 46 / 0.15) 100%
        ),
        linear-gradient(180deg, rgb(27 15 46 / 0.2) 0%, transparent 40%, rgb(27 15 46 / 0.85) 100%);
    }
    .content {
      max-width: 36rem;
    }
    .content :global(.wordmark) {
      width: min(100%, 32rem);
    }
    h1 {
      font-size: clamp(2.2rem, 1.4rem + 2.2vw, 3.2rem);
    }
  }
</style>
