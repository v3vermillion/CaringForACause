---
import { show } from "../data/facts.ts";
import { facts, getHelp, links, org, programs } from "../data/site";
import Brand from "./Brand.astro";
import Photo from "./Photo.astro";
import ProgramIcon from "./ProgramIcon.astro";
import Wave from "./Wave.astro";
import YouTubeLite from "./YouTubeLite.astro";

const active = programs.filter((p) => p.active);
const phone = show(facts.phone);
const applyEmail = `mailto:${show(facts.email)}?subject=${encodeURIComponent("Application request")}`;
const applyHref = links.familyApplication ?? getHelp.action.href;
---

<section id="programs" class="section ground" aria-labelledby="programs-title">
  <!-- The wave lifts the night band off the page: night above, paper below. -->
  <!-- Night-2 above the ribbons, as the band ends; below them this section's
       own ground shows through (decision 67). -->
  <Wave kind="into-paper" id="wb" above="var(--night-2)" below="none" class="wave-in" />
  <div class="wrap">
    <!-- Her mark as a faint watermark beside the opener, as the reference
         draws it: her flat mark in one lavender tone, nothing redrawn. -->
    <Brand kind="mark" class="watermark" label="" />
    <header class="intro">
      <span class="eyebrow">Our programs</span>
      <h2 id="programs-title">What we do, all year</h2>
      <p class="lede">{org.mission}</p>
    </header>

    <!-- Jump tiles: one per program, so the whole offering fits one glance. -->
    <nav class="tiles" aria-label="Jump to a program">
      <ul>
        {active.map((program) => (
          <li>
            <a class="tile surface" href={`#${program.slug}`}>
              {program.photo ? (
                <Photo
                  photo={program.photo}
                  ratio="1 / 1"
                  sizes="72px"
                  widths={[144, 216]}
                  class="tile-photo"
                />
              ) : (
                program.icon && (
                  <span class="tile-photo tile-icon" aria-hidden="true">
                    <ProgramIcon kind={program.icon} />
                  </span>
                )
              )}
              <span class="tile-text">
                <span class="tile-name">{program.name}</span>
                <span class="tile-label">{program.label}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Get help: the one dark card on the page, so families can't miss it. -->
    <div id="get-help" class="get-help surface surface--night on-dark">
      <div class="stack">
        <h3>{getHelp.heading}</h3>
        <p>{getHelp.whoCanApply}</p>
        <p>{getHelp.howToApply}</p>
      </div>
      <div class="actions">
        <a class="button button--signal" href={applyHref}>
          {getHelp.action.label}
        </a>
        <a class="button button--glass" href={phone.href}>
          Call {phone.display}
        </a>
        <a class="arrow-link" href={applyEmail}>
          Email us
        </a>
      </div>
    </div>

    <div class="list">
      {active.map((program, i) => (
        <article
          id={program.slug}
          class:list={[
            "row",
            "surface",
            { "has-media": program.photo || program.video || program.icon },
          ]}
        >
          <div class="stack copy">
            <span class="index" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <span class="eyebrow">{program.label}</span>
              <h3>{program.name}</h3>
            </div>
            <p class="summary">{program.summary}</p>
            <p class="for">
              <span class="for-label">Who it's for</span>
              <span class="for-text">{program.forWhom}</span>
            </p>
            {program.details && (
              <ul class="details">
                {program.details.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            )}
            <!-- The row's one next step closes the copy under a short lit
                 rule, as the eyebrow opens it over one (decision 68). -->
            {(program.link || program.checklist) && (
              <div class="step">
                {program.link && (
                  <p class="next">
                    <a class="arrow-link" href={program.link.href}>
                      {program.link.label}
                    </a>
                  </p>
                )}
                {program.checklist && (
                  <details class="checklist">
                    <summary>
                      <span class="disc" aria-hidden="true" />
                      <span>{program.checklist.title}</span>
                    </summary>
                    <div class="groups">
                      {program.checklist.groups.map((group) => (
                        <div>
                          <h4>{group.heading}</h4>
                          <ul>
                            {group.items.map((item) => (
                              <li>{item}</li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </details>
                )}
              </div>
            )}
          </div>
          {program.video ? (
            <div class:list={["media", "plate", { "plate--left": i % 2 === 1 }]}>
              <YouTubeLite video={program.video} />
            </div>
          ) : program.photo ? (
            <div class:list={["media", "plate", { "plate--left": i % 2 === 1 }]}>
              {/* Row 01's phone crop is 4:3 on purpose: the taller frame
                    keeps all three children's faces, where 3:2 trimmed
                    them. Tablets up recrop square anyway. */}
              <Photo
                photo={program.photo}
                ratio={`var(--photo-ratio, ${i === 0 ? "4 / 3" : "3 / 2"})`}
                sizes="(min-width: 56rem) 480px, (min-width: 36rem) 40vw, calc(100vw - 2.5rem)"
              />
            </div>
          ) : (
            program.icon && (
              <div class:list={["media", "plate", { "plate--left": i % 2 === 1 }]}>
                {/* No photo of this program yet: its strip icon, large, on the
                      night, in the same frame and plate as the photos, so the
                      zigzag holds (decision 90). */}
                <div class="icon-panel" aria-hidden="true">
                  <ProgramIcon kind={program.icon} />
                </div>
              </div>
            )
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* The section starts under the wave from the night band (--wave-h), so its
     top padding is the wave plus the usual section space. */
  #programs {
    /* A link to the section lands on its words, not on the wave that opens
       it: the wave scrolls under the bar (its box's foot a few pixels above
       the bar's edge) and the paper starts there, with the eyebrow a section
       space below (decision 71). */
    scroll-margin-top: calc(var(--header-h) - var(--scroll-pad) - var(--wave-h) - 0.25rem);
    position: relative;
    /* The watermark bleeds past the column; clipped (not hidden) so the
       section is not a scroll container with the watermark's width of
       hidden overflow (see the banner, and its note on the fallback). */
    overflow: hidden;
    /* The space above the opener is measured from the wave's box, so that a
       link landing with the wave under the bar still finds the opener a
       section space below it (decision 71; decision 53 had measured it from
       the ribbons' foot). */
    padding-top: calc(var(--wave-h) + var(--space-l));
    /* The Get involved wedge cuts --wedge into this section's foot, so the
       foot carries it: its high corner sits a full section space under the
       last row. */
    padding-bottom: calc(var(--space-xl) + var(--wedge));
  }

  @supports (overflow: clip) {
    #programs {
      overflow: clip;
    }
  }

  #programs > .wrap {
    position: relative;
  }

  /* Placed from the column's edge in rem, so it sits at the same place on
     every device of a class. */
  /* Sized to the opener and faded at its foot, so it sits behind the
     eyebrow and the heading and dissolves before the tiles. */
  #programs :global(.watermark) {
    position: absolute;
    top: -1.5rem;
    right: -2rem;
    width: 15rem;
    opacity: 0.06;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 40%, transparent 90%);
    mask-image: linear-gradient(180deg, #000 40%, transparent 90%);
  }

  #programs :global(.watermark path) {
    fill: var(--purple);
  }

  #programs :global(.wave-in) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--wave-h);
  }

  .intro {
    /* One head-to-content distance across the sections (--space-l), less
       the tile scroller's own 0.25rem of slack. */
    margin-bottom: calc(var(--space-l) - 0.25rem);
  }

  .intro .lede {
    margin-top: var(--space-s);
  }

  /* Tiles: a scroll strip on phones and tablets, a four-up grid on desktop.
     The strip bleeds into the gutters and fades at both edges, so a cut tile
     dissolves instead of chopping; at rest the tiles start where the fade
     ends, so nothing at rest is dimmed. */
  /* The strip scrolls sideways, which makes it clip vertically too, and a
     tile's shadow cut at the strip's edge drew a line across the page
     under the tiles (decision 67). The strip's box reaches 2rem above and
     3rem below the tiles (past the farthest shadow), with margins that
     take all but the 0.25rem and 0.75rem it always kept back, so the
     tiles sit where they did and the shadows fall whole. */
  .tiles ul {
    display: flex;
    gap: var(--space-xs);
    padding: 2rem var(--gutter) 3rem;
    margin: -1.75rem calc(-1 * var(--gutter)) -2.25rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--gutter),
      #000 calc(100% - var(--gutter)),
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--gutter),
      #000 calc(100% - var(--gutter)),
      transparent
    );
  }

  .tiles ul::-webkit-scrollbar {
    display: none;
  }

  .tiles li {
    flex: 0 0 min(78%, 17rem);
    scroll-snap-align: start;
  }

  /* A surface (global.css): lifted, with a rim of light; the tile's own
     shadow is lighter than a panel's, and the rim goes purple on hover. */
  .tile {
    display: flex;
    align-items: flex-start; /* the names share a line across the row */
    gap: 0.85rem;
    height: 100%;
    min-height: max(44px, 2.75rem);
    padding: 0.75rem;
    box-shadow:
      0 0.75rem 2rem rgb(27 15 46 / 0.06),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  /* The hover rim stays in the rule language at full strength — the same
     violet-rose gesture as the eyebrow rules, not a flat field border. */
  @media (hover: hover) {
    .tile:hover::before {
      background: linear-gradient(135deg, var(--purple), #d43a92);
    }
  }

  @media (hover: hover) {
    .tile:hover {
      box-shadow:
        0 1rem 2.5rem rgb(27 15 46 / 0.1),
        inset 0 1px 0 rgb(255 255 255 / 0.9);
      transform: translateY(-2px);
    }
  }

  /* Pressed, the tile settles to a tight contact shadow and keeps its
     surface light, instead of its whole finish vanishing for the press. */
  .tile:active {
    transform: translateY(0);
    box-shadow:
      0 0.25rem 0.75rem rgb(27 15 46 / 0.05),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    transition-duration: 60ms;
  }

  /* An icon in a tile stands on a small night square the size of the photo,
     the strip's own ground, so the four tiles read as one row. */
  .tile-icon {
    display: grid;
    place-items: center;
    background: var(--night);
    border-radius: var(--r-img);
  }

  .tile-icon :global(.pi) {
    width: 58%;
    height: auto;
  }

  /* The icon panel beside a row: the photo's frame (ratio, radius, ring and
     shadow come from .media's rules on .photo, repeated here) around the
     strip's night, grained, with the icon at about half the frame's width. */
  .icon-panel {
    display: grid;
    place-items: center;
    aspect-ratio: var(--photo-ratio, 3 / 2);
    border-radius: var(--r-img);
    /* The strip's night with its violet well, as the banner's dark cards. */
    background:
      radial-gradient(ellipse 70% 60% at 50% 45%, rgb(96 8 215 / 0.35), transparent 70%),
      linear-gradient(160deg, #2a1550, var(--night) 55%, var(--night-2));
    box-shadow:
      0 0 0 var(--hairline) rgb(160 108 255 / 0.4),
      0 0 0 calc(var(--hairline) * 2) rgb(255 255 255 / 0.6),
      0 1.5rem 3rem rgb(27 15 46 / 0.14);
  }

  .icon-panel :global(.pi) {
    width: 46%;
    height: auto;
    filter: drop-shadow(0 0 1.25rem rgb(160 108 255 / 0.55));
  }

  .tile :global(.tile-photo) {
    flex: none;
    align-self: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--r-img);
    /* The section's photo ring at thumb scale: no raw crop edge on white. */
    box-shadow: 0 0 0 var(--hairline) rgb(160 108 255 / 0.4);
  }

  .tile-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    padding-top: 0.35rem;
  }

  .tile-name {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step-0);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .tile-label {
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.3;
  }

  .get-help {
    display: grid;
    gap: var(--space-m);
    margin-block: var(--space-m) var(--space-xl);
    /* A step more at the top than the sides, like every card header. */
    padding: calc(var(--space-m) + var(--space-s)) var(--space-m) var(--space-m);
  }

  /* A step under the section's title, like a program's name. */
  .get-help h3 {
    font-size: calc(var(--step-3) * 0.85);
    color: #fff;
  }

  .get-help p {
    color: var(--night-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
  }

  /* Program rows: photo above text on phones; sides alternate on desktop.
     Rows are parted by space alone (a section space from tablets up, a
     little less on phones) and told apart by their chapter numbers and the
     photo changing sides; the rule of light that lay between them read as
     a line cut across the page (decision 72). */
  .list {
    display: grid;
    gap: var(--space-m);
  }

  /* Each row is a surface (decision 91): the white card with the lit rim
     and shadow that every other panel on the site stands on, so the rows
     stop reading as loose text on the ground. The photo's plate steps out
     past the card's edge, as the About portrait's does, so the card does
     not box it in. Inside, the row is a spread: its chapter number over
     the eyebrow, the copy a column that starts where the photo starts and
     ends, with its one next step, where the photo ends. */
  .row {
    position: relative;
    display: grid;
    gap: var(--space-m);
    padding: var(--space-m);
    overflow: visible;
    /* Lit from a corner like every other surface (decision 63): a violet
       wash at the top right, a breath of rose low at the left, over the
       card's white. Even rows, whose photo stands at the left, are lit
       the other way, so the light always falls across the words. */
    background:
      radial-gradient(32rem 20rem at 100% 0, rgb(160 108 255 / 0.1), transparent 70%),
      radial-gradient(24rem 16rem at 0 100%, rgb(255 90 134 / 0.06), transparent 70%), #fff;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  /* The surface's rim (global.css) sits above the children; the plate and
     the photo must rise over it. */
  .row :global(.media) {
    z-index: 2;
  }

  @media (hover: hover) {
    .row:hover {
      transform: translateY(-2px);
      box-shadow:
        0 1.5rem 3.5rem rgb(27 15 46 / 0.12),
        0 0.125rem 0.375rem rgb(27 15 46 / 0.06),
        inset 0 1px 0 rgb(255 255 255 / 0.9);
    }
  }

  .copy {
    order: 1;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* The program's number in the reference's serif: a chapter number over
     the eyebrow, in a lavender that stands back from the words, on every
     class. (It had been set nine rem tall and faint behind the eyebrow and
     the heading from tablets up, where it tangled with them; decision 72.) */
  .index {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 3rem;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: rgb(96 8 215 / 0.22);
    pointer-events: none;
    position: relative;
    z-index: 1;
    user-select: none;
  }

  /* The row's one next step (the link, or the checklist's summary, or
     both) closes the copy under a short lit rule, the mirror of the
     eyebrow's rule that opens it. It had stood under a full-width
     hairline, which with the rule of light between the rows framed the
     link between two lines (decision 68). */
  .step {
    margin-top: var(--space-m);
  }

  .step::before {
    content: "";
    display: block;
    width: 2.25rem;
    height: 0.1875rem;
    margin-bottom: 0.75rem;
    border-radius: 0.125rem;
    background: linear-gradient(90deg, var(--purple), #d43a92);
  }

  .step > * + * {
    margin-top: 0.25rem;
  }

  .details li::marker {
    color: var(--purple);
  }

  .media {
    order: 0;
    position: relative;
  }

  /* A pool of light behind each photo, as the About portrait stands in one:
     violet with a breath of rose, sized from the photo in rem so it is one
     picture per class, under the plate (decision 72). */
  .media::after {
    content: "";
    position: absolute;
    inset: -12% -14% -16% -14%;
    z-index: -2;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(160 108 255 / 0.3),
      rgb(255 90 134 / 0.12) 58%,
      transparent 80%
    );
    pointer-events: none;
  }

  /* A program's name is a step under the section's title. */
  .row h3 {
    font-size: calc(var(--step-3) * 0.85);
  }

  /* Photos and the player sit in framed panels: a hairline ring and a soft
     shadow (the player's radius is the photo's, --r-img). */
  .media :global(.photo),
  .media :global(.yt) {
    box-shadow:
      0 0 0 var(--hairline) rgb(160 108 255 / 0.4),
      0 0 0 calc(var(--hairline) * 2) rgb(255 255 255 / 0.6),
      0 1.5rem 3rem rgb(27 15 46 / 0.14);
  }

  .summary {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  /* Who the program serves, in ink under a small tracked label: the one
     line a family scans for. The label is a sub-label, a step under the
     program's eyebrow (smaller, muted), so the line carries the weight. */
  .for {
    display: grid;
    gap: 0.3rem;
    color: var(--ink);
  }

  .for-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* The body face is loaded at 400 and 700 only, so the line keeps the
     regular weight and its ink colour does the work. */
  .for-text {
    font-weight: 400;
  }

  .details {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  /* The list eases open where the browser can animate a disclosure
     (interpolate-size and ::details-content); elsewhere it opens at once. */
  .checklist {
    interpolate-size: allow-keywords;
  }

  .checklist::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      block-size 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 200ms ease,
      content-visibility 260ms allow-discrete;
  }

  .checklist[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  /* The global reduced-motion rule (global.css) cannot name this
     pseudo-element: a browser that doesn't know it would drop the whole
     selector list, so it is stilled here on its own. */
  @media (prefers-reduced-motion: reduce) {
    .checklist::details-content {
      transition: none;
    }
  }

  /* The summary is a control, dressed as one: a full-width row on the
     lilac with the boundary ring the chips wear, a chevron in a small disc
     at its head, and the pill radius (decision 91). It had been a bare
     purple line of text with a stroke chevron, the plainest control on the
     page. */
  .checklist summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--purple);
    min-height: max(44px, 2.75rem);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    list-style: none;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.72);
    box-shadow: inset 0 0 0 var(--hairline) var(--rule-strong);
    scroll-margin-top: calc(var(--header-h) + var(--space-s));
    transition:
      color 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }

  .checklist summary .disc {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background-color: var(--purple);
    background-image: linear-gradient(180deg, rgb(255 255 255 / 0.14), rgb(255 255 255 / 0) 40%);
    box-shadow:
      inset 0 0 0 var(--hairline) rgb(255 255 255 / 0.2),
      0 0.25rem 0.75rem rgb(96 8 215 / 0.25);
    transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .checklist[open] summary .disc {
    transform: rotate(180deg);
  }

  /* The row's two kinds of next step answer the pointer the same way:
     the summary underlines like the arrow links beside it, and a press
     deepens it. */
  @media (hover: hover) {
    .checklist summary:hover {
      background: var(--lilac);
      box-shadow: inset 0 0 0 var(--hairline) var(--purple);
    }
  }

  .checklist summary:active {
    color: var(--purple-deep);
    background: var(--lilac);
    transition-duration: 60ms;
  }

  .checklist summary:focus-visible {
    outline: max(2px, 0.1875rem) solid var(--focus);
    outline-offset: 0.125rem;
  }

  .checklist summary::-webkit-details-marker {
    display: none;
  }

  /* The chevron, drawn in the disc: the checklist stroke, white. */
  .checklist summary .disc::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    margin-top: -0.2rem;
    border-right: 0.15625rem solid #fff;
    border-bottom: 0.15625rem solid #fff;
    transform: rotate(45deg);
  }

  /* The two groups stack on every class; space parts the open list from
     its summary, the way the section's words open and close elsewhere —
     the flat full-width rule read as a stray line. Each list runs in one
     column on phones (two columns wrapped items mid-phrase) and two from
     the tablet up. */
  /* The open list sits on an inset lilac panel with the rim's hairline, a
     surface within the surface, so the list reads as a thing that opened
     rather than words that appeared. */
  .groups {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--r-img);
    background:
      radial-gradient(28rem 16rem at 100% 0, rgb(160 108 255 / 0.14), transparent 70%), var(--lilac);
    box-shadow: inset 0 0 0 var(--hairline) rgb(160 108 255 / 0.28);
  }

  /* The group names carry the section's own label language, like the
     "Who it's for" lines above them. */
  .groups h4 {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
