---
import { show } from "../data/facts.ts";
import { facts, getHelp, links, org, programs } from "../data/site";
import Brand from "./Brand.astro";
import Photo from "./Photo.astro";
import Wave from "./Wave.astro";
import YouTubeLite from "./YouTubeLite.astro";

const active = programs.filter((p) => p.active);
const phone = show(facts.phone);
const applyEmail = `mailto:${show(facts.email)}?subject=${encodeURIComponent("Application request")}`;
const applyHref = links.familyApplication ?? getHelp.action.href;
---

<section id="programs" class="section" aria-labelledby="programs-title">
  <!-- The wave lifts the night band off the page: night above, paper below. -->
  <Wave kind="into-paper" id="wb" class="wave-in" />
  <div class="wrap">
    <!-- Her mark as a faint watermark beside the opener, as the reference
         draws it: her flat mark in one lavender tone, nothing redrawn. -->
    <Brand kind="mark" class="watermark" label="" />
    <header class="intro">
      <span class="eyebrow">Our programs</span>
      <h2 id="programs-title">What we do, all year</h2>
      <p class="lede">{org.mission}</p>
    </header>

    <!-- Jump tiles: one per program, so the whole offering fits one glance. -->
    <nav class="tiles" aria-label="Jump to a program">
      <ul>
        {active.map((program) => (
          <li>
            <a class="tile" href={`#${program.slug}`}>
              {program.photo && (
                <Photo
                  photo={program.photo}
                  ratio="1 / 1"
                  sizes="72px"
                  widths={[144, 216]}
                  class="tile-photo"
                />
              )}
              <span class="tile-text">
                <span class="tile-name">{program.name}</span>
                <span class="tile-label">{program.label}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Get help: the one dark card on the page, so families can't miss it. -->
    <div id="get-help" class="get-help on-dark">
      <div class="stack">
        <h3>{getHelp.heading}</h3>
        <p>{getHelp.whoCanApply}</p>
        <p>{getHelp.howToApply}</p>
      </div>
      <div class="actions">
        <a class="button button--signal" href={applyHref}>
          {getHelp.action.label}
        </a>
        <a class="button button--glass" href={phone.href}>
          Call {phone.display}
        </a>
        <a class="arrow-link" href={applyEmail}>
          Email us
        </a>
      </div>
    </div>

    <div class="list">
      {active.map((program, i) => (
        <article
          id={program.slug}
          class:list={["row", { "has-media": program.photo || program.video }]}
        >
          <div class="stack copy">
            <div>
              <span class="eyebrow">{program.label}</span>
              <h3>{program.name}</h3>
            </div>
            <p class="summary">{program.summary}</p>
            <p class="for">
              <span class="for-label">Who it's for</span>
              {program.forWhom}
            </p>
            {program.details && (
              <ul class="details">
                {program.details.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            )}
            {program.checklist && (
              <details class="checklist">
                <summary>{program.checklist.title}</summary>
                <div class="groups">
                  {program.checklist.groups.map((group) => (
                    <div>
                      <h4>{group.heading}</h4>
                      <ul>
                        {group.items.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            )}
          </div>
          {program.video ? (
            <div class="media">
              <YouTubeLite video={program.video} />
            </div>
          ) : (
            program.photo && (
              <div class="media">
                <Photo
                  photo={program.photo}
                  ratio={i === 0 ? "4 / 3" : "3 / 2"}
                  sizes="(min-width: 56rem) 540px, calc(100vw - 2.5rem)"
                />
              </div>
            )
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* The section starts under the wave from the night band (--wave-h), so its
     top padding is the wave plus the usual section space. */
  #programs {
    position: relative;
    overflow: hidden; /* the watermark bleeds past the column */
    /* The space above the opener is measured from the ribbons' foot (the
       paper starts at 74% of the wave's box), not from the box. */
    padding-top: calc(var(--wave-h) * 0.74 + var(--space-l));
  }

  #programs > .wrap {
    position: relative;
  }

  /* Placed from the column's edge in rem, so it sits at the same place on
     every device of a class. */
  #programs :global(.watermark) {
    position: absolute;
    top: -1.5rem;
    right: -2rem;
    width: 21rem;
    opacity: 0.06;
    pointer-events: none;
  }

  #programs :global(.watermark path) {
    fill: var(--purple);
  }

  #programs :global(.wave-in) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--wave-h);
  }

  .intro {
    margin-bottom: var(--space-m);
  }

  .intro .lede {
    margin-top: var(--space-s);
  }

  /* Tiles: a scroll strip on phones, a four-up grid on desktop. */
  .tiles ul {
    display: flex;
    gap: var(--space-xs);
    padding: 0.25rem var(--gutter) 0.75rem;
    margin: 0 calc(-1 * var(--gutter));
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .tiles ul::-webkit-scrollbar {
    display: none;
  }

  .tiles li {
    flex: 0 0 min(78%, 17rem);
    scroll-snap-align: start;
  }

  .tile {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    min-height: max(44px, 2.75rem);
    padding: 0.75rem;
    border-radius: var(--r-card);
    background: #fff;
    border: var(--hairline) solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  .tile:hover {
    border-color: var(--purple);
    box-shadow: 0 10px 30px rgb(27 15 46 / 0.08);
    transform: translateY(-2px);
  }

  .tile :global(.tile-photo) {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 0.625rem;
  }

  .tile-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .tile-name {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step-0);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .tile-label {
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.3;
  }

  .get-help {
    display: grid;
    gap: var(--space-m);
    margin-block: var(--space-m) var(--space-xl);
    padding: var(--space-m);
    border-radius: var(--r-card);
    background:
      radial-gradient(70% 60% at 100% 0%, rgb(96 8 215 / 0.35), transparent 60%), var(--night);
  }

  .get-help h3 {
    font-size: var(--step-3);
    color: #fff;
  }

  .get-help p {
    color: var(--night-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
  }

  /* Program rows: photo above text on phones; sides alternate on desktop. */
  .list {
    display: grid;
    gap: var(--space-l);
  }

  .row {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-l);
    border-top: var(--hairline) solid var(--rule);
  }

  .row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .copy {
    order: 1;
  }

  .media {
    order: 0;
  }

  /* A program's name is a step under the section's title. */
  .row h3 {
    font-size: calc(var(--step-3) * 0.85);
  }

  /* Photos sit in framed panels: a hairline ring and a soft shadow. */
  .media :global(.photo) {
    box-shadow:
      0 0 0 var(--hairline) rgb(96 8 215 / 0.1),
      0 1.5rem 3rem rgb(27 15 46 / 0.1);
  }

  .summary {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .for {
    display: grid;
    gap: 0.15rem;
    color: var(--muted);
  }

  .for-label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--ink);
  }

  .details {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .checklist summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--purple);
    min-height: max(44px, 2.75rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
  }

  .checklist summary::-webkit-details-marker {
    display: none;
  }

  .checklist summary::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-right: 0.15625rem solid currentColor;
    border-bottom: 0.15625rem solid currentColor;
    transform: rotate(-45deg);
    transition: transform 150ms ease;
  }

  .checklist[open] summary::before {
    transform: rotate(45deg);
  }

  .groups {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-xs);
  }

  h4 {
    margin: 0 0 0.4rem;
  }

  .groups ul {
    columns: 2;
    column-gap: var(--space-m);
    padding-left: 1.2rem;
  }

  @media (min-width: 36rem) {
    .tiles li {
      flex-basis: min(46%, 17rem);
    }
  }

  @media (min-width: 56rem) {
    #programs :global(.watermark) {
      top: 0;
      right: -3rem;
      width: 26rem;
    }
    .tiles ul {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-s);
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
    .get-help {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: var(--space-l);
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
    .actions .arrow-link {
      justify-content: center;
    }
    .row.has-media {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      align-items: center;
    }
    .copy,
    .media {
      order: 0;
    }
    .row.has-media:nth-child(even) .media {
      order: -1;
    }
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
