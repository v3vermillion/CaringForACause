---
import { show } from "../data/facts.ts";
import { facts, getHelp, links, org, programs } from "../data/site";
import Brand from "./Brand.astro";
import Photo from "./Photo.astro";
import Wave from "./Wave.astro";
import YouTubeLite from "./YouTubeLite.astro";

const active = programs.filter((p) => p.active);
const phone = show(facts.phone);
const applyEmail = `mailto:${show(facts.email)}?subject=${encodeURIComponent("Application request")}`;
const applyHref = links.familyApplication ?? getHelp.action.href;
---

<section id="programs" class="section ground" aria-labelledby="programs-title">
  <!-- The wave lifts the night band off the page: night above, paper below. -->
  <!-- Night-2 above the ribbons, as the band ends; below them this section's
       own ground shows through (decision 67). -->
  <Wave kind="into-paper" id="wb" above="var(--night-2)" below="none" class="wave-in" />
  <div class="wrap">
    <!-- Her mark as a faint watermark beside the opener, as the reference
         draws it: her flat mark in one lavender tone, nothing redrawn. -->
    <Brand kind="mark" class="watermark" label="" />
    <header class="intro">
      <span class="eyebrow">Our programs</span>
      <h2 id="programs-title">What we do, all year</h2>
      <p class="lede">{org.mission}</p>
    </header>

    <!-- Jump tiles: one per program, so the whole offering fits one glance. -->
    <nav class="tiles" aria-label="Jump to a program">
      <ul>
        {active.map((program) => (
          <li>
            <a class="tile surface" href={`#${program.slug}`}>
              {program.photo && (
                <Photo
                  photo={program.photo}
                  ratio="1 / 1"
                  sizes="72px"
                  widths={[144, 216]}
                  class="tile-photo"
                />
              )}
              <span class="tile-text">
                <span class="tile-name">{program.name}</span>
                <span class="tile-label">{program.label}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Get help: the one dark card on the page, so families can't miss it. -->
    <div id="get-help" class="get-help surface surface--night on-dark">
      <div class="stack">
        <h3>{getHelp.heading}</h3>
        <p>{getHelp.whoCanApply}</p>
        <p>{getHelp.howToApply}</p>
      </div>
      <div class="actions">
        <a class="button button--signal" href={applyHref}>
          {getHelp.action.label}
        </a>
        <a class="button button--glass" href={phone.href}>
          Call {phone.display}
        </a>
        <a class="arrow-link" href={applyEmail}>
          Email us
        </a>
      </div>
    </div>

    <div class="list">
      {active.map((program, i) => (
        <article
          id={program.slug}
          class:list={["row", { "has-media": program.photo || program.video }]}
        >
          <div class="stack copy">
            <span class="index" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <span class="eyebrow">{program.label}</span>
              <h3>{program.name}</h3>
            </div>
            <p class="summary">{program.summary}</p>
            <p class="for">
              <span class="for-label">Who it's for</span>
              <span class="for-text">{program.forWhom}</span>
            </p>
            {program.details && (
              <ul class="details">
                {program.details.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            )}
            <!-- The row's one next step closes the copy under a short lit
                 rule, as the eyebrow opens it over one (decision 68). -->
            {(program.link || program.checklist) && (
              <div class="step">
                {program.link && (
                  <p class="next">
                    <a class="arrow-link" href={program.link.href}>
                      {program.link.label}
                    </a>
                  </p>
                )}
                {program.checklist && (
                  <details class="checklist">
                    <summary>{program.checklist.title}</summary>
                    <div class="groups">
                      {program.checklist.groups.map((group) => (
                        <div>
                          <h4>{group.heading}</h4>
                          <ul>
                            {group.items.map((item) => (
                              <li>{item}</li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </details>
                )}
              </div>
            )}
          </div>
          {program.video ? (
            <div class="media">
              <YouTubeLite video={program.video} />
            </div>
          ) : (
            program.photo && (
              <div class:list={["media", "plate", { "plate--left": i % 2 === 1 }]}>
                <Photo
                  photo={program.photo}
                  ratio={`var(--photo-ratio, ${i === 0 ? "4 / 3" : "3 / 2"})`}
                  sizes="(min-width: 56rem) 480px, (min-width: 36rem) 40vw, calc(100vw - 2.5rem)"
                />
              </div>
            )
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* The section starts under the wave from the night band (--wave-h), so its
     top padding is the wave plus the usual section space. */
  #programs {
    /* A link to the section lands on its words, not on the wave that opens
       it: the wave scrolls under the bar (its box's foot a few pixels above
       the bar's edge) and the paper starts there, with the eyebrow a section
       space below (decision 71). */
    scroll-margin-top: calc(var(--header-h) - var(--scroll-pad) - var(--wave-h) - 0.25rem);
    position: relative;
    /* The watermark bleeds past the column; clipped (not hidden) so the
       section is not a scroll container with the watermark's width of
       hidden overflow (see the banner). */
    overflow: hidden;
    overflow: clip;
    /* The space above the opener is measured from the wave's box, so that a
       link landing with the wave under the bar still finds the opener a
       section space below it (decision 71; decision 53 had measured it from
       the ribbons' foot). */
    padding-top: calc(var(--wave-h) + var(--space-l));
    /* The Get involved wedge cuts --wedge into this section's foot, so the
       foot carries it: its high corner sits a full section space under the
       last row. */
    padding-bottom: calc(var(--space-xl) + var(--wedge));
  }

  #programs > .wrap {
    position: relative;
  }

  /* Placed from the column's edge in rem, so it sits at the same place on
     every device of a class. */
  /* Sized to the opener and faded at its foot, so it sits behind the
     eyebrow and the heading and dissolves before the tiles. */
  #programs :global(.watermark) {
    position: absolute;
    top: -1.5rem;
    right: -2rem;
    width: 15rem;
    opacity: 0.06;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 40%, transparent 90%);
    mask-image: linear-gradient(180deg, #000 40%, transparent 90%);
  }

  #programs :global(.watermark path) {
    fill: var(--purple);
  }

  #programs :global(.wave-in) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--wave-h);
  }

  .intro {
    margin-bottom: var(--space-m);
  }

  .intro .lede {
    margin-top: var(--space-s);
  }

  /* Tiles: a scroll strip on phones and tablets, a four-up grid on desktop.
     The strip bleeds into the gutters and fades at both edges, so a cut tile
     dissolves instead of chopping; at rest the tiles start where the fade
     ends, so nothing at rest is dimmed. */
  /* The strip scrolls sideways, which makes it clip vertically too, and a
     tile's shadow cut at the strip's edge drew a line across the page
     under the tiles (decision 67). The strip's box reaches 2rem above and
     3rem below the tiles (past the farthest shadow), with margins that
     take all but the 0.25rem and 0.75rem it always kept back, so the
     tiles sit where they did and the shadows fall whole. */
  .tiles ul {
    display: flex;
    gap: var(--space-xs);
    padding: 2rem var(--gutter) 3rem;
    margin: -1.75rem calc(-1 * var(--gutter)) -2.25rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--gutter),
      #000 calc(100% - var(--gutter)),
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--gutter),
      #000 calc(100% - var(--gutter)),
      transparent
    );
  }

  .tiles ul::-webkit-scrollbar {
    display: none;
  }

  .tiles li {
    flex: 0 0 min(78%, 17rem);
    scroll-snap-align: start;
  }

  /* A surface (global.css): lifted, with a rim of light; the tile's own
     shadow is lighter than a panel's, and the rim goes purple on hover. */
  .tile {
    display: flex;
    align-items: flex-start; /* the names share a line across the row */
    gap: 0.85rem;
    height: 100%;
    min-height: max(44px, 2.75rem);
    padding: 0.75rem;
    box-shadow:
      0 0.75rem 2rem rgb(27 15 46 / 0.06),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  .tile:hover::before {
    background: var(--purple);
  }

  .tile:hover {
    box-shadow:
      0 1rem 2.5rem rgb(27 15 46 / 0.1),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    transform: translateY(-2px);
  }

  .tile:active {
    transform: translateY(0);
    box-shadow: none;
    transition-duration: 60ms;
  }

  .tile :global(.tile-photo) {
    flex: none;
    align-self: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--r-img);
  }

  .tile-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    padding-top: 0.35rem;
  }

  .tile-name {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step-0);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .tile-label {
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.3;
  }

  .get-help {
    display: grid;
    gap: var(--space-m);
    margin-block: var(--space-m) var(--space-xl);
    padding: var(--space-m);
  }

  /* A step under the section's title, like a program's name. */
  .get-help h3 {
    font-size: calc(var(--step-3) * 0.85);
    color: #fff;
  }

  .get-help p {
    color: var(--night-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
  }

  /* Program rows: photo above text on phones; sides alternate on desktop.
     Rows are parted by space alone (a section space from tablets up, a
     little less on phones) and told apart by their chapter numbers and the
     photo changing sides; the rule of light that lay between them read as
     a line cut across the page (decision 72). */
  .list {
    display: grid;
    gap: var(--space-l);
  }

  /* Each row is a spread: its chapter number over the eyebrow, the copy a
     column that starts where the photo starts and ends, with its one next
     step, where the photo ends. */
  .row {
    position: relative;
    display: grid;
    gap: var(--space-m);
  }

  .copy {
    order: 1;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* The program's number in the reference's serif: a chapter number over
     the eyebrow, in a lavender that stands back from the words, on every
     class. (It had been set nine rem tall and faint behind the eyebrow and
     the heading from tablets up, where it tangled with them; decision 72.) */
  .index {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 3rem;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: rgb(96 8 215 / 0.22);
    pointer-events: none;
    user-select: none;
  }

  /* The row's one next step (the link, or the checklist's summary, or
     both) closes the copy under a short lit rule, the mirror of the
     eyebrow's rule that opens it. It had stood under a full-width
     hairline, which with the rule of light between the rows framed the
     link between two lines (decision 68). */
  .step {
    margin-top: var(--space-m);
  }

  .step::before {
    content: "";
    display: block;
    width: 2.25rem;
    height: 0.1875rem;
    margin-bottom: 0.75rem;
    border-radius: 0.125rem;
    background: linear-gradient(90deg, var(--purple), #d43a92);
  }

  .step > * + * {
    margin-top: 0.25rem;
  }

  .details li::marker {
    color: var(--purple);
  }

  .media {
    order: 0;
    position: relative;
  }

  /* A pool of light behind each photo, as the About portrait stands in one:
     violet with a breath of rose, sized from the photo in rem so it is one
     picture per class, under the plate (decision 72). */
  .media::after {
    content: "";
    position: absolute;
    inset: -12% -14% -16% -14%;
    z-index: -2;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(160 108 255 / 0.3),
      rgb(255 90 134 / 0.12) 58%,
      transparent 80%
    );
    pointer-events: none;
  }

  /* A program's name is a step under the section's title. */
  .row h3 {
    font-size: calc(var(--step-3) * 0.85);
  }

  /* Photos and the player sit in framed panels: a hairline ring and a soft
     shadow (the player's radius is the photo's, --r-img). */
  .media :global(.photo),
  .media :global(.yt) {
    box-shadow:
      0 0 0 var(--hairline) rgb(160 108 255 / 0.4),
      0 0 0 calc(var(--hairline) * 2) rgb(255 255 255 / 0.6),
      0 1.5rem 3rem rgb(27 15 46 / 0.14);
  }

  .summary {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  /* Who the program serves, in ink under a small tracked label: the one
     line a family scans for. The label is a sub-label, a step under the
     program's eyebrow (smaller, muted), so the line carries the weight. */
  .for {
    display: grid;
    gap: 0.3rem;
    color: var(--ink);
  }

  .for-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* The body face is loaded at 400 and 700 only, so the line keeps the
     regular weight and its ink colour does the work. */
  .for-text {
    font-weight: 400;
  }

  .details {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  /* The list eases open where the browser can animate a disclosure
     (interpolate-size and ::details-content); elsewhere it opens at once. */
  .checklist {
    interpolate-size: allow-keywords;
  }

  .checklist::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
    transition:
      block-size 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 200ms ease,
      content-visibility 260ms allow-discrete;
  }

  .checklist[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  .checklist summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--purple);
    min-height: max(44px, 2.75rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    scroll-margin-top: calc(var(--header-h) + var(--space-s));
  }

  .checklist summary::-webkit-details-marker {
    display: none;
  }

  .checklist summary::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-right: 0.15625rem solid currentColor;
    border-bottom: 0.15625rem solid currentColor;
    transform: rotate(-45deg);
    transition: transform 150ms ease;
  }

  .checklist[open] summary::before {
    transform: rotate(45deg);
  }

  /* The two groups stack on every class, under a rule that parts the open
     list from the summary; each list runs in two columns wide enough that
     an item never wraps mid-phrase. */
  .groups {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-s);
    margin-top: var(--space-xs);
    border-top: var(--hairline) solid var(--rule);
  }

  h4 {
    margin: 0 0 0.4rem;
  }

  .groups ul {
    columns: 2;
    column-gap: var(--space-m);
    padding-left: 1.2rem;
  }

  .groups li {
    break-inside: avoid;
    font-size: var(--step--1);
    line-height: 1.5;
  }

  @media (min-width: 36rem) {
    .tiles li {
      flex-basis: min(46%, 17rem);
    }
  }

  /* From tablets up the photo stands beside the words as a portrait, the
     photos' own shape (they are phone pictures, 3 by 4), so no head is
     cropped and the row reads as a spread; sides alternate. */
  @media (min-width: 36rem) {
    .list {
      gap: var(--space-xl);
    }
    .row.has-media {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-l);
      align-items: center;
    }
    /* The photo is square beside the words on tablets and a little wider
       than tall on desktop: a crop about as tall as the words, so no column
       runs empty beside it, and one picture per class (a photo that took
       the row's height changed with the words' wrapping). */
    .media {
      --photo-ratio: 1 / 1;
      align-self: center;
    }
    .index {
      font-size: 3.5rem;
    }
    .copy,
    .media {
      order: 0;
    }
    /* Even rows put the photo on the left, in the narrower column: the
       columns swap with the sides, so every photo is the same size and every
       row the same height. */
    .row.has-media:nth-child(even) {
      grid-template-columns: 5fr 7fr;
    }
    .row.has-media:nth-child(even) .media {
      order: -1;
    }
    /* The video row is the exception: a 16 by 9 frame crops nothing, so it
       takes the wide column, on the left whichever row it falls on, and the
       words sit beside it in the narrow one. Written after the even-row
       rules, which it outweighs only by order. */
    .row.has-media:has(:global(.yt)) {
      grid-template-columns: 7fr 5fr;
    }
    .row.has-media:has(:global(.yt)) .media {
      order: -1;
    }
  }

  @media (min-width: 56rem) {
    /* Square on desktop too: a 5 by 4 crop of these portrait photos showed
       three fifths of each and trimmed heads; square shows three quarters,
       and the copy, with its chapter number, stands about as tall
       (decision 72). */
    .media {
      --photo-ratio: 1 / 1;
    }
    #programs :global(.watermark) {
      top: -2.5rem;
      right: -3rem;
      width: 22rem;
    }
    .tiles ul {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-s);
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .get-help {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: var(--space-l);
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
    .actions .arrow-link {
      justify-content: center;
    }
    .row.has-media {
      gap: var(--space-xl);
    }
  }
</style>
