---
import { show } from "../data/facts.ts";
import { facts, getHelp, links, org, programs } from "../data/site";
import Photo from "./Photo.astro";
import VideoLink from "./VideoLink.astro";
import YouTubeLite from "./YouTubeLite.astro";

const active = programs.filter((p) => p.active);
const phone = show(facts.phone);
const applyEmail = `mailto:${show(facts.email)}?subject=${encodeURIComponent("Application request")}`;
---

<section id="programs" class="section" aria-labelledby="programs-title">
  <div class="wrap">
    <header class="intro stack">
      <h2 id="programs-title">Our programs</h2>
      <p>{org.mission}</p>
    </header>

    <!-- Jump tiles: one per program, so the whole offering fits one glance. -->
    <nav class="tiles" aria-label="Jump to a program">
      <ul>
        {active.map((program) => (
          <li>
            <a class="tile" href={`#${program.slug}`}>
              {program.photo && (
                <Photo photo={program.photo} ratio="1 / 1" sizes="72px" class="tile-photo" />
              )}
              <span class="tile-text">
                <span class="tile-name">{program.name}</span>
                <span class="tile-label">{program.label}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div id="get-help" class="get-help">
      <div class="stack">
        <h3>{getHelp.heading}</h3>
        <p>{getHelp.whoCanApply}</p>
        <p>{getHelp.howToApply}</p>
      </div>
      <div class="button-row">
        {links.familyApplication && (
          <a class="button button--crimson" href={links.familyApplication}>
            Apply online
          </a>
        )}
        <a class="button button--crimson" href={phone.href}>
          Call {phone.display}
        </a>
        <a class="button button--ghost" href={applyEmail}>
          Email us
        </a>
      </div>
    </div>

    <div class="list">
      {active.map((program, i) => (
        <article
          id={program.slug}
          class:list={["row", { featured: i === 0, "has-media": program.photo || program.video }]}
        >
          <div class="stack copy">
            <p class="label">{program.label}</p>
            <h3>{program.name}</h3>
            <p class="summary">{program.summary}</p>
            <p class="for">
              <strong>Who it's for:</strong> {program.forWhom}
            </p>
            {program.details && (
              <ul class="details">
                {program.details.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            )}
            {program.checklist && (
              <details class="checklist">
                <summary>{program.checklist.title}</summary>
                <div class="groups">
                  {program.checklist.groups.map((group) => (
                    <div>
                      <h4>{group.heading}</h4>
                      <ul>
                        {group.items.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            )}
            {program.photo && program.video && <VideoLink video={program.video} />}
          </div>
          {program.photo ? (
            <div class="media">
              <Photo
                photo={program.photo}
                ratio={i === 0 ? "4 / 3" : "3 / 2"}
                sizes="(min-width: 56rem) 520px, calc(100vw - 2.5rem)"
              />
            </div>
          ) : (
            program.video && (
              <div class="media">
                <YouTubeLite video={program.video} />
              </div>
            )
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .intro {
    margin-bottom: var(--space-m);
  }

  .intro p {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--muted);
  }

  /* Tiles: a scroll strip on phones, a four-up grid on desktop. */
  .tiles ul {
    display: flex;
    gap: var(--space-xs);
    padding: 0.25rem 0 0.75rem;
    margin-inline: -1.25rem;
    padding-inline: 1.25rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .tiles ul::-webkit-scrollbar {
    display: none;
  }

  .tiles li {
    flex: 0 0 min(78%, 17rem);
    scroll-snap-align: start;
  }

  .tile {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 44px;
    padding: 0.75rem;
    border-radius: 18px;
    background: #fff;
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }

  .tile:hover {
    border-color: var(--purple);
    transform: translateY(-2px);
  }

  .tile :global(.tile-photo) {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 12px;
  }

  .tile-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .tile-name {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step-0);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .tile-label {
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.3;
  }

  /* Get help: the one card on the page that is dark, so it can't be missed. */
  .get-help {
    display: grid;
    gap: var(--space-m);
    margin-block: var(--space-m) var(--space-xl);
    padding: var(--space-m);
    border-radius: 24px;
    background: var(--night);
    color: #fff;
  }

  .get-help h3 {
    color: #fff;
  }

  .get-help p {
    color: var(--night-soft);
  }

  .button--ghost {
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    border-color: rgb(255 255 255 / 0.35);
  }

  .button--ghost:hover {
    background: rgb(255 255 255 / 0.18);
  }

  /* Program rows: photo above text on phones; sides alternate on desktop. */
  .list {
    display: grid;
    gap: var(--space-l);
  }

  .row {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule);
  }

  .row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .copy {
    order: 1;
  }

  .media {
    order: 0;
  }

  .label {
    font-weight: 700;
    color: var(--purple);
    font-size: var(--step--1);
  }

  .featured .label {
    color: var(--crimson);
  }

  .row h3 {
    font-size: var(--step-2);
  }

  .featured h3 {
    font-size: var(--step-3);
  }

  .summary {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .for {
    color: var(--muted);
  }

  .details {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .checklist summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--purple);
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .groups {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-xs);
  }

  h4 {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin: 0 0 0.4rem;
  }

  .groups ul {
    columns: 2;
    column-gap: var(--space-m);
    padding-left: 1.2rem;
  }

  @media (min-width: 40rem) {
    .tiles li {
      flex-basis: min(46%, 17rem);
    }
  }

  @media (min-width: 56rem) {
    .tiles ul {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-s);
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
    .get-help {
      grid-template-columns: 1fr auto;
      align-items: end;
      padding: var(--space-l);
    }
    .row.has-media {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      align-items: center;
    }
    .copy,
    .media {
      order: 0;
    }
    .row.has-media:nth-child(even) .media {
      order: -1;
    }
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
