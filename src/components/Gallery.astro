---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { gallery } from "../data/site";

// Photos live in src/assets/gallery/ and are listed in src/data/site.ts.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

const photos = gallery.map((photo) => {
  const match = files[`../assets/gallery/${photo.file}`];
  if (!match) {
    throw new Error(`Gallery photo not found: src/assets/gallery/${photo.file}`);
  }
  return { src: match.default, alt: photo.alt };
});
---

{photos.length > 0 && (
  <section class="section section--lilac" aria-labelledby="gallery-title">
    <div class="wrap">
      <h2 id="gallery-title">Team work</h2>
      <ul class="strip">
        {photos.map((photo) => (
          <li>
            <Image src={photo.src} alt={photo.alt} widths={[320, 640]} sizes="320px" />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  h2 {
    margin-bottom: var(--space-m);
  }

  .strip {
    display: flex;
    gap: var(--space-s);
    padding: 0 0 var(--space-xs);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  li {
    flex: 0 0 min(80%, 320px);
    scroll-snap-align: start;
  }

  li :global(img) {
    border-radius: 12px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
