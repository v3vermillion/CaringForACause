---
import { gallery } from "../data/site";
import Photo from "./Photo.astro";

// A strip needs enough photos to read as one; fewer than four looks unfinished.
const show = gallery.length >= 4;
---

{show && (
  <section class="section section--lilac ground ground--lilac" aria-labelledby="gallery-title">
    <div class="wrap">
      <h2 id="gallery-title">Moments from our programs</h2>
      <ul class="strip">
        {gallery.map((photo) => (
          <li>
            <Photo photo={photo} ratio="4 / 5" sizes="(min-width: 40rem) 320px, 80vw" />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  h2 {
    margin-bottom: var(--space-m);
  }

  .strip {
    display: flex;
    gap: var(--space-s);
    padding: 0 0 var(--space-xs);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  li {
    flex: 0 0 min(80%, 20rem);
    scroll-snap-align: start;
  }

  /* The photos are rimmed and lifted like the surfaces. */
  li :global(.photo) {
    box-shadow:
      0 0 0 var(--hairline) rgb(160 108 255 / 0.4),
      0 0 0 calc(var(--hairline) * 2) rgb(255 255 255 / 0.6),
      0 1rem 2.5rem rgb(27 15 46 / 0.12);
  }
</style>
