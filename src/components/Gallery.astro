---
import { gallery, gallerySection } from "../data/site";
import Photo from "./Photo.astro";

// A strip needs enough photos to read as one; fewer than four looks unfinished.
const show = gallery.length >= 4;
---

{show && (
  <section
    class="section section--lilac ground ground--lilac"
    id="gallery"
    aria-labelledby="gallery-title"
  >
    <div class="wrap">
      <div class="head-row">
        <header class="head">
          <span class="eyebrow">{gallerySection.eyebrow}</span>
          <h2 id="gallery-title">{gallerySection.heading}</h2>
          <p class="lede">{gallerySection.lede}</p>
        </header>
        {/* For a mouse, which has no sideways scroll of its own: a photo back
            or forward. Shown where a pointer hovers; hidden without JavaScript,
            which is what moves the strip. */}
        <div class="arrows" data-arrows hidden>
          <button type="button" class="arrow" data-arrow="-1" aria-label="Previous photos">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M15 5l-7 7 7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <button type="button" class="arrow" data-arrow="1" aria-label="Next photos">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M9 5l7 7-7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      </div>
      {/* The row scrolls sideways and holds no links, so it takes focus
          itself: keyboard readers reach it with Tab and move it with the
          arrow keys (axe's scrollable-region rule). Its name is the heading. */}
      <ul class="moments" tabindex="0" aria-labelledby="gallery-title" data-moments>
        {gallery.map((photo) => (
          <li>
            <Photo photo={photo} ratio="4 / 5" sizes="(min-width: 40rem) 320px, 80vw" />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<script>
  // The strip pans on its own while it is on screen: end to end and back,
  // at a walking pace, easing into each turn, so every photo crosses the
  // screen without a hand on it (decision 94). A hand wins at once: a
  // pointer resting on it or focus in it holds the pan; a wheel, a touch, a
  // press or a key hands the strip over, and the pan picks up again from
  // wherever it was left eight seconds after the last touch. The strip's
  // snap is off only while the pan drives it, so a swipe still settles on a
  // photo. Readers who ask for less motion get the still strip.
  const strip = document.querySelector<HTMLElement>("[data-moments]");
  /** Set by the pan below: the strip has been handed to a reader. */
  let handOver = () => {};
  if (strip && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const SPEED = 40; // px/s on the open run
    const RAMP = 260; // px over which a run eases in and out
    const TURN = 1600; // ms held at each end
    const HAND = 8000; // ms a hand on the strip holds it after letting go
    let dir = 1;
    let origin = 0; // where the current run began: the ramp is measured from it
    // The pan's own position, carried between frames: at a walking pace a
    // frame moves a fraction of a pixel, and scrollLeft gives back whole ones.
    let pos = 0;
    let placed = 0; // where the last frame left the strip, as the strip reports it
    let running = false;
    let frame = 0;
    let last = 0;
    let turnUntil = 0;
    let inView = false;
    let hovered = false;
    let focused = false;
    let handUntil = 0;
    let handTimer = 0;
    let handed = false; // a gesture has the strip: its snap returns once it settles
    let settleTimer = 0;

    const smooth = (t: number) => {
      const c = Math.min(1, Math.max(0, t));
      return c * c * (3 - 2 * c);
    };
    const span = () => strip.scrollWidth - strip.clientWidth;

    const tick = (now: number) => {
      if (!running) return;
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      // Moved since the last frame by something other than the pan (a
      // scrollbar, a script, find in page): that is a hand too.
      if (Math.abs(strip.scrollLeft - placed) > 1) {
        hand();
        return;
      }
      if (now >= turnUntil) {
        const x = pos;
        const end = span();
        const toEnd = dir > 0 ? end - x : x;
        const fromStart = Math.abs(x - origin);
        const v = SPEED * Math.max(0.1, smooth(Math.min(toEnd, fromStart + RAMP * 0.25) / RAMP));
        const next = x + dir * v * dt;
        if ((dir > 0 && next >= end - 0.5) || (dir < 0 && next <= 0.5)) {
          pos = dir > 0 ? end : 0;
          strip.scrollLeft = pos;
          placed = strip.scrollLeft;
          origin = pos;
          dir = -dir;
          turnUntil = now + TURN;
        } else {
          pos = next;
          strip.scrollLeft = pos;
          placed = strip.scrollLeft;
        }
      }
      frame = requestAnimationFrame(tick);
    };
    const start = () => {
      if (running || !inView || hovered || focused || document.hidden) return;
      if (performance.now() < handUntil) return;
      if (span() <= 0) return;
      running = true;
      pos = strip.scrollLeft;
      placed = pos;
      origin = pos;
      strip.classList.add("is-panning");
      last = performance.now();
      frame = requestAnimationFrame(tick);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(frame);
    };
    // The strip is handed over: the pan stops, its snap comes back once the
    // gesture has settled (the snap would otherwise pull the strip to the
    // nearest photo the moment it returned), and the pan returns after the
    // hand's hold. A pointer or focus merely resting on the strip holds it
    // where it is, snap still off, so nothing moves under a still hand.
    const settle = () => {
      if (!handed) return;
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => {
        handed = false;
        strip.classList.remove("is-panning");
      }, 160);
    };
    const hand = () => {
      stop();
      handed = true;
      handUntil = performance.now() + HAND;
      clearTimeout(handTimer);
      handTimer = window.setTimeout(start, HAND);
      settle();
    };

    strip.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      hovered = true;
      stop();
    });
    strip.addEventListener("pointerleave", (event) => {
      if (event.pointerType !== "mouse") return;
      hovered = false;
      start();
    });
    strip.addEventListener("focusin", () => {
      focused = true;
      stop();
    });
    strip.addEventListener("focusout", () => {
      focused = false;
      start();
    });
    for (const type of ["wheel", "touchstart", "pointerdown", "keydown"] as const)
      strip.addEventListener(type, hand, { passive: true });
    strip.addEventListener("scroll", settle, { passive: true });

    new IntersectionObserver(
      ([entry]) => {
        inView = entry?.isIntersecting ?? false;
        if (inView) start();
        else stop();
      },
      { threshold: 0.35 },
    ).observe(strip);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    handOver = hand;
  }

  // The arrows: one photo (a card and its gap) back or forward, smoothly,
  // and the pan steps aside as for any hand. Each arrow goes quiet at its
  // end of the strip.
  const arrows = document.querySelector<HTMLElement>("[data-arrows]");
  if (strip && arrows) {
    arrows.hidden = false;
    const buttons = Array.from(arrows.querySelectorAll<HTMLButtonElement>("[data-arrow]"));
    const step = () => {
      const first = strip.querySelector<HTMLElement>("li");
      return first
        ? first.getBoundingClientRect().width + parseFloat(getComputedStyle(strip).gap)
        : 320;
    };
    const ends = () => {
      const end = strip.scrollWidth - strip.clientWidth;
      for (const button of buttons) {
        const dir = Number(button.dataset.arrow);
        const at = dir < 0 ? strip.scrollLeft <= 1 : strip.scrollLeft >= end - 1;
        button.setAttribute("aria-disabled", String(at));
      }
    };
    for (const button of buttons)
      button.addEventListener("click", () => {
        if (button.getAttribute("aria-disabled") === "true") return;
        handOver();
        strip.scrollBy({ left: Number(button.dataset.arrow) * step(), behavior: "smooth" });
      });
    strip.addEventListener("scroll", ends, { passive: true });
    window.addEventListener("resize", ends);
    ends();
  }
</script>

<style>
  /* The About wave opens the section, so the head sits a --space-l under
     it, as the Programs head sits under its own wave (decision 93). */
  .section {
    padding-top: var(--space-l);
  }

  .head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }

  /* The arrows are for a pointer that hovers (a mouse has no sideways
     scroll of its own); a finger swipes the strip and gets none. */
  .arrows {
    display: none;
    flex: none;
    gap: 0.5rem;
    padding-bottom: 0.2rem; /* on the lede's baseline */
  }

  @media (hover: hover) and (min-width: 36rem) {
    .arrows:not([hidden]) {
      display: flex;
    }
  }

  /* A glass chip, as the tabs and the checklist pill: the ring token on
     the lilac, the purple chevron. */
  /* Sized in rem, no pixel floor: the arrows show only to a pointer that
     hovers, and the page-composition guard wants every box to scale with
     its class. At the smallest desktop-class window they are 34px, over
     the 24px a pointer target needs. */
  .arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    font: inherit;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.72);
    -webkit-backdrop-filter: blur(0.75rem);
    backdrop-filter: blur(0.75rem);
    box-shadow: inset 0 0 0 var(--hairline) var(--rule-strong);
    color: var(--purple);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      opacity 150ms ease;
  }

  @media (hover: hover) {
    .arrow:hover {
      background: var(--purple);
      color: #fff;
    }
  }

  .arrow svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .arrow:active {
    transform: translateY(1px);
  }

  .arrow[aria-disabled="true"] {
    opacity: 0.35;
    cursor: default;
  }

  @media (hover: hover) {
    .arrow[aria-disabled="true"]:hover {
      background: rgb(255 255 255 / 0.72);
      color: var(--purple);
    }
  }

  .arrow:focus-visible {
    outline: max(2px, 0.1875rem) solid var(--focus);
    outline-offset: 0.125rem;
  }

  .head .lede {
    margin-top: var(--space-s);
  }

  /* The strip bleeds to the screen's edges and dissolves there, as the
     program jump strip does, so a photo cut by the screen fades rather
     than chops. */
  .moments {
    display: flex;
    gap: var(--space-s);
    padding: 0 var(--gutter) var(--space-xs);
    margin: 0 calc(-1 * var(--gutter));
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    -webkit-overflow-scrolling: touch;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--gutter),
      #000 calc(100% - var(--gutter)),
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--gutter),
      #000 calc(100% - var(--gutter)),
      transparent
    );
  }

  /* While the pan drives the strip, no snap pulls at it. */
  .moments.is-panning {
    scroll-snap-type: none;
  }

  .moments::-webkit-scrollbar {
    display: none;
  }

  /* The ring sits inside the row's own padding, so the fading edges keep
     their room; the mask would clip a ring drawn outside. */
  .moments:focus-visible {
    outline: max(2px, 0.1875rem) solid var(--focus);
    outline-offset: calc(-1 * max(2px, 0.1875rem));
    border-radius: var(--r-img);
  }

  li {
    flex: 0 0 min(80%, 20rem);
    scroll-snap-align: start;
  }

  /* The photos are rimmed and lifted like the surfaces. */
  li :global(.photo) {
    box-shadow:
      0 0 0 var(--hairline) rgb(160 108 255 / 0.4),
      0 0 0 calc(var(--hairline) * 2) rgb(255 255 255 / 0.6),
      0 1rem 2.5rem rgb(27 15 46 / 0.12);
  }
</style>
