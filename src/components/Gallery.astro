---
import { gallery, gallerySection } from "../data/site";
import Photo from "./Photo.astro";

// A strip needs enough photos to read as one; fewer than four looks unfinished.
const show = gallery.length >= 4;
---

{show && (
  <section
    class="section section--lilac ground ground--lilac"
    id="gallery"
    aria-labelledby="gallery-title"
  >
    <div class="wrap">
      <div class="head-row">
        <header class="head">
          <span class="eyebrow">{gallerySection.eyebrow}</span>
          <h2 id="gallery-title">{gallerySection.heading}</h2>
        </header>
        {/* For a mouse, which has no sideways scroll of its own: a photo back
            or forward. Shown where a pointer hovers; hidden without JavaScript,
            which is what moves the strip. */}
        <div class="arrows" data-arrows hidden>
          <button type="button" class="arrow" data-arrow="-1" aria-label="Previous photos">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M15 5l-7 7 7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <button type="button" class="arrow" data-arrow="1" aria-label="Next photos">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M9 5l7 7-7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      </div>
      {/* The row scrolls sideways and holds no links, so it takes focus
          itself: keyboard readers reach it with Tab and move it with the
          arrow keys (axe's scrollable-region rule). Its name is the heading. */}
      <ul class="moments" tabindex="0" aria-labelledby="gallery-title" data-moments>
        {gallery.map((photo) => (
          <li>
            <Photo photo={photo} ratio="4 / 5" sizes="(min-width: 40rem) 320px, 80vw" />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<script>
  import { glide } from "../data/glide.ts";

  // The strip pans on its own while it is on screen: end to end and back,
  // easing into each turn, so every photo crosses the screen without a hand
  // on it (decisions 94, 96 and 101; the pan itself is src/data/glide.ts).
  const strip = document.querySelector<HTMLElement>("[data-moments]");
  /** Told where the pan shows the strip, each frame it moves. */
  let onPan = (_x: number) => {};
  const pan = strip ? glide(strip, { speed: 107.5, onPan: (x) => onPan(x) }) : null;
  const handOver = () => pan?.handOver();

  // The arrows: one photo (a card and its gap) back or forward, smoothly,
  // and the pan steps aside as for any hand. Each arrow goes quiet at its
  // end of the strip.
  const arrows = document.querySelector<HTMLElement>("[data-arrows]");
  if (strip && arrows) {
    arrows.hidden = false;
    const buttons = Array.from(arrows.querySelectorAll<HTMLButtonElement>("[data-arrow]"));
    const step = () => {
      const first = strip.querySelector<HTMLElement>("li");
      return first
        ? first.getBoundingClientRect().width + parseFloat(getComputedStyle(strip).gap)
        : 320;
    };
    const ends = (x = strip.scrollLeft) => {
      const end = strip.scrollWidth - strip.clientWidth;
      for (const button of buttons) {
        const dir = Number(button.dataset.arrow);
        const at = String(dir < 0 ? x <= 1 : x >= end - 1);
        if (button.getAttribute("aria-disabled") !== at) button.setAttribute("aria-disabled", at);
      }
    };
    onPan = ends;
    for (const button of buttons)
      button.addEventListener("click", () => {
        handOver();
        ends();
        if (button.getAttribute("aria-disabled") === "true") return;
        strip.scrollBy({ left: Number(button.dataset.arrow) * step(), behavior: "smooth" });
      });
    strip.addEventListener("scroll", () => ends(), { passive: true });
    window.addEventListener("resize", () => ends());
    ends();
  }
</script>

<style>
  /* The About wave opens the section, so the head sits a --space-l under
     it, as the Programs head sits under its own wave (decision 93). */
  .section {
    padding-top: var(--space-l);
  }

  .head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }

  /* The arrows are for a pointer that hovers (a mouse has no sideways
     scroll of its own); a finger swipes the strip and gets none. */
  .arrows {
    display: none;
    flex: none;
    gap: 0.5rem;
  }

  @media (hover: hover) and (min-width: 36rem) {
    .arrows:not([hidden]) {
      display: flex;
    }
  }

  /* A glass chip, as the tabs and the checklist pill: the ring token on
     the lilac, the purple chevron. */
  /* Sized in rem, no pixel floor: the arrows show only to a pointer that
     hovers, and the page-composition guard wants every box to scale with
     its class. At the smallest desktop-class window they are 34px, over
     the 24px a pointer target needs. */
  .arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    font: inherit;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.72);
    -webkit-backdrop-filter: blur(0.75rem);
    backdrop-filter: blur(0.75rem);
    box-shadow: inset 0 0 0 var(--hairline) var(--rule-strong);
    color: var(--purple);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      opacity 150ms ease;
  }

  @media (hover: hover) {
    .arrow:hover {
      background: var(--purple);
      color: #fff;
    }
  }

  .arrow svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .arrow:active {
    transform: translateY(1px);
  }

  .arrow[aria-disabled="true"] {
    opacity: 0.35;
    cursor: default;
  }

  @media (hover: hover) {
    .arrow[aria-disabled="true"]:hover {
      background: rgb(255 255 255 / 0.72);
      color: var(--purple);
    }
  }

  .arrow:focus-visible {
    outline: max(2px, 0.1875rem) solid var(--focus);
    outline-offset: 0.125rem;
  }

  /* The strip bleeds to the screen's edges and dissolves there, as the
     program jump strip does, so a photo cut by the screen fades rather
     than chops. */
  .moments {
    display: flex;
    gap: var(--space-s);
    padding: 0 var(--gutter) var(--space-xs);
    margin: 0 calc(-1 * var(--gutter));
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    -webkit-overflow-scrolling: touch;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--gutter),
      #000 calc(100% - var(--gutter)),
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--gutter),
      #000 calc(100% - var(--gutter)),
      transparent
    );
  }

  /* While the pan drives the strip, no snap pulls at it. */
  .moments.is-panning {
    scroll-snap-type: none;
  }

  /* The pan's glide: every photo moves by the same transform, on the
     compositor, in fractions of a pixel (decision 96). */
  .moments.is-gliding > li {
    transform: translate3d(calc(var(--pan, 0) * -1px), 0, 0);
    will-change: transform;
  }

  .moments::-webkit-scrollbar {
    display: none;
  }

  /* The ring sits inside the row's own padding, so the fading edges keep
     their room; the mask would clip a ring drawn outside. */
  .moments:focus-visible {
    outline: max(2px, 0.1875rem) solid var(--focus);
    outline-offset: calc(-1 * max(2px, 0.1875rem));
    border-radius: var(--r-img);
  }

  li {
    flex: 0 0 min(80%, 20rem);
    scroll-snap-align: start;
  }

  /* The photos are rimmed and lifted like the surfaces. */
  li :global(.photo) {
    box-shadow:
      0 0 0 var(--hairline) rgb(160 108 255 / 0.4),
      0 0 0 calc(var(--hairline) * 2) rgb(255 255 255 / 0.6),
      0 1rem 2.5rem rgb(27 15 46 / 0.12);
  }
</style>
