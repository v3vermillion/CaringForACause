---
import { gallery } from "../data/site";
import Photo from "./Photo.astro";
---

{gallery.length > 0 && (
  <section class="section section--lilac" aria-labelledby="gallery-title">
    <div class="wrap">
      <h2 id="gallery-title">Moments from our programs</h2>
      <ul class="strip">
        {gallery.map((photo) => (
          <li>
            <Photo photo={photo} ratio="4 / 5" sizes="(min-width: 40rem) 320px, 80vw" />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  h2 {
    margin-bottom: var(--space-m);
  }

  .strip {
    display: flex;
    gap: var(--space-s);
    padding: 0 0 var(--space-xs);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  li {
    flex: 0 0 min(80%, 320px);
    scroll-snap-align: start;
  }
</style>
