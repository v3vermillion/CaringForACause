---
import { claim, show } from "../data/facts.ts";
import { contact, facts, navigation } from "../data/site";

const phone = show(facts.phone);
const email = show(facts.email);
---

<section id="contact" class="section ground" aria-labelledby="contact-title">
  <div class="wrap grid">
    <header>
      <span class="eyebrow">{contact.eyebrow}</span>
      <h2 id="contact-title">{contact.heading}</h2>
      <p class="lede">{contact.intro}</p>
      <p class="where">
        Based in {show(facts.city).split(",")[0]}, serving {claim(facts.serviceArea)}.
      </p>
    </header>

    <ul class="cards">
      <li>
        <a class="card surface" href={phone.href}>
          <span class="card-icon">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                transform="translate(-2.6 -2.2) scale(1.2)"
                d="M8.6 3.8 10 7.1a1.3 1.3 0 0 1-.4 1.5l-1.4 1a12.4 12.4 0 0 0 5.2 5.2l1-1.4a1.3 1.3 0 0 1 1.5-.4l3.3 1.4a1.3 1.3 0 0 1 .8 1.4l-.4 2.2a1.6 1.6 0 0 1-1.7 1.3A16.3 16.3 0 0 1 3.8 5.1 1.6 1.6 0 0 1 5.1 3.4l2.2-.4a1.3 1.3 0 0 1 1.3.8Z"
              ></path>
            </svg>
          </span>
          <span class="card-words">
            <span class="card-label">Call</span>
            <span class="card-value">{phone.display}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="card surface" href={`mailto:${email}`}>
          <span class="card-icon">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="1.5" y="3.4" width="21" height="17.2" rx="2.6"></rect>
              <path d="m2.4 5.6 8.4 6.2a2 2 0 0 0 2.4 0l8.4-6.2"></path>
            </svg>
          </span>
          <span class="card-words">
            <span class="card-label">Email</span>
            <span class="card-value card-email">
              {email.split("@")[0]}
              <wbr />@{email.split("@")[1]}
            </span>
          </span>
        </a>
      </li>
      <li>
        <a class="card surface" href={show(facts.facebook)} target="_blank" rel="noopener">
          <span class="card-icon">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="1.5" y="1.5" width="21" height="21" rx="4.2"></rect>
              <path d="M15.6 6.4h-1.8a2.6 2.6 0 0 0-2.6 2.6V22.5M8.6 12.6h5.6"></path>
            </svg>
          </span>
          <span class="card-words">
            <span class="card-label">Facebook</span>
            <span class="card-value">Message or follow us</span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </span>
        </a>
      </li>
      <li>
        <a class="card card--signal surface surface--night" href={navigation.help.href}>
          <span class="card-icon">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4 12h16M13 5l7 7-7 7"></path>
            </svg>
          </span>
          <span class="card-words">
            <span class="card-label">Need help?</span>
            <span class="card-value">Start an application</span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-l);
  }

  header .lede {
    margin-top: var(--space-s);
  }

  .where {
    margin-top: var(--space-s);
    color: var(--muted);
  }

  .cards {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cards li {
    display: grid; /* the card fills its row, so a row's cards share a bottom edge */
  }

  /* Surfaces (global.css), with the program tiles' lighter shadow; the rim
     turns purple under the pointer. */
  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    min-height: max(44px, 2.75rem);
    padding: 1.125rem 1.25rem;
    box-shadow:
      0 0.75rem 2rem rgb(27 15 46 / 0.06),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  .card:hover::before {
    background: var(--purple);
  }

  .card:hover {
    box-shadow:
      0 1rem 2.5rem rgb(27 15 46 / 0.1),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    transform: translateY(-2px);
  }

  /* Each card's glyph, the footer's line icons, in a lit disc. */
  .card-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: linear-gradient(135deg, rgb(160 108 255 / 0.22), rgb(255 90 134 / 0.16));
    box-shadow: inset 0 0 0 var(--hairline) rgb(96 8 215 / 0.14);
    transition: background-color 150ms ease;
  }

  .glyph {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: var(--purple);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card:hover .card-icon {
    background: var(--purple);
  }

  .card:hover .glyph {
    stroke: #fff;
  }

  .card--signal .card-icon {
    background: linear-gradient(135deg, rgb(255 255 255 / 0.14), rgb(255 90 134 / 0.22));
    box-shadow: inset 0 0 0 var(--hairline) rgb(255 255 255 / 0.18);
  }

  .card--signal .glyph {
    stroke: #fff;
  }

  .card--signal:hover .card-icon {
    background: var(--signal);
  }

  .card-words {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .card-label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--purple);
  }

  .card-value {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 750;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .card-email {
    font-size: var(--step-0);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .card--signal {
    box-shadow:
      0 1rem 2.5rem rgb(27 15 46 / 0.25),
      inset 0 1px 0 rgb(255 255 255 / 0.14);
    color: #fff;
  }

  .card--signal .card-label {
    color: var(--night-soft);
  }

  .card--signal:hover::before {
    background: var(--signal);
  }

  .card--signal:hover {
    box-shadow:
      0 1.25rem 3rem rgb(27 15 46 / 0.3),
      inset 0 1px 0 rgb(255 255 255 / 0.14);
  }

  /* Pressed: the card settles flat. After every hover rule, so it wins on
     the night card too. */
  .card:active {
    transform: translateY(0);
    box-shadow: none;
    transition-duration: 60ms;
  }

  @media (min-width: 36rem) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* The cards take two thirds of the column on desktop, so the email address
     sits on one line and the four cards are one height. */
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 4fr 8fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }
</style>
