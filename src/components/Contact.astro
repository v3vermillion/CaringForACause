---
import { claim, show } from "../data/facts.ts";
import { contact, facts, navigation } from "../data/site";

const phone = show(facts.phone);
const email = show(facts.email);
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="wrap grid">
    <header>
      <span class="eyebrow">{contact.eyebrow}</span>
      <h2 id="contact-title">{contact.heading}</h2>
      <p class="lede">{contact.intro}</p>
      <p class="where">
        Based in {show(facts.city).split(",")[0]}, serving {claim(facts.serviceArea)}.
      </p>
    </header>

    <ul class="cards">
      <li>
        <a class="card" href={phone.href}>
          <span class="card-label">Call</span>
          <span class="card-value">{phone.display}</span>
        </a>
      </li>
      <li>
        <a class="card" href={`mailto:${email}`}>
          <span class="card-label">Email</span>
          <span class="card-value card-email">
            {email.split("@")[0]}
            <wbr />@{email.split("@")[1]}
          </span>
        </a>
      </li>
      <li>
        <a class="card" href={show(facts.facebook)} target="_blank" rel="noopener">
          <span class="card-label">Facebook</span>
          <span class="card-value">Message or follow us</span>
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </li>
      <li>
        <a class="card card--signal" href={navigation.help.href}>
          <span class="card-label">Need help?</span>
          <span class="card-value">Start an application</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-l);
  }

  header .lede {
    margin-top: var(--space-s);
  }

  .where {
    margin-top: var(--space-s);
    color: var(--muted);
  }

  .cards {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cards li {
    display: grid; /* the card fills its row, so a row's cards share a bottom edge */
  }

  .card {
    display: grid;
    gap: 0.2rem;
    min-height: max(44px, 2.75rem);
    padding: 1rem 1.25rem;
    /* The program tiles' frame: a hairline ring and a soft shadow. The
       transparent border holds the box, so nothing moves. */
    border: var(--hairline) solid transparent;
    border-radius: var(--r-card);
    background: #fff;
    box-shadow:
      0 0 0 var(--hairline) rgb(96 8 215 / 0.08),
      0 0.75rem 2rem rgb(27 15 46 / 0.06);
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  .card:hover {
    box-shadow:
      0 0 0 var(--hairline) var(--purple),
      0 1rem 2.5rem rgb(27 15 46 / 0.1);
    transform: translateY(-2px);
  }

  .card-label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--purple);
  }

  .card-value {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 750;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .card-email {
    font-size: var(--step-0);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .card--signal {
    background:
      radial-gradient(70% 60% at 100% 0%, rgb(96 8 215 / 0.35), transparent 60%), var(--night);
    box-shadow:
      0 0 0 var(--hairline) rgb(255 255 255 / 0.12),
      0 1rem 2.5rem rgb(27 15 46 / 0.25);
    color: #fff;
  }

  .card--signal .card-label {
    color: var(--night-soft);
  }

  .card--signal:hover {
    box-shadow:
      0 0 0 var(--hairline) var(--signal),
      0 1.25rem 3rem rgb(27 15 46 / 0.3);
  }

  /* Pressed: the card settles flat. After every hover rule, so it wins on
     the night card too. */
  .card:active {
    transform: translateY(0);
    box-shadow: none;
    transition-duration: 60ms;
  }

  @media (min-width: 36rem) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* The cards take two thirds of the column on desktop, so the email address
     sits on one line and the four cards are one height. */
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 4fr 8fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }
</style>
