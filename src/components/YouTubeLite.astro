---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { YouTubeVideo } from "../data/site";

type Props = { video: YouTubeVideo };
const { video } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${video.id}`;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const poster = files[`../assets/photos/${video.poster}`]?.default;
if (!poster) {
  throw new Error(`Video poster not found: src/assets/photos/${video.poster}`);
}
---

<!--
  Shows a self-hosted poster until tapped, so pages stay fast and YouTube
  sets no cookies (and serves no images) before a visitor chooses to play.
  Without JavaScript, the link opens the video on YouTube.
-->
<div class="yt" data-yt-id={video.id} data-yt-title={video.title}>
  <a href={watchUrl} class="yt-link">
    <Picture
      src={poster}
      formats={["avif", "webp"]}
      alt=""
      widths={[480, 720, 1080].filter((w) => w <= poster.width)}
      sizes="(min-width: 56rem) 620px, (min-width: 36rem) 52vw, calc(100vw - 2.5rem)"
      loading="lazy"
      decoding="async"
      style={`object-position: ${video.posterFocus ?? "center"};`}
    />
    <span class="yt-play" aria-hidden="true"></span>
    <span class="visually-hidden">Play video: {video.title}</span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".yt").forEach((el) => {
    const link = el.querySelector("a");
    link?.addEventListener("click", (event) => {
      event.preventDefault();
      if (el.classList.contains("is-loading")) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.ytId}?autoplay=1&rel=0`;
      iframe.title = el.dataset.ytTitle ?? "Video";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      // The poster stays under the player while it loads, with a turning
      // ring where the play button was; once the frame has loaded, the
      // poster and its link go. (A browser can fire load for the frame's
      // empty first document before YouTube's page; that one is skipped:
      // YouTube's document is cross-origin, so it reads as null here.)
      el.classList.add("is-loading");
      const loaded = () => {
        if (iframe.contentDocument?.URL === "about:blank") return;
        iframe.removeEventListener("load", loaded);
        el.classList.remove("is-loading");
        link.remove();
      };
      iframe.addEventListener("load", loaded);
      el.append(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .yt {
    position: relative;
    isolation: isolate;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--r-img);
    background: var(--night);
  }

  .yt-link,
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* The player sits over the poster, see-through until its page paints. */
  .yt :global(iframe) {
    z-index: 1;
    background: transparent;
  }

  .yt-link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--crimson);
    box-shadow: 0 0 0 0.375rem rgb(255 255 255 / 0.85);
  }

  .yt-play::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 0.8125rem 0 0.8125rem 1.375rem;
    border-color: transparent transparent transparent #fff;
  }

  .yt-link:hover .yt-play {
    background: #950009;
  }

  /* While the player loads: the play button becomes a ring that turns
     above the frame (under reduced motion the global rule holds it still),
     and the link under the frame takes no taps. */
  .yt.is-loading .yt-link {
    pointer-events: none;
  }

  .yt.is-loading .yt-play {
    z-index: 2;
    background: transparent;
    box-shadow: none;
  }

  .yt.is-loading .yt-play::after {
    inset: 0;
    margin: auto;
    width: 2.5rem;
    height: 2.5rem;
    transform: none;
    border: 0.25rem solid rgb(255 255 255 / 0.35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 900ms linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }
</style>
