---
import { claim } from "../data/facts.ts";
import { facts } from "../data/site";

const items = [
  `Serving ${claim(facts.serviceArea)} since ${claim(facts.founded)}`,
  `${claim(facts.taxExempt).section} nonprofit, EIN ${claim(facts.ein)}`,
  `Partnered with ${claim(facts.toysForTotsPartner)}`,
];
---

<section class="facts" aria-label="About our organization">
  <ul class="wrap">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</section>

<style>
  .facts {
    border-bottom: 1px solid var(--rule);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-m);
    padding-inline: 0;
    list-style: none;
    color: var(--muted);
    font-weight: 700;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  li::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--crimson);
    flex: none;
  }
</style>
