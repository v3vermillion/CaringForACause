---
import { claim } from "../data/facts.ts";
import { facts } from "../data/site";

const items = [
  `Helping families since ${claim(facts.founded)}`,
  `${claim(facts.taxExempt).section} nonprofit, EIN ${claim(facts.ein)}`,
  `Partnered with ${claim(facts.toysForTotsPartner)}`,
];
---

<!-- Proof in one line, on the night band the banner's wave lands on. Its
     height on desktop is part of --strips-h (src/styles/global.css); keep
     them in step: the two borders count, so they stay even where one is
     invisible. -->
<section class="facts on-dark" aria-label="About our organization">
  <div class="wrap">
    <ul>
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .facts {
    background: var(--night);
    /* Both edges are invisible: the band under the banner is one surface
       between the two waves. The borders keep --strips-h's arithmetic. */
    border-top: 1px solid transparent;
    border-bottom: 1px solid transparent;
  }

  /* Sized in the class's reference pixel (--rp) so every phone and every
     tablet shows the same strip; on desktop --rp is 1px. */
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(8 * var(--sp)) 0;
    padding: calc(16 * var(--sp)) 0;
    margin: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-inline: calc(24 * var(--sp));
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(14.4 * var(--sp));
    color: var(--night-soft);
    text-align: center;
  }

  /* Hairline dividers between items, only on desktop where the three share
     one row; on phones and tablets they wrap, and a divider would float.
     Lit violet to rose, like the rules of her references. */
  @media (min-width: 56rem) {
    li + li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.35em;
      bottom: 0.35em;
      width: 1px;
      background: linear-gradient(
        180deg,
        rgb(160 108 255 / 0.2),
        #a06cff 50%,
        rgb(224 72 154 / 0.3)
      );
    }
  }
</style>
