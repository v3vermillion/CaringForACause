---
import { claim } from "../data/facts.ts";
import { facts } from "../data/site";

const items = [
  `Serving ${claim(facts.serviceArea)} since ${claim(facts.founded)}`,
  `${claim(facts.taxExempt).section} nonprofit, EIN ${claim(facts.ein)}`,
  `Partnered with ${claim(facts.toysForTotsPartner)}`,
];
---

<section class="facts" aria-label="About our organization">
  <ul class="wrap">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</section>

<style>
  .facts {
    background: #150b26;
    color: #fff;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding-block: var(--space-m);
    padding-inline: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.07);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14);
    color: #e3daf6;
    font-size: var(--step--1);
    font-weight: 700;
  }

  li::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #ff5a63;
    flex: none;
  }
</style>
