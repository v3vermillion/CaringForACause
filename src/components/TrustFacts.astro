---
import { claim } from "../data/facts.ts";
import { facts } from "../data/site";

const items = [
  `Helping families since ${claim(facts.founded)}`,
  `${claim(facts.taxExempt).section} nonprofit, EIN ${claim(facts.ein)}`,
  `Partnered with ${claim(facts.toysForTotsPartner)}`,
];
---

<!-- Proof in one line, on the same night ground as the banner. -->
<section class="facts on-dark" aria-label="About our organization">
  <div class="wrap">
    <ul>
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .facts {
    background: var(--night);
    border-top: 1px solid rgb(255 255 255 / 0.1);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0;
    padding: var(--space-s) 0;
    margin: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-inline: var(--space-m);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--night-soft);
    text-align: center;
  }

  /* Hairline dividers between items, only when they share a row. */
  @media (min-width: 48rem) {
    li + li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.35em;
      bottom: 0.35em;
      width: 1px;
      background: rgb(255 255 255 / 0.25);
    }
  }
</style>
