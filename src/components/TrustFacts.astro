---
import { claim } from "../data/facts.ts";
import { facts } from "../data/site";

const items = [
  `Helping families since ${claim(facts.founded)}`,
  `${claim(facts.taxExempt).section} nonprofit, EIN ${claim(facts.ein)}`,
  `Partnered with ${claim(facts.toysForTotsPartner)}`,
];
---

<!-- Proof in one line, on the same night ground as the banner. Its height on
     desktop is part of --strips-h (src/styles/global.css); keep them in step. -->
<section class="facts on-dark" aria-label="About our organization">
  <div class="wrap">
    <ul>
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .facts {
    background: var(--night);
    border-top: 1px solid rgb(255 255 255 / 0.1);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  /* Sized in the class's reference pixel (--rp) so every phone and every
     tablet shows the same strip; on desktop --rp is 1px. */
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(8 * var(--sp)) 0;
    padding: calc(16 * var(--sp)) 0;
    margin: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-inline: calc(24 * var(--sp));
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(14.4 * var(--sp));
    color: var(--night-soft);
    text-align: center;
  }

  /* Hairline dividers between items, only on desktop where the three share
     one row; on phones and tablets they wrap, and a divider would float. */
  @media (min-width: 56rem) {
    li + li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.35em;
      bottom: 0.35em;
      width: 1px;
      background: rgb(255 255 255 / 0.25);
    }
  }
</style>
