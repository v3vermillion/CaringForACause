---
import { intro } from "../data/site";
---

<!-- The welcome: a full-screen sequence on the first visit to the home page,
     never again in that browser (decision 87). The markup is hidden unless
     JavaScript is on (the "js" class the layout sets), so a visitor without
     scripts is never covered. The script below runs right after this markup,
     before the page behind it paints, so a returning visitor never sees it. -->
<div
  class="welcome"
  id="intro"
  role="dialog"
  aria-modal="true"
  aria-label={intro.label}
  data-key={intro.storageKey}
>
  <div class="glow" aria-hidden="true"></div>
  <div class="stage" aria-live="polite">
    {intro.slides.map((slide) => (
      <div
        class:list={["slide", { large: "large" in slide && slide.large }]}
        data-hold={slide.hold}
      >
        {slide.lines.map((line, i) => (
          <p class:list={["line", { accent: "accent" in line && line.accent }]} style={`--i:${i}`}>
            {line.text}
          </p>
        ))}
      </div>
    ))}
  </div>
  <button type="button" class="skip" id="introSkip">
    {intro.skip}
  </button>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById("intro");
    if (!root) return;
    var KEY = root.getAttribute("data-key");

    // localStorage keeps it once per browser; where that is blocked (some
    // private windows), sessionStorage keeps it once per visit.
    function read() {
      try {
        if (localStorage.getItem(KEY)) return true;
      } catch (e) {}
      try {
        return !!sessionStorage.getItem(KEY);
      } catch (e) {}
      return false;
    }
    function mark() {
      try {
        localStorage.setItem(KEY, "1");
        return;
      } catch (e) {}
      try {
        sessionStorage.setItem(KEY, "1");
      } catch (e) {}
    }

    if (read()) {
      root.remove();
      return;
    }

    var slides = Array.prototype.slice.call(root.querySelectorAll(".slide"));
    var FADE = 800; // a slide's fade in; the next begins as the last fades out
    var held = [];
    var done = false;
    var current = -1;
    var timer = 0;
    var ceiling = 0;
    var total = 0;
    slides.forEach(function (s) {
      total += FADE + Number(s.getAttribute("data-hold"));
    });

    // The page behind is inert while the welcome is up, so nothing in it
    // takes focus or is read out.
    Array.prototype.forEach.call(document.body.children, function (el) {
      if (el !== root && el.tagName !== "SCRIPT" && !el.inert) {
        el.inert = true;
        held.push(el);
      }
    });

    function finish() {
      if (done) return;
      done = true;
      clearTimeout(timer);
      clearTimeout(ceiling);
      mark();
      root.classList.add("leaving");
      held.forEach(function (el) {
        el.inert = false;
      });
      setTimeout(function () {
        root.remove();
      }, 1100);
    }

    function run(i) {
      if (done) return;
      if (i >= slides.length) return finish();
      current = i;
      var slide = slides[i];
      slide.classList.remove("out");
      slide.classList.add("vis");
      timer = setTimeout(
        function () {
          if (i === slides.length - 1) return finish();
          slide.classList.remove("vis");
          slide.classList.add("out");
          setTimeout(function () {
            slide.classList.remove("out");
          }, 700);
          run(i + 1);
        },
        FADE + Number(slide.getAttribute("data-hold")),
      );
    }

    document.getElementById("introSkip").addEventListener("click", finish);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") finish();
    });
    // Nothing behind the welcome scrolls under a finger or a wheel.
    function stop(e) {
      e.preventDefault();
    }
    root.addEventListener("wheel", stop, { passive: false });
    root.addEventListener("touchmove", stop, { passive: false });

    // A hidden tab pauses it; coming back replays the slide it was on, so
    // nothing is read in the background.
    document.addEventListener("visibilitychange", function () {
      if (done || current < 0) return;
      if (document.hidden) {
        clearTimeout(timer);
      } else {
        slides[current].classList.remove("vis", "out");
        run(current);
      }
    });

    // Never stuck: whatever happens, the welcome is gone a few seconds after
    // it should have ended (the stylesheet has a second, later backstop).
    ceiling = setTimeout(finish, total + 4000);

    // Begin once the serif is ready, so no line is drawn in a fallback face
    // and then redrawn; a slow font costs at most a second and a half.
    var started = false;
    function begin() {
      if (started) return;
      started = true;
      setTimeout(function () {
        run(0);
      }, 400);
    }
    setTimeout(begin, 1500);
    if (document.fonts && document.fonts.load) {
      document.fonts.load('700 1em "Site Serif"').then(begin, begin);
    } else {
      begin();
    }
  })();
</script>

<style is:global>
  /* Hidden unless scripts run: the layout adds "js" before the first paint. */
  .welcome {
    display: none;
  }

  .js .welcome {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem max(1.5rem, 6vw);
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
    color: #fff;
    /* The night, lit from behind the words: a violet well fading to the
       banner's night and then to near black, with no edge to show. */
    background: radial-gradient(
      ellipse 120% 100% at 50% 46%,
      #2d1858 0%,
      var(--night) 46%,
      #0f0819 84%,
      #07040d 100%
    );
    opacity: 1;
    transition: opacity 1s ease;
    /* The last backstop if the script never finishes. */
    animation: intro-backstop 1s linear 50s forwards;
  }

  /* The night grain (decision 63) over the gradients: it dithers them, so the
     light has no visible rings or steps on 8-bit screens. */
  .welcome::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    opacity: 0.7;
    pointer-events: none;
  }

  .welcome.leaving {
    opacity: 0;
    pointer-events: none;
  }

  @keyframes intro-backstop {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* The light behind the words: gradients only (a blur filter or a shadow on
     clipped text paints boxes on some engines), breathing slowly. */
  .welcome .glow {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(46rem, 130%);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(140 80 245 / 0.36) 0%,
      rgb(132 72 240 / 0.28) 16%,
      rgb(118 56 232 / 0.19) 34%,
      rgb(104 36 222 / 0.11) 52%,
      rgb(96 8 215 / 0.05) 70%,
      rgb(96 8 215 / 0.015) 86%,
      rgb(96 8 215 / 0) 100%
    );
    pointer-events: none;
    animation: intro-breathe 7s ease-in-out infinite;
  }

  @keyframes intro-breathe {
    0%,
    100% {
      opacity: 0.75;
      transform: translate(-50%, -50%) scale(0.94);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.04);
    }
  }

  .welcome .stage {
    position: relative;
    display: grid;
    width: 100%;
    max-width: 44rem;
    /* A little above centre, where the eye rests. */
    margin-bottom: 4vw;
  }

  /* Each slide carries its own broad bloom: a gradient that reaches nothing
     at its edge, breathing while the slide is up. */
  .welcome .slide {
    position: relative;
  }

  .welcome .slide::before {
    content: "";
    position: absolute;
    inset: -90% -25%;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      rgb(176 120 255 / 0.3) 0%,
      rgb(150 90 250 / 0.2) 30%,
      rgb(124 60 235 / 0.1) 58%,
      rgb(110 40 225 / 0.03) 82%,
      rgb(110 40 225 / 0) 100%
    );
    pointer-events: none;
  }

  .welcome .slide.vis::before {
    animation: welcome-halo 4.5s ease-in-out infinite;
  }

  @keyframes welcome-halo {
    0%,
    100% {
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
  }

  /* Every slide sits in the same cell, so a change never moves the layout. */
  .welcome .slide {
    grid-area: 1 / 1;
    align-self: center;
    text-align: center;
    opacity: 0;
    visibility: hidden;
  }

  .welcome .slide.vis {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.8s ease;
  }

  .welcome .slide.out {
    opacity: 0;
    visibility: visible;
    transition:
      opacity 0.7s ease,
      visibility 0s 0.7s;
  }

  /* The words: the banner's serif, bold, white, with a soft violet light.
     Plain colour, never clipped to the text, so the glow stays crisp. */
  .welcome .line {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1.2;
    letter-spacing: -0.012em;
    text-wrap: balance;
    color: #fff;
    text-shadow:
      0 0 0.1em rgb(225 205 255 / 0.8),
      0 0 0.28em rgb(180 125 255 / 0.7),
      0 0 0.65em rgb(135 75 245 / 0.55);
    opacity: 0;
    transform: translateY(0.4em);
    transition:
      opacity 0.9s ease,
      transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .welcome .line + .line {
    margin-top: 0.5em;
  }

  .welcome .slide.vis .line {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 0.75s + 0.1s);
  }

  .welcome .slide.out .line {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .welcome .line.accent {
    font-style: italic;
    color: #e6d8ff;
  }

  /* The single-word screens are the largest. */
  .welcome .slide.large .line {
    font-size: calc(var(--step-4) * 1.35);
    line-height: 1.1;
  }

  .welcome .skip {
    position: absolute;
    left: 50%;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 1;
    min-height: max(44px, 2.75rem);
    padding: 0.6rem 1.75rem;
    border: 0;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.06);
    box-shadow: 0 0 0 max(1px, 0.0625rem) rgb(226 214 255 / 0.4) inset;
    color: #e2d6ff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .welcome .skip:hover {
    background: rgb(255 255 255 / 0.14);
    box-shadow: 0 0 0 max(1px, 0.09rem) rgb(226 214 255 / 0.85) inset;
  }

  .welcome .skip:focus-visible {
    outline: 0.15rem solid #fff;
    outline-offset: 0.2rem;
  }

  @media (min-width: 56rem) {
    .welcome .line {
      font-size: calc(var(--step-4) * 1.1);
    }

    .welcome .stage {
      margin-bottom: 2vw;
    }
  }

  /* Reduced motion: the same words and timing, with no movement and no
     breathing light; each line simply fades. */
  @media (prefers-reduced-motion: reduce) {
    .welcome .glow,
    .welcome .slide.vis::before {
      animation: none;
    }

    .welcome .line,
    .welcome .slide.vis .line {
      transform: none;
      transition-duration: 0.4s;
    }
  }
</style>
