      <linearGradient id={`${id}-edge`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#ffd6e6" stop-opacity="0.7" />
        <stop offset="0.45" stop-color="#ffc2ec" stop-opacity="0.4" />
        <stop offset="0.7" stop-color="#e0c0ff" stop-opacity="0.15" />
        <stop offset="1" stop-color="#b48cff" stop-opacity="0" />
      </linearGradient>
      <linearGradient id={`${id}-seam`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#ff9ab2" stop-opacity="0.7" />
        <stop offset="0.35" stop-color="#ff7aa0" stop-opacity="0.4" />
        <stop offset="0.6" stop-color="#ff7aa0" stop-opacity="0" />
      </linearGradient>
      <linearGradient id={`${id}-light`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#ff7ab8" />
        <stop offset="0.4" stop-color="#c07cff" />
        <stop offset="1" stop-color="#7a48ff" />
      </linearGradient>
      <clipPath id={`${id}-tclip`}>
