---
/**
 * The wave: two ribbons, violet over crimson, sweeping across the page where
 * one surface hands over to the next, from the owner's reference for the
 * transition under the banner (decision 51). "into-night" descends to the
 * right and lands on night: under the banner it cuts the photo (nothing
 * above), and above the About section it carries the lilac of the section
 * before it. "into-paper" climbs to the right and lifts night off paper.
 * The geometry is drawn once in a 1000 by 100 box and stretched to the box
 * it is given (the parent sets its width and height in the class's
 * reference pixel), so the ribbons cross every screen edge to edge.
 * Decorative: hidden from assistive technology.
 *
 * Every copy on a page needs its own id prefix, because the gradients are
 * referenced by id and a page repeats no id (a test checks).
 *
 * The path data is generated (a base edge as two cubic Bézier segments; each
 * band is that edge and the edge pushed down by a tapering thickness) by
 * scripts/brand/wave-geometry.mjs. Regenerate rather than edit by hand.
 */
type Props = {
  kind: "into-night" | "into-paper";
  /** Unique on the page: the prefix of the gradient ids. */
  id: string;
  /** The surface above the ribbons, as a CSS colour; none means transparent (the photo shows). */
  above?: string;
  class?: string;
};
const { kind, id, above, class: className } = Astro.props;
const A = {
  above: "M0,0L1000,0L1000,46C860,62 700,70 520,66C330,62 180,30 0,26Z",
  night: "M0,80C180,78 330,99 520,88C700,83.8 860,73.7 1000,57L1000,100L0,100Z",
  violet:
    "M0,26C180,30 330,62 520,66C700,70 860,62 1000,46L1000,57C860,73.7 700,83.8 520,83.1C330,82.7 180,52.9 0,50Z",
  violetLit:
    "M0,26C180,30 330,62 520,66C700,70 860,62 1000,46L1000,50.6C860,66.9 700,75.8 520,73.2C330,70.7 180,39.6 0,36.1Z",
  crimson:
    "M0,50C180,52.9 330,82.7 520,83.1C700,83.8 860,73.7 1000,57L1000,57C860,73.7 700,83.8 520,88C330,99 180,78 0,80Z",
  crimsonLit:
    "M0,50C180,52.9 330,82.7 520,83.1C700,83.8 860,73.7 1000,57L1000,57C860,73.7 700,83.8 520,85.2C330,89.5 180,63.4 0,62.6Z",
  edgeTop:
    "M0,24.8C180,28.8 330,60.8 520,64.8C700,68.8 860,60.8 1000,44.8L1000,47.6C860,63.6 700,71.6 520,67.6C330,63.6 180,31.6 0,27.6Z",
  edgeMid:
    "M0,48.8C180,51.7 330,81.5 520,81.9C700,82.6 860,72.5 1000,55.8L1000,58.2C860,74.9 700,85 520,84.3C330,83.9 180,54.1 0,51.2Z",
  glowTop:
    "M0,19C180,23 330,55 520,59C700,63 860,55 1000,39L1000,53C860,69 700,77 520,73C330,69 180,37 0,33Z",
};
const B = {
  night: "M0,0L1000,0L1000,48C860,36 700,26 520,28C330,30 170,60 0,62Z",
  violet:
    "M0,62C170,60 330,30 520,28C700,26 860,36 1000,48L1000,70C860,57.5 700,45.8 520,45.3C330,44.5 170,72.8 0,74Z",
  violetLit:
    "M0,62C170,60 330,30 520,28C700,26 860,36 1000,48L1000,57.2C860,45 700,34.3 520,35.3C330,36.1 170,65.4 0,67Z",
  crimson:
    "M0,74C170,72.8 330,44.5 520,45.3C700,45.8 860,57.5 1000,70L1000,96C860,80.8 700,61.6 520,51.4C330,44.7 170,72.8 0,74Z",
  crimsonLit:
    "M0,74C170,72.8 330,44.5 520,45.3C700,45.8 860,57.5 1000,70L1000,80.9C860,67.3 700,52.5 520,47.9C330,44.6 170,72.8 0,74Z",
  edgeTop:
    "M0,60.8C170,58.8 330,28.8 520,26.8C700,24.8 860,34.8 1000,46.8L1000,49.4C860,37.4 700,27.4 520,29.4C330,31.4 170,61.4 0,63.4Z",
  edgeMid:
    "M0,72.8C170,71.6 330,43.3 520,44.1C700,44.6 860,56.3 1000,68.8L1000,71.2C860,58.7 700,47 520,46.5C330,45.7 170,74 0,75.2Z",
  glowTop:
    "M0,55C170,53 330,23 520,21C700,19 860,29 1000,41L1000,55C860,43 700,33 520,35C330,37 170,67 0,69Z",
  paper: "M0,74C170,72.8 330,44.7 520,51.4C700,61.6 860,80.8 1000,96L1000,100L0,100Z",
};
---

{kind === "into-night" ? (
  <svg
    class:list={["wave", "wave--night", className]}
    viewBox="0 0 1000 100"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id={`${id}-violet`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#a468ff" />
        <stop offset="0.45" stop-color="#6f32dc" />
        <stop offset="1" stop-color="#40169e" />
      </linearGradient>
      <linearGradient id={`${id}-violet-lit`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#d7bcff" stop-opacity="0.55" />
        <stop offset="0.5" stop-color="#b98cff" stop-opacity="0.35" />
        <stop offset="1" stop-color="#8e5cf0" stop-opacity="0.2" />
      </linearGradient>
      <linearGradient id={`${id}-crimson`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#f0304a" />
        <stop offset="0.3" stop-color="#d4143c" />
        <stop offset="0.55" stop-color="#9c0c48" />
        <stop offset="0.74" stop-color="#5a0a48" stop-opacity="0" />
      </linearGradient>
      <linearGradient id={`${id}-crimson-lit`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#ff9aa8" stop-opacity="0.6" />
        <stop offset="0.5" stop-color="#ff6e92" stop-opacity="0.25" />
        <stop offset="0.72" stop-color="#ff6e92" stop-opacity="0" />
      </linearGradient>
      <linearGradient id={`${id}-edge`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#fff0fb" />
        <stop offset="0.5" stop-color="#f0c2ff" />
        <stop offset="1" stop-color="#b48cff" stop-opacity="0.8" />
      </linearGradient>
      <linearGradient id={`${id}-seam`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#ffa3b8" />
        <stop offset="0.55" stop-color="#ff6a90" stop-opacity="0.55" />
        <stop offset="0.75" stop-color="#ff6a90" stop-opacity="0" />
      </linearGradient>
      <filter id={`${id}-glow`} x="-5%" y="-50%" width="110%" height="200%">
        <feGaussianBlur stdDeviation="2.6" />
      </filter>
      <filter id={`${id}-spill`} x="-5%" y="-60%" width="110%" height="220%">
        <feGaussianBlur stdDeviation="5" />
      </filter>
    </defs>
    {above && <path d={A.above} fill={above} />}
    <path d={A.night} fill="#1b0f2e" />
    <path d={A.crimson} fill="#ff2d6e" opacity="0.4" filter={`url(#${id}-spill)`} />
    <path d={A.violet} fill={`url(#${id}-violet)`} />
    <path d={A.violetLit} fill={`url(#${id}-violet-lit)`} />
    <path d={A.crimson} fill={`url(#${id}-crimson)`} />
    <path d={A.crimsonLit} fill={`url(#${id}-crimson-lit)`} />
    <path d={A.glowTop} fill={`url(#${id}-edge)`} opacity="0.32" filter={`url(#${id}-glow)`} />
    <path d={A.edgeTop} fill={`url(#${id}-edge)`} />
    <path d={A.edgeMid} fill={`url(#${id}-seam)`} />
  </svg>
) : (
  <svg
    class:list={["wave", "wave--paper", className]}
    viewBox="0 0 1000 100"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id={`${id}-violet`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#40169e" />
        <stop offset="0.5" stop-color="#6f32dc" />
        <stop offset="1" stop-color="#a468ff" />
      </linearGradient>
      <linearGradient id={`${id}-violet-lit`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#8e5cf0" stop-opacity="0.2" />
        <stop offset="0.5" stop-color="#b98cff" stop-opacity="0.35" />
        <stop offset="1" stop-color="#d7bcff" stop-opacity="0.55" />
      </linearGradient>
      <linearGradient id={`${id}-crimson`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0.26" stop-color="#5a0a48" stop-opacity="0" />
        <stop offset="0.45" stop-color="#9c0c48" />
        <stop offset="0.7" stop-color="#d4143c" />
        <stop offset="1" stop-color="#f0304a" />
      </linearGradient>
      <linearGradient id={`${id}-crimson-lit`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0.28" stop-color="#ff6e92" stop-opacity="0" />
        <stop offset="0.5" stop-color="#ff6e92" stop-opacity="0.25" />
        <stop offset="1" stop-color="#ff9aa8" stop-opacity="0.6" />
      </linearGradient>
      <linearGradient id={`${id}-edge`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#b48cff" stop-opacity="0.8" />
        <stop offset="0.5" stop-color="#f0c2ff" />
        <stop offset="1" stop-color="#fff0fb" />
      </linearGradient>
      <linearGradient id={`${id}-seam`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0.25" stop-color="#ff6a90" stop-opacity="0" />
        <stop offset="0.45" stop-color="#ff6a90" stop-opacity="0.55" />
        <stop offset="1" stop-color="#ffa3b8" />
      </linearGradient>
      <filter id={`${id}-glow`} x="-5%" y="-50%" width="110%" height="200%">
        <feGaussianBlur stdDeviation="2.6" />
      </filter>
      <filter id={`${id}-spill`} x="-5%" y="-60%" width="110%" height="220%">
        <feGaussianBlur stdDeviation="5" />
      </filter>
    </defs>
    <path d={B.night} fill={above ?? "#1b0f2e"} />
    <path d={B.paper} fill="#faf7fd" />
    <path d={B.crimson} fill="#ff2d6e" opacity="0.3" filter={`url(#${id}-spill)`} />
    <path d={B.violet} fill={`url(#${id}-violet)`} />
    <path d={B.violetLit} fill={`url(#${id}-violet-lit)`} />
    <path d={B.crimson} fill={`url(#${id}-crimson)`} />
    <path d={B.crimsonLit} fill={`url(#${id}-crimson-lit)`} />
    <path d={B.glowTop} fill={`url(#${id}-edge)`} opacity="0.32" filter={`url(#${id}-glow)`} />
    <path d={B.edgeTop} fill={`url(#${id}-edge)`} />
    <path d={B.edgeMid} fill={`url(#${id}-seam)`} />
  </svg>
)}

<style is:global>
  .wave {
    display: block;
    width: 100%;
    pointer-events: none;
  }
</style>
