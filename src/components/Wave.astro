{kind === "into-night" ? (
  <div class:list={["wave", "wave--night", className]}>
    {up.ground && <div class={`wave-ground wave-ground--above wave-ground--${up.ground}`} />}
    {down.ground && <div class={`wave-ground wave-ground--below wave-ground--${down.ground}`} />}
    {up.fill && <div class="wave-edge wave-edge--above" style={{ background: up.fill }} />}
    {down.fill && <div class="wave-edge wave-edge--below" style={{ background: down.fill }} />}
    <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id={`${id}-crimson`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#f0304a" />
          <stop offset="0.3" stop-color="#d4143c" />
          <stop offset="0.5" stop-color="#9c0c48" />
          <stop offset="0.64" stop-color="#5a0a48" stop-opacity="0" />
        </linearGradient>
        <linearGradient id={`${id}-crimson-lit`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#ffb3bf" stop-opacity="0.5" />
          <stop offset="0.4" stop-color="#ff7f9e" stop-opacity="0.3" />
          <stop offset="0.62" stop-color="#ff7f9e" stop-opacity="0" />
        </linearGradient>
        <linearGradient id={`${id}-violet`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#5a24c4" />
          <stop offset="0.5" stop-color="#6f32dc" />
          <stop offset="1" stop-color="#4a1ab0" stop-opacity="0.9" />
        </linearGradient>
        <linearGradient id={`${id}-violet-lit`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#c9a6ff" stop-opacity="0.35" />
          <stop offset="0.55" stop-color="#d9c2ff" stop-opacity="0.55" />
          <stop offset="1" stop-color="#b48cff" stop-opacity="0.3" />
        </linearGradient>
        <linearGradient id={`${id}-light`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#ff7ab8" />
          <stop offset="0.4" stop-color="#c07cff" />
          <stop offset="1" stop-color="#7a48ff" />
        </linearGradient>
        <clipPath id={`${id}-tclip`}>
          <path d={A.top} />
        </clipPath>
        <clipPath id={`${id}-uclip`}>
          <path d={A.under} />
        </clipPath>
        <filter id={`${id}-soft`} x="-5%" y="-60%" width="110%" height="220%">
          <feGaussianBlur stdDeviation="2 4" />
        </filter>
        <filter id={`${id}-glow`} x="-5%" y="-50%" width="110%" height="200%">
          <feGaussianBlur stdDeviation="2 5" />
        </filter>
        <filter id={`${id}-spill`} x="-5%" y="-60%" width="110%" height="220%">
          <feGaussianBlur stdDeviation="4 8" />
        </filter>
        <filter id={`${id}-edge`} x="0" y="-10%" width="100%" height="120%">
          <feGaussianBlur stdDeviation="0 0.3" />
        </filter>
      </defs>
      {up.fill && <path d={A.above} fill={up.fill} />}
      {down.fill && <path d={A.below} fill={down.fill} />}
      <path d={A.top} fill="#ff2d6e" opacity="0.4" filter={`url(#${id}-spill)`} />
      <path d={A.top} fill={`url(#${id}-crimson)`} filter={`url(#${id}-edge)`} />
      <g clip-path={`url(#${id}-tclip)`}>
        <path d={A.topLit} fill={`url(#${id}-crimson-lit)`} filter={`url(#${id}-soft)`} />
        <path d={A.topShade} fill="#5a0420" opacity="0.4" filter={`url(#${id}-soft)`} />
      </g>
      <path d={A.under} fill={`url(#${id}-violet)`} filter={`url(#${id}-edge)`} />
      <g clip-path={`url(#${id}-uclip)`}>
        <path d={A.underLit} fill={`url(#${id}-violet-lit)`} filter={`url(#${id}-soft)`} />
        <path d={A.underShade} fill="#2a0c7a" opacity="0.4" filter={`url(#${id}-soft)`} />
      </g>
      <path
        d={A.glowTop}
        fill={`url(#${id}-light)`}
        opacity="0.35"
        filter={`url(#${id}-glow)`}
        style="mix-blend-mode: screen"
      />
    </svg>
  </div>
) : (
  <div class:list={["wave", "wave--paper", className]}>
    {up.ground && <div class={`wave-ground wave-ground--above wave-ground--${up.ground}`} />}
    {down.ground && <div class={`wave-ground wave-ground--below wave-ground--${down.ground}`} />}
    {up.fill && <div class="wave-edge wave-edge--above" style={{ background: up.fill }} />}
    {down.fill && <div class="wave-edge wave-edge--below" style={{ background: down.fill }} />}
    <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id={`${id}-spillfill`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#ff2d6e" />
          <stop offset="0.7" stop-color="#ff2d6e" />
          <stop offset="0.9" stop-color="#ff2d6e" stop-opacity="0" />
        </linearGradient>
        <linearGradient id={`${id}-violet`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#7a3ce6" />
          <stop offset="0.35" stop-color="#5a24c4" />
          <stop offset="0.7" stop-color="#40169e" stop-opacity="0" />
        </linearGradient>
        <linearGradient id={`${id}-violet-lit`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#d9c2ff" stop-opacity="0.6" />
          <stop offset="0.4" stop-color="#c9a6ff" stop-opacity="0.3" />
          <stop offset="0.68" stop-color="#c9a6ff" stop-opacity="0" />
        </linearGradient>
        <linearGradient id={`${id}-crimson`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#7a0a3a" stop-opacity="0.9" />
          <stop offset="0.45" stop-color="#b8123c" />
          <stop offset="0.75" stop-color="#d4143c" />
          <stop offset="1" stop-color="#f0304a" />
        </linearGradient>
        <linearGradient id={`${id}-crimson-lit`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0.2" stop-color="#ff7f9e" stop-opacity="0.2" />
          <stop offset="0.6" stop-color="#ff9ab0" stop-opacity="0.4" />
          <stop offset="1" stop-color="#ffb3bf" stop-opacity="0.5" />
        </linearGradient>
        <linearGradient id={`${id}-light`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#7a48ff" />
          <stop offset="0.6" stop-color="#c07cff" />
          <stop offset="1" stop-color="#ff7ab8" />
        </linearGradient>
        <clipPath id={`${id}-tclip`}>
          <path d={B.top} />
        </clipPath>
        <clipPath id={`${id}-uclip`}>
          <path d={B.under} />
        </clipPath>
        <filter id={`${id}-soft`} x="-5%" y="-60%" width="110%" height="220%">
          <feGaussianBlur stdDeviation="2 4" />
        </filter>
        <filter id={`${id}-glow`} x="-5%" y="-50%" width="110%" height="200%">
          <feGaussianBlur stdDeviation="2 5" />
        </filter>
        <filter id={`${id}-spill`} x="-5%" y="-60%" width="110%" height="220%">
          <feGaussianBlur stdDeviation="4 8" />
        </filter>
        <filter id={`${id}-edge`} x="0" y="-10%" width="100%" height="120%">
          <feGaussianBlur stdDeviation="0 0.3" />
        </filter>
      </defs>
      {up.fill && <path d={B.above} fill={up.fill} />}
      {down.fill && <path d={B.below} fill={down.fill} />}
      <path d={B.under} fill={`url(#${id}-spillfill)`} opacity="0.4" filter={`url(#${id}-spill)`} />
      <path d={B.top} fill={`url(#${id}-violet)`} filter={`url(#${id}-edge)`} />
      <g clip-path={`url(#${id}-tclip)`}>
        <path d={B.topLit} fill={`url(#${id}-violet-lit)`} filter={`url(#${id}-soft)`} />
        <path d={B.topShade} fill="#2a0c7a" opacity="0.4" filter={`url(#${id}-soft)`} />
      </g>
      <path d={B.under} fill={`url(#${id}-crimson)`} filter={`url(#${id}-edge)`} />
      <g clip-path={`url(#${id}-uclip)`}>
        <path d={B.underLit} fill={`url(#${id}-crimson-lit)`} filter={`url(#${id}-soft)`} />
        <path d={B.underShade} fill="#5a0420" opacity="0.4" filter={`url(#${id}-soft)`} />
      </g>
      <path
        d={B.glowTop}
        fill={`url(#${id}-light)`}
        opacity="0.35"
        filter={`url(#${id}-glow)`}
        style="mix-blend-mode: screen"
      />
    </svg>
  </div>
)}

<style is:global>
  /* The box is positioned and sized by the section that places it; the
     drawing and any ground continuation fill it. */
  .wave {
    display: block;
    position: relative;
    width: 100%;
    pointer-events: none;
  }

  .wave > svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* A flat colour above or below the ribbons is also laid as a plain box
     along the box's edge, under the drawing. The drawing is stretched to a
     box that can end on a fraction of a device pixel, and iOS Safari left
     the edge row only part covered, so the section behind showed through as
     a hairline across the screen: the paper as a white line under the night
     band, the banner's photo as a flickering one (decision 73). A box is
     snapped to the edge as the section's own background is, and lies under
     the drawing: the region above the ribbons is at least 24% of the box
     everywhere, so that box is under solid colour; the region below is at
     least 7% on the night wave (72% across), where its 15% box runs under
     the ribbons' foot, drawn over it, and 2% at the paper wave's right
     edge, so that one is a pixel. */
  .wave-edge {
    position: absolute;
    left: 0;
    right: 0;
  }
  .wave-edge--above {
    top: 0;
    height: 15%;
  }
  .wave-edge--below {
    bottom: 0;
    height: 15%;
  }
  .wave--paper .wave-edge--below {
    height: 1px;
  }

  /* The masks for a ground continued under the ribbons (global.css paints
     the .wave-ground boxes): the region above or below the ribbons in the
