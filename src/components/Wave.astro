      <clipPath id={`${id}-uclip`}>
        <path d={B.under} />
      </clipPath>
      <filter id={`${id}-soft`} x="-5%" y="-60%" width="110%" height="220%">
        <feGaussianBlur stdDeviation="1.2 3.2" />
      </filter>
      <filter id={`${id}-glow`} x="-5%" y="-50%" width="110%" height="200%">
        <feGaussianBlur stdDeviation="2 5" />
      </filter>
      <filter id={`${id}-spill`} x="-5%" y="-60%" width="110%" height="220%">
        <feGaussianBlur stdDeviation="4 8" />
      </filter>
    </defs>
    <path d={B.above} fill={above ?? "#1b0f2e"} />
    <path d={B.below} fill="#faf7fd" />
    <path d={B.under} fill="#ff2d6e" opacity="0.4" filter={`url(#${id}-spill)`} />
    <path d={B.top} fill={`url(#${id}-violet)`} />
    <g clip-path={`url(#${id}-tclip)`}>
      <path d={B.topLit} fill={`url(#${id}-violet-lit)`} filter={`url(#${id}-soft)`} />
      <path d={B.topShade} fill="#2a0c7a" opacity="0.4" filter={`url(#${id}-soft)`} />
    </g>
    <path d={B.under} fill={`url(#${id}-crimson)`} />
    <g clip-path={`url(#${id}-uclip)`}>
      <path d={B.underLit} fill={`url(#${id}-crimson-lit)`} filter={`url(#${id}-soft)`} />
