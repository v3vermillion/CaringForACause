---
import { show } from "../data/facts.ts";
import { facts, getInvolved } from "../data/site";
import Photo from "./Photo.astro";

const { tabs } = getInvolved;
const mailto = (subject: string) =>
  `mailto:${show(facts.email)}?subject=${encodeURIComponent(subject)}`;
---

<section id="get-involved" class="section section--lilac" aria-labelledby="involved-title">
  <div class="wrap">
    <header class="head">
      <span class="eyebrow">Get involved</span>
      <h2 id="involved-title">{getInvolved.heading}</h2>
      <p class="lede">{getInvolved.intro}</p>
    </header>

    <!--
      Tabs are built up by the script below. Without JavaScript, the tab
      buttons stay hidden and every panel is shown in order.
    -->
    <div class="tabs" data-tabs>
      <div class="tablist" role="tablist" aria-label={getInvolved.heading} hidden>
        {tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-controls={tab.id}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {tabs.map((tab) => {
        const href = tab.action.href ?? mailto(tab.heading);
        const label = tab.action.href ? tab.action.label : tab.action.fallbackLabel;
        const external = href.startsWith("http");
        return (
          <div class:list={["panel", { "panel--text": !tab.photo }]} id={tab.id} data-panel>
            <div class="stack">
              <h3>{tab.heading}</h3>
              {tab.body.map((line) => (
                <p>{line}</p>
              ))}
              <p class="action">
                <a
                  class="button button--purple"
                  href={href}
                  {...(external ? { target: "_blank", rel: "noopener" } : {})}
                >
                  {label}
                  {external && <span class="visually-hidden"> (opens in a new tab)</span>}
                </a>
              </p>
            </div>
            {tab.photo && (
              <Photo
                photo={tab.photo}
                ratio="var(--photo-ratio, 3 / 2)"
                sizes="(min-width: 56rem) 560px, 90vw"
              />
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tablist = root.querySelector<HTMLElement>("[role=tablist]");
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));
    if (!tablist || tabs.length === 0) return;

    panels.forEach((panel) => {
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", `tab-${panel.id}`);
      panel.tabIndex = 0;
    });
    tablist.hidden = false;
    root.classList.add("is-enhanced");
    // Panels ease in only once the page has painted: a panel that is on
    // screen at load appears at once, where it is.
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add("is-live")));

    const select = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const on = tab.getAttribute("aria-controls") === id;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) {
          tab.focus();
          tab.scrollIntoView({ block: "nearest", inline: "nearest" });
        }
      });
      panels.forEach((panel) => {
        panel.hidden = panel.id !== id;
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab.getAttribute("aria-controls")!));
      tab.addEventListener("keydown", (event) => {
        const keys: Record<string, number> = {
          ArrowRight: i + 1,
          ArrowDown: i + 1,
          ArrowLeft: i - 1,
          ArrowUp: i - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(event.key in keys)) return;
        event.preventDefault();
        const next = tabs[(keys[event.key]! + tabs.length) % tabs.length]!;
        select(next.getAttribute("aria-controls")!, true);
      });
    });

    // Links like /#volunteer open the matching tab and scroll to the section.
    // When a page opens with one in its address, the layout holds it and
    // places the reader (Base.astro), so here the tab only opens.
    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (panels.some((p) => p.id === id)) {
        select(id);
        root.closest("section")?.scrollIntoView();
        return true;
      }
      return false;
    };
    const held = document.documentElement.dataset.heldHash;
    const heldId = held ? decodeURIComponent(held.slice(1)) : "";
    if (panels.some((p) => p.id === heldId)) select(heldId);
    else if (!fromHash()) select(panels[0]!.id);
    window.addEventListener("hashchange", fromHash);
  });
</script>

<style>
  /* The section's top edge is the site's diagonal (the wedge's cut, rising
     to the right), cut out of the paper above it; the lilac is lit by a soft
     violet glow at its top right, sized in rem from that corner. */
  #get-involved {
    --cut: 3rem;
    margin-top: calc(-1 * var(--cut));
    padding-top: calc(var(--space-xl) + var(--cut));
    clip-path: polygon(0 var(--cut), 100% 0, 100% 100%, 0 100%);
    background:
      radial-gradient(40rem 22rem at 100% 0, rgb(200 170 255 / 0.4), transparent 70%), var(--lilac);
  }

  .head {
    margin-bottom: var(--space-l);
  }

  .head .lede {
    margin-top: var(--space-s);
  }

  /* Tabs: one row that scrolls on phones, sitting on the panel's own axis. */
  .tablist {
    display: flex;
    gap: 0.5rem;
    padding: 0.25rem var(--gutter) 0.75rem;
    margin: 0 calc(-1 * var(--gutter));
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .tablist::-webkit-scrollbar {
    display: none;
  }

  .tablist[hidden] {
    display: none;
  }

  [role="tab"] {
    flex: none;
    min-height: max(44px, 3rem);
    padding: 0.625rem 1.225rem; /* no border: it would snap to whole pixels and shift the row */
    border: 0;
    border-radius: var(--r-pill);
    background: #fff;
    box-shadow: 0 0 0 var(--hairline) var(--rule);
    color: var(--ink);
    font: inherit;
    font-family: var(--font-display);
    font-weight: 700;
    white-space: nowrap;
    scroll-snap-align: start;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      box-shadow 150ms ease,
      color 150ms ease;
  }

  [role="tab"]:hover {
    color: var(--purple);
  }

  [role="tab"][aria-selected="true"] {
    background: var(--purple);
    box-shadow: 0 0 0 var(--hairline) var(--purple);
    color: #fff;
  }

  .panel {
    display: grid;
    gap: var(--space-m);
    align-items: center;
    padding: var(--space-m);
    background: #fff;
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow:
      0 0 0 var(--hairline) rgb(96 8 215 / 0.08),
      0 1.5rem 3rem rgb(27 15 46 / 0.07);
  }

  /* A chosen panel arrives with a short ease rather than a cut (only after
     the page has painted, so nothing on screen at load moves); in browsers
     without @starting-style it simply appears. */
  .is-live .panel {
    transition:
      opacity 220ms ease,
      translate 220ms ease;
  }

  @starting-style {
    .is-live .panel {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  /* On phones and tablets the photo leads, edge to edge at the top of the
     card, and the words and the button follow it. */
  .panel:not(.panel--text) {
    padding: 0 0 var(--space-m);
  }

  .panel:not(.panel--text) > .stack {
    padding-inline: var(--space-m);
  }

  .panel :global(.photo) {
    order: -1;
    border-radius: var(--r-card) var(--r-card) 0 0;
  }

  /* Without JavaScript, panels stack with space between them. */
  .panel + .panel {
    margin-top: var(--space-m);
  }

  .is-enhanced .panel + .panel {
    margin-top: 0;
  }

  .panel[hidden] {
    display: none;
  }

  .panel h3 {
    font-size: calc(var(--step-3) * 0.85);
    color: var(--ink);
  }

  /* The button holds its 44px floor where the scale would make it smaller;
     the extra hangs outside its paragraph (a negative block margin, as the
     season strip's link does), so the panel, and the photo stretched to it,
     stay the same picture at every desktop width. */
  .panel .action {
    margin-top: calc(var(--space-s) + (3rem - max(44px, 3rem)) / 2);
    margin-bottom: calc((3rem - max(44px, 3rem)) / 2);
  }

  .panel p {
    font-size: var(--step-0);
  }

  @media (min-width: 56rem) {
    .tablist {
      margin-inline: 0;
      padding-inline: 0;
    }
    /* On desktop the photo takes the panel's right half edge to edge, as an
       editorial spread; the words keep the panel's padding. */
    .panel:not(.panel--text) {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-l);
      padding: 0;
      align-items: stretch;
    }
    .panel:not(.panel--text) > .stack {
      align-self: center;
      padding: var(--space-l) 0 var(--space-l) var(--space-l);
    }
    /* The photo takes the row's height (the words set it, with a floor),
       not its own ratio, so the row is the same on every desktop width. */
    .panel :global(.photo) {
      --photo-ratio: auto;
      order: 0;
      align-self: stretch;
      height: 100%;
      min-height: 22rem;
      border-radius: 0 var(--r-card) var(--r-card) 0;
    }
  }
</style>
