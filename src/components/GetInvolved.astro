---
import { show } from "../data/facts.ts";
import { facts, getInvolved } from "../data/site";
import Photo from "./Photo.astro";

const { tabs } = getInvolved;
const mailto = (subject: string) =>
  `mailto:${show(facts.email)}?subject=${encodeURIComponent(subject)}`;
---

<section
  id="get-involved"
  class="section section--lilac ground ground--lilac"
  aria-labelledby="involved-title"
>
  <div class="wrap">
    <header class="head">
      <span class="eyebrow">Get involved</span>
      <h2 id="involved-title">{getInvolved.heading}</h2>
      <p class="lede">{getInvolved.intro}</p>
    </header>

    <!--
      Tabs are built up by the script below. Without JavaScript, the tab
      buttons stay hidden and every panel is shown in order.
    -->
    <div class="tabs" data-tabs>
      <!-- One segmented track: the tabs sit on a white rail and the purple
           pill (the thumb) slides under the chosen one. The tablist is the
           scroller (it bleeds to the phone's edges); the track is the rail. -->
      <div class="tablist" role="tablist" aria-label={getInvolved.heading} hidden>
        <div class="track" role="presentation">
          <span class="thumb" aria-hidden="true"></span>
          {tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.id}`}
              aria-controls={tab.id}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              {tab.label}
            </button>
          ))}
        </div>
      </div>

      <!-- The stage holds the panels: with JavaScript they stack in one
           grid cell and one shows at a time, so the stage is always the
           tallest panel's height and a change crossfades in place while
           nothing below the card moves. -->
      <div class="stage" data-stage>
        {tabs.map((tab) => {
          const href = tab.action.href ?? mailto(tab.heading);
          const label = tab.action.href ? tab.action.label : tab.action.fallbackLabel;
          const external = href.startsWith("http");
          return (
            <div
              class:list={["panel", "surface", { "panel--text": !tab.photo }]}
              id={tab.id}
              data-panel
            >
              <div class="stack">
                <h3>{tab.heading}</h3>
                {tab.body.map((line) => (
                  <p>{line}</p>
                ))}
                <p class="action">
                  <a
                    class="button button--purple"
                    href={href}
                    {...(external ? { target: "_blank", rel: "noopener" } : {})}
                  >
                    {label}
                    {external && <span class="visually-hidden"> (opens in a new tab)</span>}
                  </a>
                </p>
              </div>
              {tab.photo && (
                <Photo
                  photo={tab.photo}
                  ratio="var(--photo-ratio, 3 / 2)"
                  sizes="(min-width: 56rem) 560px, 90vw"
                />
              )}
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tablist = root.querySelector<HTMLElement>("[role=tablist]");
    const track = root.querySelector<HTMLElement>(".track");
    const stage = root.querySelector<HTMLElement>("[data-stage]");
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));
    if (!tablist || !track || !stage || tabs.length === 0) return;

    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const live = () => root.classList.contains("is-live");
    const STORE = "involved-tab";

    // The panels are tabpanels, not tab stops: each holds a button, which
    // is where Tab from the tablist should land.
    panels.forEach((panel) => {
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", `tab-${panel.id}`);
    });
    tablist.hidden = false;
    root.classList.add("is-enhanced");
    // Panels ease in and the thumb slides only once the page has painted: a
    // panel that is on screen at load appears at once, where it is.
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add("is-live")));

    const selected = () => tabs.find((tab) => tab.getAttribute("aria-selected") === "true");

    // The thumb sits under the chosen tab: its place and size are the tab's
    // (two coordinates, because on phones the track is two rows).
    const place = () => {
      const tab = selected();
      if (!tab) return;
      track.style.setProperty("--x", `${tab.offsetLeft}px`);
      track.style.setProperty("--y", `${tab.offsetTop}px`);
      track.style.setProperty("--w", `${tab.offsetWidth}px`);
      track.style.setProperty("--h", `${tab.offsetHeight}px`);
    };
    document.fonts?.ready.then(place);
    if ("ResizeObserver" in window) new ResizeObserver(place).observe(track);

    // The chosen tab is brought to the middle of the strip, never moving
    // the page itself. On phones the rail is two rows and nothing scrolls,
    // so this is a no-op there; from 36rem up it covers a strip that
    // overflows (none does today, but a longer label would).
    const reveal = (tab: HTMLElement) => {
      const left = tab.getBoundingClientRect().left - tablist.getBoundingClientRect().left;
      tablist.scrollTo({
        left: tablist.scrollLeft + left - (tablist.clientWidth - tab.offsetWidth) / 2,
        behavior: reduce.matches || !live() ? "auto" : "smooth",
      });
    };

    // A leaving panel fades out in place (out of the accessibility tree at
    // once) and turns invisible after the fade; the timer is the safety net
    // if the transition never ends. Panels keep their boxes (visibility, not
    // display), stacked in one grid cell, so the stage is always the tallest
    // panel's height and switching never moves the page below.
    const leaving = new Map<HTMLElement, number>();
    const settle = (panel: HTMLElement) => {
      clearTimeout(leaving.get(panel));
      leaving.delete(panel);
      panel.classList.remove("is-leaving");
      panel.removeAttribute("aria-hidden");
      panel.inert = false;
      panel.classList.add("is-off");
    };
    stage.addEventListener("transitionend", (event) => {
      const target = event.target as HTMLElement;
      if (event.propertyName === "opacity" && leaving.has(target)) settle(target);
    });
    // The arriving panel starts a step toward its side and eases to rest: a
    // start frame committed by a forced layout, then the transition. (The
    // old @starting-style route only fires when display changes, which the
    // grid stack no longer does, and Safari 15 never had it.)
    const arrive = (panel: HTMLElement) => {
      if (!panel.classList.contains("is-off")) return;
      panel.classList.add("is-in");
      panel.classList.remove("is-off");
      void panel.offsetHeight;
      panel.classList.remove("is-in");
    };

    const select = (id: string, focus = false, user = false) => {
      const tab = tabs.find((t) => t.getAttribute("aria-controls") === id);
      const panel = panels.find((p) => p.id === id);
      if (!tab || !panel) return;
      const from = tabs.indexOf(selected() ?? tab);
      const to = tabs.indexOf(tab);

      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
      });
      if (focus) tab.focus({ preventScroll: true });
      reveal(tab);
      place();

      // A person's choice is kept in the address (so it can be copied and
      // survives a refresh) and for the visit; a link's or the page's own
      // choice is not written back.
      if (user) {
        history.replaceState(history.state, "", `#${id}`);
        try {
          sessionStorage.setItem(STORE, id);
        } catch {
          /* private mode: the address still carries it */
        }
      }

      const showing = panels.filter((p) => !p.classList.contains("is-off") && !leaving.has(p));
      if (showing.length === 1 && showing[0] === panel) return;

      // Before the page has painted (or under reduced motion) the change is
      // a plain swap: nothing on screen moves.
      if (!live() || reduce.matches) {
        leaving.forEach((_, p) => settle(p));
        panels.forEach((p) => {
          p.classList.toggle("is-off", p !== panel);
        });
        return;
      }

      stage.dataset.dir = to > from ? "next" : "prev";
      panels.forEach((p) => {
        if (p === panel) {
          // If it was on its way out, it comes straight back.
          clearTimeout(leaving.get(p));
          leaving.delete(p);
          p.classList.remove("is-leaving");
          p.removeAttribute("aria-hidden");
          p.inert = false;
          arrive(p);
        } else if (!p.classList.contains("is-off") && !leaving.has(p)) {
          p.classList.add("is-leaving");
          p.setAttribute("aria-hidden", "true");
          p.inert = true;
          leaving.set(
            p,
            window.setTimeout(() => settle(p), 240),
          );
        }
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab.getAttribute("aria-controls")!, false, true));
      tab.addEventListener("keydown", (event) => {
        const keys: Record<string, number> = {
          ArrowRight: i + 1,
          ArrowDown: i + 1,
          ArrowLeft: i - 1,
          ArrowUp: i - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(event.key in keys)) return;
        event.preventDefault();
        const next = tabs[(keys[event.key]! + tabs.length) % tabs.length]!;
        select(next.getAttribute("aria-controls")!, true, true);
      });
    });

    // On a touch screen a sideways swipe on the card turns to the next or
    // the previous panel (no wrap at the ends). Vertical scrolling is left
    // to the browser (touch-action: pan-y), and nothing is prevented, so the
    // button inside the card works as before.
    let swipe: { x: number; y: number; id: number } | null = null;
    stage.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch")
        swipe = { x: event.clientX, y: event.clientY, id: event.pointerId };
    });
    stage.addEventListener("pointerup", (event) => {
      if (!swipe || event.pointerId !== swipe.id) return;
      const dx = event.clientX - swipe.x;
      const dy = event.clientY - swipe.y;
      swipe = null;
      if (Math.abs(dx) < 48 || Math.abs(dx) < 1.5 * Math.abs(dy)) return;
      const next = tabs[tabs.indexOf(selected()!) + (dx < 0 ? 1 : -1)];
      if (next) select(next.getAttribute("aria-controls")!, false, true);
    });
    stage.addEventListener("pointercancel", () => {
      swipe = null;
    });

    // Links like /#volunteer open the matching tab and scroll to the section.
    // When a page opens with one in its address, the layout holds it and
    // places the reader (Base.astro), or the browser does (Back, Forward),
    // so on load the tab only opens. An
    // address that cannot be decoded (a stray %) is read as written.
    const has = (id: string) => panels.some((p) => p.id === id);
    const decode = (hash: string) => {
      try {
        return decodeURIComponent(hash.slice(1));
      } catch {
        return hash.slice(1);
      }
    };
    const fromHash = (scroll: boolean) => {
      const id = decode(location.hash);
      if (has(id)) {
        select(id);
        if (scroll)
          root.closest("section")?.scrollIntoView({ behavior: reduce.matches ? "auto" : "smooth" });
        return true;
      }
      return false;
    };
    // On load: the held section, the address, the visit's last choice, or
    // the first panel.
    const held = document.documentElement.dataset.heldHash;
    const heldId = held ? decode(held) : "";
    let remembered = "";
    try {
      remembered = sessionStorage.getItem(STORE) ?? "";
    } catch {
      /* no storage: the first panel */
    }
    if (has(heldId)) select(heldId);
    else if (!fromHash(false)) select(has(remembered) ? remembered : panels[0]!.id);
    window.addEventListener("hashchange", () => fromHash(true));
  });
</script>

<style>
  /* The section's top edge is the site's diagonal (the wedge's cut, rising
     to the right), cut out of the paper above it; the lilac is lit by a soft
     violet glow at its top right, sized in rem from that corner. */
  #get-involved {
    --cut: var(--wedge);
    /* A link lands with the diagonal cut under the bar, on the lilac
       (decision 71). */
    scroll-margin-top: calc(var(--header-h) - var(--scroll-pad) - var(--cut) - 0.25rem);
    margin-top: calc(-1 * var(--cut));
    padding-top: calc(var(--space-xl) + var(--cut));
    /* The cut's shape reaches past the section's foot, so the clip's edge
       is not antialiased on the same fraction of a pixel as the section
       below, where the two edges met with a sliver of paper between them
       (decision 72). */
    clip-path: polygon(0 var(--cut), 100% 0, 100% calc(100% + 2px), 0 calc(100% + 2px));
    /* The corner wash deep enough to read (the old 200,170,255 at 0.4 was
       a seven-point delta on the lilac, invisible at arm's length), with
       the rose breath the other grounds carry at the opposite corner. */
    background:
      radial-gradient(48rem 26rem at 100% 0, rgb(177 135 255 / 0.5), transparent 70%),
      radial-gradient(30rem 18rem at 0 100%, rgb(255 90 134 / 0.1), transparent 70%), var(--lilac);
  }

  .head {
    /* Less the tablist's own 0.25rem of slack, so the chips open exactly
       one --space-l under the lede, the shared head-to-content distance. */
    margin-bottom: calc(var(--space-l) - 0.25rem);
  }

  .head .lede {
    margin-top: var(--space-s);
  }

  /* Tabs. On a phone the four choices are glass chips in two rows of two,
     so all are on screen at once (one row cannot fit them: the labels
     alone are wider than the column at every phone size, the classes
     scale); the chosen chip fills purple, the way the forms' choice chips
     answer. From 36rem up they sit on the one-row rail with the sliding
     pill, which scrolls if it must, its edges fading where it bleeds past
     the column, so a tab cut by the screen dissolves rather than chops; at
     rest the tabs start where the fade ends (the bleed and the fade are
     both the gutter), so nothing at rest is dimmed. */
  .tablist {
    display: flex;
    padding: 0.25rem 0 var(--r-card); /* clear of the card by its own radius */
  }

  .tablist::-webkit-scrollbar {
    display: none;
  }

  .tablist[hidden] {
    display: none;
  }

  /* On phones the track is only the chips' grid: no rail chrome, and the
     thumb stays placed but invisible (the chips answer with their own
     fill; a pill has no rail to slide along in two rows). */
  .track {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    gap: 0.5rem;
  }

  .thumb {
    opacity: 0; /* not visibility: it keeps its box for the thumb test */
  }

  @media (min-width: 36rem) {
    .tablist {
      padding-inline: var(--gutter);
      margin: 0 calc(-1 * var(--gutter));
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent,
        #000 var(--gutter),
        #000 calc(100% - var(--gutter)),
        transparent
      );
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 var(--gutter),
        #000 calc(100% - var(--gutter)),
        transparent
      );
    }

    /* The rail: white, ringed by a hairline (a shadow, not a border, so it
       never snaps to a whole pixel), holding the tabs and the thumb. */
    .track {
      display: inline-flex;
      flex: none;
      width: auto;
      gap: 0;
      padding: 0.25rem;
      border-radius: var(--r-pill);
      background: rgb(255 255 255 / 0.72);
      -webkit-backdrop-filter: blur(0.75rem);
      backdrop-filter: blur(0.75rem);
      box-shadow:
        0 0 0 var(--hairline) rgb(96 8 215 / 0.14),
        0 0.5rem 1.5rem rgb(27 15 46 / 0.08),
        inset 0 1px 0 #fff;
    }

    .thumb {
      opacity: 1;
    }
  }

  /* The thumb: the purple pill under the chosen tab, placed by the script
     (--x, --y, --w and --h are the tab's offsets and size: two rows on a
     phone, one from 36rem up) and slid there once the page has painted. */
  .thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: var(--h, 0px);
    width: var(--w, 0px);
    /* transform, not the translate property, which Chrome only has from
       104: without it the thumb stayed under the first tab and the chosen
       tab's white label sat on the white rail. */
    transform: translate(var(--x, 0px), var(--y, 0px));
    border-radius: var(--r-pill);
    /* Lit like the purple buttons: sheen, a pale inner rim, a violet lift. */
    background-color: var(--purple);
    background-image: linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0) 30%);
    box-shadow:
      inset 0 0 0 var(--hairline) rgb(255 255 255 / 0.2),
      0 0.25rem 0.75rem rgb(96 8 215 / 0.25);
  }

  .is-live .thumb {
    transition:
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      width 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  [role="tab"] {
    position: relative;
    z-index: 1;
    flex: none;
    min-height: max(44px, 3rem);
    /* Narrow sides on a phone, where the widest label fills its half row;
       no border: it would snap to whole pixels and shift the row. */
    padding: 0.625rem 0.5rem;
    border: 0;
    border-radius: var(--r-pill);
    /* A glass chip on the lilac, ringed like the forms' choice chips
       (--rule-strong, the boundary token: the first cut's 0.18-alpha ring
       measured ~1.4:1 and the chips read as untethered white blobs); the
       rail strips this from 36rem up. The 0.5rem side padding is the pill
       family's floor by necessity, not neglect: the widest label leaves
       about 0.5rem per side in its half-row, and wider padding wraps it
       on a 320px phone. */
    background: rgb(255 255 255 / 0.72);
    -webkit-backdrop-filter: blur(0.75rem);
    backdrop-filter: blur(0.75rem);
    box-shadow: inset 0 0 0 var(--hairline) var(--rule-strong);
    color: var(--ink);
    font: inherit;
    font-family: var(--font-display);
    font-weight: 700;
    /* 1.2 like .button, so the chip resolves to exactly its 3rem floor
       instead of overshooting it by the body line-height. */
    line-height: 1.2;
    white-space: nowrap;
    scroll-snap-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent; /* the tab answers a press itself */
    transition:
      color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  /* A press answers like the forms' chips: lilac under the finger. */
  [role="tab"]:not([aria-selected="true"]):active {
    background: var(--lilac);
    box-shadow: inset 0 0 0 var(--hairline) var(--purple);
    transition-duration: 60ms;
  }

  /* Chosen: the lit purple the buttons wear. */
  [role="tab"][aria-selected="true"] {
    background-color: var(--purple);
    background-image: linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0) 30%);
    box-shadow:
      inset 0 0 0 var(--hairline) rgb(255 255 255 / 0.2),
      0 0.25rem 0.75rem rgb(96 8 215 / 0.25);
  }

  @media (min-width: 36rem) {
    [role="tab"],
    [role="tab"][aria-selected="true"] {
      padding-inline: 1.225rem;
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      box-shadow: none;
    }

    /* On the rail the pointer gets a quiet wash; the thumb stays the star. */
    [role="tab"]:not([aria-selected="true"]):hover {
      background: rgb(96 8 215 / 0.06);
    }

    [role="tab"]:not([aria-selected="true"]):active {
      background: rgb(96 8 215 / 0.1);
      box-shadow: none;
      transition-duration: 60ms;
    }
  }

  [role="tab"]:hover {
    color: var(--purple);
  }

  [role="tab"]:not([aria-selected="true"]):active {
    color: var(--purple-deep);
  }

  [role="tab"][aria-selected="true"] {
    color: #fff;
  }

  /* The keyboard ring keeps to the rail's padding. */
  [role="tab"]:focus-visible {
    outline-offset: 0.0625rem;
  }

  /* High contrast drops the thumb's fill, which is the only mark of the
     chosen tab: give it an edge in the system's highlight colour. */
  @media (forced-colors: active) {
    [role="tab"][aria-selected="true"] {
      outline: 3px solid Highlight;
      outline-offset: -3px;
    }
  }

  /* The stage: the panels' room. With JavaScript the panels stack in one
     grid cell, so the stage is always the tallest panel's height and
     switching never moves the page below; a sideways swipe on it turns the
     panel while vertical scrolling stays the browser's. */
  .stage {
    position: relative;
    touch-action: pan-y;
  }

  .is-enhanced .stage {
    display: grid;
  }

  .is-enhanced .panel {
    grid-area: 1 / 1;
    /* The cell is the tallest panel's height; a shorter panel keeps its own
       (start, not the default stretch, whose extra height seeped between
       the card's rows and pushed the photo off the card's top edge), and
       the ground shows below its card. */
    align-self: start;
  }

  /* A panel at rest that isn't the chosen one: invisible but keeping its
     box (so the stage holds the tallest panel's height), unfocusable, and
     out of the accessibility tree, all of which visibility gives. */
  .is-enhanced .panel.is-off {
    visibility: hidden;
  }

  /* A surface (global.css): white, lifted, with a rim of light. */
  .panel {
    display: grid;
    gap: var(--space-m);
    align-items: center;
    padding: var(--space-m);
    overflow: hidden;
  }

  /* A chosen panel arrives with a short ease from the side it was called
     from (only after the page has painted, so nothing on screen at load
     moves). The script commits the start frame (.is-in, a forced layout)
     and then releases it, which works in every supported browser; the one
     it replaces fades out on top of it, sharing the same grid cell. */
  .is-live .panel {
    transition:
      opacity 220ms ease,
      translate 220ms ease;
  }

  .is-live .panel.is-in {
    opacity: 0;
    translate: 0 0.5rem;
    transition: none;
  }

  .is-live .stage[data-dir="next"] .panel.is-in {
    translate: 1rem 0;
  }

  .is-live .stage[data-dir="prev"] .panel.is-in {
    translate: -1rem 0;
  }

  /* .is-live in the selector so the quicker fade outranks the arriving
     panel's transition above. */
  .is-live .panel.is-leaving {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease;
  }

  /* On phones and tablets the photo leads, edge to edge at the top of the
     card, and the words and the button follow it. */
  .panel:not(.panel--text) {
    padding: 0 0 var(--space-m);
  }

  .panel:not(.panel--text) > .stack {
    padding-inline: var(--space-m);
  }

  /* The grid's child is the picture element (the img sits inside it), so
     the order that puts the photo first goes on the picture. */
  .panel > :global(picture) {
    order: -1;
  }

  /* The photo sits a hairline inside the card, so the surface's violet-rose
     rim lands on white card paint and rings the photo — not on the photo's
     own pixels, where it read as an accidental pink fringe. */
  .panel :global(.photo) {
    width: calc(100% - 2 * var(--hairline));
    margin: var(--hairline) var(--hairline) 0;
    border-radius: calc(var(--r-card) - var(--hairline)) calc(var(--r-card) - var(--hairline)) 0 0;
  }

  /* Without JavaScript, panels stack with space between them. */
  .panel + .panel {
    margin-top: var(--space-m);
  }

  .is-enhanced .panel + .panel {
    margin-top: 0;
  }

  .panel h3 {
    font-size: calc(var(--step-3) * 0.85);
    color: var(--ink);
  }

  /* The button holds its 44px floor where the scale would make it smaller;
     the extra hangs outside its paragraph (a negative block margin, as the
     season strip's link does), so the panel, and the photo stretched to it,
     stay the same picture at every desktop width. */
  .panel .action {
    margin-top: calc(var(--space-s) + (3rem - max(44px, 3rem)) / 2);
