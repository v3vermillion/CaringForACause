---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Photo } from "../data/site";

type Props = {
  photos: Photo[];
  /** CSS aspect ratio of the panel. */
  ratio?: string;
  caption?: string;
  sizes?: string;
};
const {
  photos,
  ratio = "4 / 3",
  caption,
  sizes = "(min-width: 56rem) 560px, calc(100vw - 2.5rem)",
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const slides = photos.map((photo, i) => {
  const match = files[`../assets/photos/${photo.file}`];
  if (!match) throw new Error(`Photo not found: src/assets/photos/${photo.file}`);
  return { ...photo, src: match.default, index: i };
});
const cycle = slides.length * 6;
---

<!--
  A framed panel of her photos with nothing written on them, crossfading
  slowly. Only the first photo loads with the page; the rest load after,
  then the crossfade starts. Without JavaScript or with reduced motion, the
  first photo stays.
-->
<figure class="panel" style={`--slides: ${slides.length}; --cycle: ${cycle}s; --ratio: ${ratio};`}>
  <div class="montage" aria-hidden="true" data-montage>
    {slides.map((slide) => (
      <div class="slide-wrap" hidden={slide.index > 0} style={`--i: ${slide.index};`}>
        <Picture
          src={slide.src}
          formats={["avif", "webp"]}
          alt=""
          quality={60}
          widths={[480, 640, 720]}
          sizes={sizes}
          loading="lazy"
          decoding="async"
          style={`object-position: ${slide.focus ?? "center"};`}
        />
      </div>
    ))}
  </div>
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-montage]").forEach((montage) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const start = () => {
      montage.querySelectorAll<HTMLElement>(".slide-wrap[hidden]").forEach((el) => {
        el.hidden = false;
      });
      montage.classList.add("play");
    };
    if (document.readyState === "complete") setTimeout(start, 1200);
    else addEventListener("load", () => setTimeout(start, 1200), { once: true });
  });
</script>

<style>
  .panel {
    position: relative;
    margin: 0;
    border-radius: 24px;
  }

  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.55),
      rgb(96 8 215 / 0.6) 45%,
      rgb(186 1 12 / 0.45)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .montage {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: inherit;
    background: #2a1640;
  }

  .slide-wrap,
  .montage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide-wrap[hidden] {
    display: none;
  }

  .montage :global(img) {
    object-fit: cover;
    transform: scale(1.03);
  }

  .slide-wrap:first-child :global(img) {
    opacity: 1;
  }

  .montage.play .slide-wrap :global(img) {
    opacity: 0;
    animation: crossfade var(--cycle) infinite;
    animation-delay: calc(var(--i) * (var(--cycle) / var(--slides)) - var(--cycle) * 0.08);
  }

  @keyframes crossfade {
    0% {
      opacity: 0;
    }
    8%,
    25% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  .caption {
    position: absolute;
    right: 1rem;
    bottom: -0.9rem;
    z-index: 2;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--night);
    color: var(--night-soft);
    font-family: var(--font-script);
    font-size: var(--step-0);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .montage :global(img) {
      animation: none !important;
      transform: none;
    }
    .slide-wrap:first-child :global(img) {
      opacity: 1 !important;
    }
  }
</style>
