---
/**
 * The program icons' shared definitions (the glow filter and the fills):
 * rendered once per page, before the first icon, by ProgramStrip on the
 * home page and by the donation page's "what your gift provides" panel.
 * Every ProgramIcon refers to them by id.
 */
---

<svg class="pi-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <filter
      id="pi-glow"
      x="-40%"
      y="-40%"
      width="180%"
      height="180%"
      color-interpolation-filters="sRGB"
    >
      <feGaussianBlur in="SourceGraphic" stdDeviation="1.2" result="b1"></feGaussianBlur>
      <feFlood flood-color="#9a80ff" flood-opacity="0.5" result="c1"></feFlood>
      <feComposite in="c1" in2="b1" operator="in" result="g1"></feComposite>
      <feGaussianBlur in="SourceGraphic" stdDeviation="7" result="b2"></feGaussianBlur>
      <feFlood flood-color="#3a14c8" flood-opacity="0.6" result="c2"></feFlood>
      <feComposite in="c2" in2="b2" operator="in" result="g2"></feComposite>
      <feMerge>
        <feMergeNode in="g2"></feMergeNode>
        <feMergeNode in="g1"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
    <linearGradient id="pi-red" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c8343f"></stop>
      <stop offset="0.5" stop-color="#b52c3a"></stop>
      <stop offset="1" stop-color="#a22836"></stop>
    </linearGradient>
    <radialGradient id="pi-plate" cx="0.45" cy="0.35" r="0.7">
      <stop offset="0" stop-color="#c83447"></stop>
      <stop offset="0.7" stop-color="#b02832"></stop>
      <stop offset="1" stop-color="#9c2226"></stop>
    </radialGradient>
    <linearGradient id="pi-plate-in" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6a1410"></stop>
      <stop offset="0.5" stop-color="#951d1c"></stop>
      <stop offset="1" stop-color="#bf272c"></stop>
    </linearGradient>
    <linearGradient id="pi-violet" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4414cc"></stop>
      <stop offset="0.5" stop-color="#2e0ba2"></stop>
      <stop offset="1" stop-color="#4416c4"></stop>
    </linearGradient>
    <radialGradient id="pi-well" cx="0.5" cy="0.45" r="0.62">
      <stop offset="0" stop-color="#0d0737"></stop>
      <stop offset="0.72" stop-color="#150a4a"></stop>
      <stop offset="1" stop-color="#2f0e9c"></stop>
    </radialGradient>
    <linearGradient id="pi-tab" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#dc3f57"></stop>
      <stop offset="0.7" stop-color="#c92c46"></stop>
      <stop offset="1" stop-color="#8b2538"></stop>
    </linearGradient>
    <linearGradient id="pi-cuff" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#992850"></stop>
      <stop offset="1" stop-color="#c73050"></stop>
    </linearGradient>
    <linearGradient id="pi-tube" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9b7ce4" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#58429e" stop-opacity="0.75"></stop>
    </linearGradient>
    <linearGradient id="pi-panel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e43c5a"></stop>
      <stop offset="0.22" stop-color="#b02628"></stop>
      <stop offset="0.55" stop-color="#9a2020"></stop>
      <stop offset="1" stop-color="#8a1a1c"></stop>
    </linearGradient>
    <radialGradient id="pi-pocket" cx="0.5" cy="0.5" r="0.72">
      <stop offset="0" stop-color="#24058f"></stop>
      <stop offset="0.78" stop-color="#2a0798"></stop>
      <stop offset="1" stop-color="#4a18d7"></stop>
    </radialGradient>
  </defs>
</svg>

<style>
  .pi-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
