---
import { seasonalBanner } from "../data/site";
---

{seasonalBanner.active && (
  <aside class="banner on-dark" aria-label="Current need">
    <div class="wrap inner">
      <p>
        <span class="dot" aria-hidden="true" />
        {seasonalBanner.message}
      </p>
      <a class="arrow-link" href={seasonalBanner.action.href}>
        {seasonalBanner.action.label}
      </a>
    </div>
  </aside>
)}

<style>
  /* The season's one ask, on the night band under the banner (decision 51),
     quieter than the banner above: white words, a lit dot, and the link in
     lavender. Its height on desktop is part of --strips-h
     (src/styles/global.css): the bottom border counts, so it stays even
     though it is invisible where the wave's night meets it. */
  .banner {
    background: var(--night-2);
    border-bottom: 1px solid transparent;
    /* A hairline of the band's violet marks the strip's top edge, so it reads
       as its own bar under the proof line, at no cost in height. */
    box-shadow: inset 0 1px 0 rgb(160 108 255 / 0.22);
  }

  /* Sized in the class's reference pixel (--rp) so every phone and every
     tablet shows the same strip; on desktop --rp is 1px. */
  /* Phones and tablets stack the ask and its link, centred like the icons and
     the proof line above them, so the band ends on the axis it began on;
     desktop spreads them to the column's edges. */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 calc(24 * var(--sp));
    padding-block: calc(9.6 * var(--sp));
    text-align: center;
  }

  p {
    max-width: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(17 * var(--sp));
    line-height: 1.3;
    color: #fff;
  }

  /* The link's tap target never drops below 44px, but the strip's height
     stays in scale: below 44px of scale the extra target height hangs
     outside the row (a negative block margin), so the strip is the same
     picture on every phone and tablet. */
  .inner :global(.arrow-link) {
    min-height: max(44px, calc(44 * var(--sp)));
    margin-block: calc((44 * var(--sp) - max(44px, 44 * var(--sp))) / 2);
    font-size: calc(18 * var(--sp));
    color: #d9c8ff;
  }

  .inner :global(.arrow-link:hover) {
    color: #fff;
  }

  /* The dot leads the first line: inline where the ask is centred and may
     wrap (so it stays beside the first word), a flex item beside the text on
     desktop, centred on the first line's height. */
  .dot {
    display: inline-block;
    flex: none;
    width: calc(8.8 * var(--sp));
    height: calc(8.8 * var(--sp));
    margin-right: calc(9.6 * var(--sp));
    vertical-align: calc((1.3 * 17 * var(--sp) - 8.8 * var(--sp)) / 2 - 0.25em);
    border-radius: 50%;
    background: linear-gradient(135deg, #ff5a86, #a06cff);
    box-shadow: 0 0 calc(8 * var(--sp)) rgb(255 90 134 / 0.55);
  }

  @media (min-width: 56rem) {
    .inner {
      justify-content: space-between;
      text-align: left;
    }
    p {
      display: flex;
      align-items: start;
      gap: calc(9.6 * var(--sp));
    }
    .dot {
      display: block;
      margin-right: 0;
      margin-top: calc((1.3 * 17 * var(--sp) - 8.8 * var(--sp)) / 2);
    }
  }
</style>
