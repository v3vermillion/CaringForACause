---
import { seasonalBanner } from "../data/site";
---

{seasonalBanner.active && (
  <aside class="banner" aria-label="Current need">
    <div class="wrap inner">
      <p>
        <span class="dot" aria-hidden="true" />
        {seasonalBanner.message}
      </p>
      <a class="arrow-link" href={seasonalBanner.action.href}>
        {seasonalBanner.action.label}
      </a>
    </div>
  </aside>
)}

<style>
  /* A quiet strip on lilac: the season's one ask, never louder than the banner above. */
  .banner {
    background: var(--lilac);
    border-bottom: 1px solid var(--rule);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-m);
    padding-block: 0.6rem;
  }

  p {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1.3;
  }

  .dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--purple);
  }
</style>
