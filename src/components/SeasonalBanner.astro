---
import { seasonalBanner } from "../data/site";
---

{seasonalBanner.active && (
  <aside class="banner" aria-label="Current need">
    <div class="wrap inner">
      <p>{seasonalBanner.message}</p>
      <a class="button banner-button" href={seasonalBanner.action.href}>
        {seasonalBanner.action.label}
      </a>
    </div>
  </aside>
)}

<style>
  .banner {
    background: var(--purple);
    color: #fff;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
    padding-block: var(--space-s);
  }

  p {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .banner-button {
    background: #fff;
    color: var(--purple);
  }

  .banner-button:hover {
    background: var(--lilac);
  }
</style>
