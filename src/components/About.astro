---
import { about } from "../data/site";
import Photo from "./Photo.astro";
import Wave from "./Wave.astro";

const watchUrl = `https://www.youtube.com/watch?v=${about.video.id}`;
---

<!-- Her portrait, her story, and her feature video, which loads only when asked for. -->
<section id="about" class="section section--night on-dark" aria-labelledby="about-title">
  <!-- The ribbons carry the lilac above into the night, and the night out
       onto the paper below (decision 52). -->
  <Wave kind="into-night" id="wc" above="#efe6fa" class="wave-top" />
  <Wave kind="into-paper" id="wd" class="wave-bottom" />
  <div class="wrap">
    <div class="grid">
      <figure class="portrait">
        <Photo
          photo={about.portrait}
          ratio="4 / 5"
          sizes="(min-width: 56rem) 420px, calc(100vw - 2.5rem)"
          widths={[420, 632]}
          class="portrait-photo"
        />
      </figure>

      <div class="stack copy">
        <span class="eyebrow">{about.eyebrow}</span>
        <h2 id="about-title">{about.heading}</h2>
        {about.body.map((line) => (
          <p>{line}</p>
        ))}
        <p>
          <a
            class="button button--glass watch"
            href={watchUrl}
            target="_blank"
            rel="noopener"
            data-watch
          >
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path d="M6 4l10 6-10 6z" fill="currentColor" />
            </svg>
            {about.watchLabel}
            <span class="visually-hidden" data-watch-hint>
              {" "}
              (opens in a new tab on YouTube)
            </span>
          </a>
        </p>
      </div>
    </div>

    <div class="player" data-player hidden>
      <div class="frame"></div>
    </div>
  </div>
</section>

<script>
  // With JavaScript the video plays here, in the privacy-friendly player,
  // instead of opening YouTube.
  const button = document.querySelector<HTMLAnchorElement>("[data-watch]");
  const player = document.querySelector<HTMLElement>("[data-player]");
  const frame = player?.querySelector<HTMLElement>(".frame");
  if (button && player && frame) {
    button.removeAttribute("target");
    button.removeAttribute("rel");
    button.querySelector("[data-watch-hint]")?.remove();
    const id = new URL(button.href).searchParams.get("v");
    button.addEventListener("click", (event) => {
      event.preventDefault();
      if (!player.hidden) {
        player.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = button.textContent?.trim() || "Video";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      player.hidden = false;
      player.scrollIntoView({ behavior: "smooth", block: "center" });
      iframe.focus();
    });
  }
</script>

<style>
  /* Night, lit as the references light it: violet at the top right, a
     little magenta at the bottom left, each sized in rem from its corner. */
  #about {
    position: relative;
    padding-block: calc(var(--space-xl) + var(--wave-h));
    background:
      radial-gradient(50rem 24rem at 100% 0, rgb(96 8 215 / 0.38), transparent 70%),
      radial-gradient(30rem 16rem at 0 100%, rgb(200 40 120 / 0.2), transparent 70%), var(--night);
  }

  #about :global(.wave-top),
  #about :global(.wave-bottom) {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--wave-h);
  }

  #about :global(.wave-top) {
    top: 0;
  }

  #about :global(.wave-bottom) {
    bottom: 0;
  }

  .grid {
    position: relative;
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  .portrait {
    position: relative;
    margin: 0;
    max-width: 26rem;
  }

  .portrait :global(.portrait-photo) {
    border-radius: var(--r-card);
    box-shadow:
      0 30px 80px rgb(0 0 0 / 0.45),
      0 0 0 1px rgb(255 255 255 / 0.14);
  }

  .copy p {
    font-size: var(--step-1);
    line-height: 1.5;
    color: #e3daf6;
  }

  .watch {
    margin-top: 0.5rem;
  }

  .watch svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .player {
    margin-top: var(--space-l);
  }

  .player[hidden] {
    display: none;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--r-card);
    background: #000;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.45);
  }

  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-xl);
    }
  }
</style>
