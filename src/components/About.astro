---
import { about, gallery } from "../data/site";
import Photo from "./Photo.astro";
import Wave from "./Wave.astro";

const watchUrl = `https://www.youtube.com/watch?v=${about.video.id}`;
// The ground the bottom wave lands on: the gallery's lilac when it shows
// (Gallery.astro shows it at four photos or more), otherwise the footer's
// navy (decision 70).
const nextGround = gallery.length >= 4 ? "lilac" : "footer";
---

<!-- Her portrait, her story, and her feature video, which loads only when asked for. -->
<section
  id="about"
  class="section section--night ground ground--night on-dark"
  aria-labelledby="about-title"
>
  <!-- The ribbons carry the lilac above into the night, and the night out
       onto what follows (decision 52): the footer, or the gallery when it
       shows. -->
  <!-- Each wave shows this section's own lit ground on its near side and
       continues the neighbouring ground on the far side (decision 67). -->
  <Wave kind="into-night" id="wc" aboveGround="lilac" below="none" class="wave-top" />
  <Wave kind="into-paper" id="wd" above="none" belowGround={nextGround} class="wave-bottom" />
  <div class="wrap">
    <div class="grid">
      <figure class="portrait plate">
        <Photo
          photo={about.portrait}
          ratio="4 / 5"
          sizes="(min-width: 56rem) 420px, calc(100vw - 2.5rem)"
          widths={[420, 632]}
          class="portrait-photo"
        />
      </figure>

      <div class="stack copy">
        <span class="eyebrow">{about.eyebrow}</span>
        <h2 id="about-title">{about.heading}</h2>
        {about.body.map((line) => (
          <p>{line}</p>
        ))}
        <p>
          <a
            class="button button--glass watch"
            href={watchUrl}
            target="_blank"
            rel="noopener"
            data-watch
          >
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path d="M6 4l10 6-10 6z" fill="currentColor" />
            </svg>
            {about.watchLabel}
            <span class="visually-hidden" data-watch-hint>
              {" "}
              (opens in a new tab on YouTube)
            </span>
          </a>
        </p>
      </div>
    </div>

    <div class="player" data-player hidden>
      <div class="frame"></div>
    </div>
  </div>
</section>

<script>
  // With JavaScript the video plays here, in the privacy-friendly player,
  // instead of opening YouTube.
  const button = document.querySelector<HTMLAnchorElement>("[data-watch]");
  const player = document.querySelector<HTMLElement>("[data-player]");
  const frame = player?.querySelector<HTMLElement>(".frame");
  if (button && player && frame) {
    button.removeAttribute("target");
    button.removeAttribute("rel");
    button.querySelector("[data-watch-hint]")?.remove();
    const id = new URL(button.href).searchParams.get("v");
    // The player is brought into view smoothly, or at once for a reader who
    // has asked for reduced motion (a script scroll ignores the stylesheet).
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const behavior = (): ScrollBehavior => (reduce.matches ? "auto" : "smooth");
    button.addEventListener("click", (event) => {
      event.preventDefault();
      if (!player.hidden) {
        player.scrollIntoView({ behavior: behavior(), block: "center" });
        return;
      }
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = button.textContent?.trim() || "Video";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      player.hidden = false;
      player.scrollIntoView({ behavior: behavior(), block: "center" });
      iframe.focus();
    });
  }
</script>

<style>
  /* A night ground (global.css): lit violet at the top right, a little
     magenta at the bottom left, and grained. */
  #about {
    overflow: clip; /* the portrait's pool of light bleeds past the column */
    padding-block: calc(var(--space-xl) + var(--wave-h));
  }

  #about :global(.wave-top),
  #about :global(.wave-bottom) {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--wave-h);
  }

  #about :global(.wave-top) {
    top: 0;
  }

  #about :global(.wave-bottom) {
    bottom: 0;
  }

  .grid {
    position: relative;
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  /* Her portrait stands in a pool of light on the night, rimmed like the
     surfaces, so it is lit rather than pasted on. */
  .portrait {
    position: relative;
    margin: 0;
    max-width: 26rem;
  }

  .portrait::after {
    content: "";
    position: absolute;
    inset: -18% -22%;
    z-index: -2;
    background: radial-gradient(
      closest-side,
      rgb(160 108 255 / 0.4),
      rgb(255 90 134 / 0.14) 55%,
      transparent 78%
    );
    pointer-events: none;
  }

  .portrait.plate::before {
    border-radius: var(--r-card);
    background: linear-gradient(135deg, rgb(160 108 255 / 0.45), rgb(255 90 134 / 0.35));
  }

  .portrait :global(.portrait-photo) {
    border-radius: var(--r-card);
    box-shadow:
      0 1.875rem 5rem rgb(0 0 0 / 0.45),
      0 0 0 var(--hairline) rgb(255 255 255 / 0.28),
      0 0 0 calc(var(--hairline) * 2) rgb(160 108 255 / 0.25);
  }

  .copy p {
    font-size: var(--step-1);
    line-height: 1.5;
    color: #e3daf6;
  }

  .watch {
    margin-top: 0.5rem;
  }

  .watch svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .player {
    margin-top: var(--space-l);
  }

  .player[hidden] {
    display: none;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--r-card);
    background: #000;
    box-shadow: 0 1.875rem 5rem rgb(0 0 0 / 0.45);
  }

  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* From tablets up her portrait stands beside her story. */
  @media (min-width: 36rem) {
    .grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-l);
    }
  }

  @media (min-width: 56rem) {
    .grid {
      gap: var(--space-xl);
    }
  }
</style>
