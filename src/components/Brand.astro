---
/**
 * The heart-and-hands mark and her script wordmark, as inline SVG.
 *
 * All are vector tracings of her logo files (scripts/brand/trace-brand.py,
 * scripts/brand/trace-lockup.py), so they stay sharp at every size. The
 * wordmark inherits `color`, so it is white on night and purple on paper; the
 * lockup (the script over "Supportive Services") is drawn on night only, in the
 * paint the layout renders once per page (BrandPaint.astro). Its file keeps the
 * artwork's own gradients so it previews on its own; here they are swapped for
 * that paint, so two copies on one page repeat no id.
 */
import Mark from "../assets/brand/mark.svg";
import Wordmark from "../assets/brand/wordmark.svg";
import lockupFile from "../assets/brand/wordmark-lockup.svg?raw";

type Props = {
  kind: "mark" | "wordmark" | "lockup";
  class?: string;
  /** Accessible name. Empty means decorative (hidden from screen readers). */
  label?: string;
};

const { kind, class: className, label = "Caring for a Cause" } = Astro.props;
const classes = [`brand-${kind}`, className];
const a11y = label
  ? ({ role: "img", "aria-label": label } as const)
  : ({ "aria-hidden": "true", focusable: "false" } as const);

const lockupPaths = lockupFile
  .replace(/^[\s\S]*<\/defs>/, "")
  .replace(/<\/svg>\s*$/, "")
  .replaceAll("url(#wl-script)", "url(#lockup-script)")
  .replaceAll("url(#wl-caps)", "url(#lockup-caps)");
const lockupViewBox = lockupFile.match(/viewBox="([^"]+)"/)?.[1];
if (!lockupViewBox || !lockupPaths.includes("url(#lockup-script)") || lockupPaths.includes("wl-")) {
  throw new Error("wordmark-lockup.svg no longer has the shape Brand.astro expects");
}
const Svg = kind === "mark" ? Mark : Wordmark;
---

{kind === "lockup" ? (
  <svg viewBox={lockupViewBox} class:list={classes} {...a11y} set:html={lockupPaths} />
) : (
  <Svg class:list={classes} {...a11y} />
)}

<style is:global>
  .brand-mark,
  .brand-wordmark,
  .brand-lockup {
    display: block;
    height: auto;
  }
</style>
