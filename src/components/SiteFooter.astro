---
import { claim, show } from "../data/facts.ts";
import { facts, org } from "../data/site";
import Brand from "./Brand.astro";

const phone = show(facts.phone);
const email = show(facts.email);

const year = new Date().getFullYear();
---

<!--
  The end of the page: her marks, her sign-off, how to reach her, and the
  legal record. No section links; a visitor here has just scrolled past them.
  The EIN and deductibility line live where a donor decides (the trust strip
  and the donation card), not here.
-->
<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="top">
      <div class="identity">
        <a class="brand" href="/" aria-label="Caring for a Cause home">
          <Brand kind="mark" class="mark" label="" />
          <Brand kind="wordmark" class="wordmark" label="" />
        </a>
        <p class="sign-off">{org.signOff}</p>
      </div>

      <ul class="contact" aria-label="Contact">
        <li>
          <a href={phone.href}>{phone.display}</a>
        </li>
        <li>
          <a class="email" href={`mailto:${email}`}>
            {email}
          </a>
        </li>
        <li>
          <a href={show(facts.facebook)} target="_blank" rel="noopener">
            Facebook<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="legal">
      <p>
        <strong>{claim(facts.legalName)}</strong>
        {show(facts.city)}. Serving {claim(facts.serviceArea)}.
      </p>
      <p class="copyright">
        &copy; {year} {claim(facts.legalName)}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background:
      radial-gradient(60% 50% at 0% 0%, rgb(96 8 215 / 0.3), transparent 60%), var(--night-2);
    color: var(--night-soft);
    padding-block: var(--space-xl) var(--space-m);
  }

  .top {
    display: grid;
    gap: var(--space-l);
    padding-bottom: var(--space-l);
    border-bottom: var(--hairline) solid rgb(255 255 255 / 0.12);
  }

  .identity {
    display: grid;
    gap: var(--space-m);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: #fff;
    text-decoration: none;
  }

  .brand :global(.mark) {
    width: 3rem;
    flex: none;
  }

  .brand :global(.wordmark) {
    width: min(100%, 16rem);
  }

  .sign-off {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .contact {
    display: grid;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* 44px tall tap targets (Apple's minimum). */
  .contact a {
    display: inline-flex;
    align-items: center;
    min-height: max(44px, 2.75rem);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .contact a:hover {
    text-decoration: underline;
  }

  .email {
    overflow-wrap: anywhere;
  }

  .legal {
    display: grid;
    gap: 0.5rem;
    padding-top: var(--space-m);
    font-size: var(--step--1);
  }

  .legal strong {
    display: block;
    color: #fff;
  }

  .copyright {
    margin-top: 0.5rem;
  }

  @media (min-width: 56rem) {
    .top {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .legal {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .copyright {
      margin-top: 0;
      text-align: right;
    }
  }
</style>
