---
import { claim, show } from "../data/facts.ts";
import { facts, navigation, org } from "../data/site";
import Brand from "./Brand.astro";

const phone = show(facts.phone);
const email = show(facts.email);

/** The same map the header and the phone menu draw (decision 38). */
const explore = [navigation.help, ...navigation.items];
const { donate } = navigation;
/** "Supportive Services": the rest of her name, as the phone menu shows it. */
const subName = org.name.replace(org.shortName, "").trim();

const year = new Date().getFullYear();
---

<!--
  The end of the page, built from the owner's reference picture (decision
  47): her marks and the one action, the same navigation map the header
  draws, how to reach her, a glowing rule, and the legal record as one line.
  The EIN and deductibility line live where a donor decides (the trust strip
  and the donation card), not here. Every size below is rem, so the footer is
  one picture per device class (decision 40); the desktop numbers are the
  reference's, converted at 1152 / 949 (the content column over the
  reference's), the phone and tablet compositions are drawn from them.
-->
<footer class="site-footer on-dark">
  <!-- Paint shared by the inline marks: the lettering's lavender light. -->
  <svg class="paint" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="ft-ink" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#d4b3f7"></stop>
        <stop offset="0.2" stop-color="#f1e5fe"></stop>
        <stop offset="0.42" stop-color="#faf1ff"></stop>
        <stop offset="0.64" stop-color="#e3cdfc"></stop>
        <stop offset="0.82" stop-color="#bc97ef"></stop>
        <stop offset="1" stop-color="#9878cc"></stop>
      </linearGradient>
      <linearGradient id="ft-ring" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#4a1fe8"></stop>
        <stop offset="1" stop-color="#2a0fc0"></stop>
      </linearGradient>
      <linearGradient id="ft-heart" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e2404c"></stop>
        <stop offset="1" stop-color="#c8202f"></stop>
      </linearGradient>
    </defs>
  </svg>

  <div class="top">
    <div class="wrap columns">
      <div class="identity">
        <a class="brand" href="/" aria-label={`${org.name}, home`}>
          <Brand kind="mark" class="mark" label="" />
          <Brand kind="wordmark" class="wordmark" label="" />
          <span class="sub">{subName}</span>
        </a>
        <a class="button donate" href={donate.href}>
          {donate.label}
          <svg class="chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m9 5 7 7-7 7"></path>
          </svg>
        </a>
        <p class="sign-off">{org.signOff}</p>
      </div>

      <nav class="col col--explore" aria-labelledby="explore-title">
        <h2 id="explore-title" class="col-title">
          Explore
        </h2>
        <ul class="links">
          {explore.map((item) => (
            <li>
              <a href={item.href}>
                <span>{item.label}</span>
                <svg class="chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="m9 5 7 7-7 7"></path>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <section class="col col--connect" aria-labelledby="connect-title">
        <h2 id="connect-title" class="col-title">
          Connect with us
        </h2>
        <ul class="contact">
          <li>
            <a href={phone.href}>
              <svg
                class="icon icon--phone"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  transform="translate(-2.6 -2.2) scale(1.2)"
                  d="M8.6 3.8 10 7.1a1.3 1.3 0 0 1-.4 1.5l-1.4 1a12.4 12.4 0 0 0 5.2 5.2l1-1.4a1.3 1.3 0 0 1 1.5-.4l3.3 1.4a1.3 1.3 0 0 1 .8 1.4l-.4 2.2a1.6 1.6 0 0 1-1.7 1.3A16.3 16.3 0 0 1 3.8 5.1 1.6 1.6 0 0 1 5.1 3.4l2.2-.4a1.3 1.3 0 0 1 1.3.8Z"
                ></path>
              </svg>
              <span class="value value--phone">{phone.display}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${email}`}>
              <svg class="icon icon--mail" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="1.5" y="3.4" width="21" height="17.2" rx="2.6"></rect>
                <path d="m2.4 5.6 8.4 6.2a2 2 0 0 0 2.4 0l8.4-6.2"></path>
              </svg>
              <span class="value value--email">{email}</span>
            </a>
          </li>
          <li>
            <a href={show(facts.facebook)} target="_blank" rel="noopener">
              <svg
                class="icon icon--facebook"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <rect x="1.5" y="1.5" width="21" height="21" rx="4.2"></rect>
                <path d="M15.6 6.4h-1.8a2.6 2.6 0 0 0-2.6 2.6V22.5M8.6 12.6h5.6"></path>
              </svg>
              <span class="value">
                Facebook<span class="visually-hidden"> (opens in a new tab)</span>
              </span>
            </a>
          </li>
        </ul>
      </section>

      <!-- The flare on the rule below: white-pink where the light breaks. -->
      <span class="flare" aria-hidden="true"></span>
    </div>
  </div>

  <div class="rule" aria-hidden="true"></div>

  <div class="record">
    <div class="wrap legal">
      <div class="row row--who">
        <Brand kind="mark" class="seal" label="" />
        <p class="name">{claim(facts.legalName)}</p>
      </div>
      <div class="row row--where">
        <p class="where">
          <svg class="pin" viewBox="0 0 24 34" aria-hidden="true" focusable="false">
            <path d="M12 32.4C12 32.4 1.4 21.2 1.4 12.6a10.6 10.6 0 0 1 21.2 0c0 8.6-10.6 19.8-10.6 19.8Z"></path>
            <circle cx="12" cy="12.4" r="4"></circle>
          </svg>
          <span class="city">{show(facts.city)}</span>
          <span class="dot"></span>
          <span class="serving">Serving {claim(facts.serviceArea)}</span>
        </p>
        <p class="copyright">
          <span class="c">&copy;</span> {year}
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /*
   * Colours are the reference's, sampled: near-black navy under the columns,
   * a step bluer under the record, lavender light on the lettering and the
   * lines, and the one crimson on the Donate button. Every size is rem, so
   * the footer is one picture per device class (decision 40). The desktop
   * numbers are the reference's, converted at 1152 / 949 (the content column
   * over the reference's); the phone and tablet compositions are drawn from
   * them.
   */
  .site-footer {
    --ink-soft: #d3bcf3; /* the tracked caps */
    --line: #b589e6; /* chevrons */
    --violet: #c199ea; /* drawn icons */
    --seal: #c4a2f6; /* the small mark's lines */
    --divider: rgb(215 205 240 / 0.55); /* the record's short rules */
    position: relative;
    color: #fff;
    background: #06012a;
  }

  .paint {
    position: absolute;
  }

  /* The top: the columns on the darkest ground, lit along its top edge and
     at its lower corners where the rule's light spills. The glows are sized
     in rem from the corners they belong to, per class (docs/DESIGN.md, the
     header's rule for painted decoration). */
  .top {
    --glow-top-w: 14rem;
    --glow-top-h: 4rem;
    --glow-end-w: 7rem;
    --glow-end-h: 5rem;
    position: relative;
    padding-top: 2.6rem;
    background:
      radial-gradient(
        var(--glow-end-w) var(--glow-end-h) at 0 100%,
        rgb(150 20 80 / 0.3),
        transparent 100%
      ),
      radial-gradient(
        var(--glow-end-w) var(--glow-end-h) at 100% 100%,
        rgb(170 30 100 / 0.38),
        transparent 100%
      ),
      linear-gradient(0deg, rgb(40 12 130 / 0.7) 0, rgb(30 8 110 / 0.3) 1rem, transparent 2.2rem),
      radial-gradient(
        var(--glow-top-w) var(--glow-top-h) at 100% 0,
        rgb(175 40 185 / 0.42),
        transparent 100%
      ),
      radial-gradient(
        var(--glow-top-w) var(--glow-top-h) at 0 0,
        rgb(105 20 175 / 0.32),
        transparent 100%
      ),
      linear-gradient(
        180deg,
        rgb(85 14 140 / 0.22) 0,
        rgb(50 8 100 / 0.1) 1.8rem,
        transparent 4.5rem
      ),
      #020018;
  }

  .columns {
    position: relative;
    display: grid;
  }

  /* Her marks, the one action, her sign-off: one centred stack. */
  .identity {
    display: grid;
    justify-items: center;
    padding-bottom: 1.7rem;
  }

  /* The link spans the column so it starts at the page's left edge like the
     header's brand (a test checks); its marks are centred inside it. */
  .brand {
    display: grid;
    justify-items: center;
    width: 100%;
    color: #fff;
    text-decoration: none;
  }

  /* The mark is lit: a night ring, a rose heart, violet hands, and a tight
     blue-violet glow, as the reference paints it. */
  .brand :global(.mark) {
    width: 5.6rem;
    filter: drop-shadow(0 0 0.2rem rgb(90 40 255 / 0.9))
      drop-shadow(0 0 0.55rem rgb(70 30 230 / 0.55));
  }
  .brand :global(.mark path[fill="#6008d7"]) {
    fill: url(#ft-ring);
  }
  .brand :global(.mark path[fill="#ba010c"]) {
    fill: url(#ft-heart);
  }
  .brand :global(.mark path[fill="#8a5bff"]) {
    fill: #5a12f4;
  }
  .brand :global(.mark path[fill="#f4eeff"]) {
    fill: #fbeefe;
  }

  /* Her lettering in the reference's lavender light, with a soft glow. It
     tucks up under the heart's point. */
  .brand :global(.wordmark) {
    width: 21.4rem;
    max-width: 100%;
    margin-top: -0.65rem;
    filter: drop-shadow(0 0 0.5rem rgb(170 110 255 / 0.45));
  }
  .brand :global(.wordmark path) {
    fill: url(#ft-ink);
  }

  /* "Supportive Services", tracked wide in the serif, as the reference sets
     it (an exception to the site's sentence-case rule, from her artwork). */
  .sub {
    margin-top: 0.7rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 0.98rem;
    line-height: 1;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-soft);
  }

  /* The one action: a glossy crimson pill, lit along its top rim and
     darkening to the bottom, in the serif. */
  .donate {
    position: relative;
    width: 11.4rem;
    min-height: max(44px, 2.85rem);
    margin-top: 1.1rem;
    padding: 0 0 0 0.2rem;
    gap: 1rem;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.12rem;
    letter-spacing: 0.01em;
    color: #fff;
    background: linear-gradient(
      180deg,
      #d84a66 0%,
      #dc3a5a 6%,
      #c72f44 17%,
      #b12337 30%,
      #921c25 45%,
      #78141b 62%,
      #661217 78%,
      #6b1019 92%,
      #7e1522 100%
    );
    box-shadow:
      inset 0 0.07rem 0 rgb(255 130 150 / 0.55),
      inset 0 -0.07rem 0 rgb(220 90 110 / 0.6),
      0 0 0.4rem rgb(140 10 45 / 0.9),
      0 0 1.4rem rgb(220 30 70 / 0.5);
  }

  .donate:hover {
    background: linear-gradient(
      180deg,
      #e85a76 0%,
      #ea4668 6%,
      #d43a50 17%,
      #bd2c41 30%,
      #9e222c 45%,
      #841a22 62%,
      #72161c 78%,
      #76141d 92%,
      #8a1a27 100%
    );
  }

  /* The chevron's ink is 7 by 14 of its 24 box, so the box is drawn larger
     and pulled in by its own padding. */
  .donate .chev {
    width: 1.27em;
    height: 1.27em;
    margin-left: -0.64em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Her sign-off: the serif, small and tracked open. */
  .sign-off {
    margin-top: 0.85rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 0.92rem;
    line-height: 1;
    letter-spacing: 0.17em;
    text-align: center;
    white-space: nowrap;
    color: #e7e1fa;
  }

  /* Column heads: the serif, bold, with a short rule in lavender, pink and
     crimson under each. */
  .col {
    position: relative;
    padding-bottom: 1.1rem;
  }

  .col-title {
    position: relative;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0;
    color: #fbfafe;
  }

  .col-title::after {
    content: "";
    position: absolute;
    left: 0;
    top: calc(100% + 0.7rem);
    width: 3.3rem;
    height: 0.25rem;
    border-radius: var(--r-pill);
    background: linear-gradient(90deg, #d5c6f0 0%, #dc95e8 50%, #c4506c 100%);
  }

  .links,
  .contact {
    display: grid;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .links a,
  .contact a {
    display: flex;
    align-items: center;
    color: #f8f7fe;
    font-family: var(--font-footer);
    font-weight: 400;
    font-size: 1.12rem;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
  }

  .links a {
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding-right: 0.15rem;
  }

  .contact a {
    gap: 1.1rem;
    min-height: 2.9rem;
  }

  /* Apple's 44px is a minimum for fingers, so it is held where the pointer
     is coarse rather than at every width: a row is otherwise its reference
     height and scales with the class, so every screen of a class is one
     composition (decision 43). */
  @media (pointer: coarse) {
    .links a,
    .contact a {
      min-height: 44px;
    }
  }

  /* The chevron's ink is 7 by 14 of its 24 box. */
  .links .chev {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
    fill: none;
    stroke: var(--line);
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The icons are drawn to the edges of their box. */
  .icon {
    width: 1.85rem;
    height: 1.85rem;
    flex: none;
    fill: none;
    stroke: var(--violet);
    stroke-width: 1.45;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon--phone {
    stroke: #d476e9;
    stroke-width: 1.2;
  }

  .icon--mail {
    stroke: #d5b4f6;
  }

  /* The figures are set a touch open: the face's are narrower than the
     reference's. */
  .value--phone {
    letter-spacing: 0.055em;
  }

  /* Her address as she writes it, in the lower case the reference shows. */
  .value--email {
    text-transform: lowercase;
  }

  .links a:hover span,
  .contact a:hover .value {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .links a:hover .chev,
  .contact a:hover .icon {
    stroke: #fff;
  }

  /* The rule: a hairline lit violet to magenta across the whole width, with
     a tight bloom, and the flare above where the light breaks white. */
  .rule {
    position: relative;
    z-index: 1;
    height: max(1px, 0.12rem);
    background: linear-gradient(
      90deg,
      #6f166a 0%,
      #8c2cd6 5%,
      #9482f2 13%,
      #7f3fc4 26%,
      #c341df 38%,
      #dc63c4 43%,
      #e888d6 46%,
      #ce43ba 53%,
      #b040e8 60%,
      #7f4ad8 73%,
      #a086f4 81%,
      #c8a0fb 90%,
      #cf64e8 94%,
      #a1298b 100%
    );
    box-shadow:
      0 0 0.25rem rgb(220 150 255 / 0.9),
      0 -0.15rem 0.7rem rgb(130 70 240 / 0.55);
  }

  /* The flare sits on the rule: a low magenta bloom above it and a hot
     white-pink core along it. Placed from the column's left edge in rem, so
     it keeps its place under the Explore head on every screen of a class. */
  .flare {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 2;
    width: 13rem;
    height: 2.2rem;
    transform: translate(-50%, 50%);
    pointer-events: none;
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgb(250 150 220 / 0.55) 0%,
      rgb(235 100 200 / 0.3) 18%,
      rgb(205 60 175 / 0.14) 40%,
      rgb(170 40 160 / 0.05) 62%,
      transparent 80%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0,
      #000 50%,
      rgb(0 0 0 / 0.3) 58%,
      transparent 70%
    );
    mask-image: linear-gradient(180deg, #000 0, #000 50%, rgb(0 0 0 / 0.3) 58%, transparent 70%);
  }

  .flare::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11rem;
    height: max(1px, 0.14rem);
    transform: translate(-50%, -50%);
    border-radius: var(--r-pill);
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgb(255 190 232 / 0.55) 18%,
      rgb(255 225 243 / 0.95) 40%,
      #fff5fc 50%,
      rgb(255 225 243 / 0.95) 60%,
      rgb(255 190 232 / 0.55) 82%,
      transparent 100%
    );
    box-shadow: 0 0 0.4rem rgb(255 190 235 / 0.8);
  }

  /* The record: on a step bluer ground, over a faint hairline and a lit
     lower edge. The hairline's place is the record's own height less the
     band under it. */
  .record {
    --band: 2.6rem;
    position: relative;
    padding-bottom: var(--band);
    background:
      linear-gradient(0deg, rgb(70 30 170 / 0.14) 0, transparent 2rem),
      linear-gradient(
        0deg,
        transparent 0,
        transparent var(--band),
        rgb(130 106 210 / 0.5) var(--band),
        rgb(130 106 210 / 0.5) calc(var(--band) + var(--hairline)),
        transparent calc(var(--band) + var(--hairline))
      ),
      linear-gradient(0deg, #06012a 0, #06012a var(--band), #03012a var(--band));
  }

  /* Phones: three centred rows. */
  .legal {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    padding: 1.7rem 0 1.5rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 0.86rem;
    line-height: 1;
  }

  .row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .legal p {
    max-width: none;
    white-space: nowrap;
  }

  /* Her mark drawn in lines: the silhouette and the keylines in lavender,
     the heart and the hands in the ground's own colour. */
  .legal :global(.seal) {
    width: 2.5rem;
  }
  .legal :global(.seal path[fill="#6008d7"]),
  .legal :global(.seal path[fill="#f4eeff"]) {
    fill: var(--seal);
  }
  .legal :global(.seal path[fill="#ba010c"]),
  .legal :global(.seal path[fill="#8a5bff"]) {
    fill: #03012a;
  }

  .legal .name {
    color: #eae6fb;
  }

  .where {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #d7cdf3;
  }

  .where .city {
    color: #cfbded;
  }

  .pin {
    width: 1.2rem;
    height: 1.7rem;
    flex: none;
    fill: none;
    stroke: #ac76e5;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dot {
    width: 0.25rem;
    height: 0.25rem;
    flex: none;
    border-radius: 50%;
    background: #8a72c4;
  }

  .copyright {
    color: #dcd4f1;
  }

  /* The copyright sign, set larger as the reference draws it. */
  .copyright .c {
    position: relative;
    top: 0.04em;
    margin-right: 0.16em;
    font-size: 1.5em;
    line-height: 0;
  }

  /*
   * Tablets: the lockup centred above the two lists, which sit side by side
   * with the reference's divider between them; the record in two rows, a
   * short rule inside each.
   */
  @media (min-width: 36rem) {
    .top {
      --glow-top-w: 24rem;
      --glow-top-h: 5rem;
      --glow-end-w: 9rem;
      --glow-end-h: 6rem;
      padding-top: 3rem;
    }

    .columns {
      grid-template-columns: 19.04rem 1fr;
    }

    .identity {
      grid-column: 1 / -1;
      padding-bottom: 2.8rem;
    }

    .brand :global(.mark) {
      width: 6.4rem;
    }

    .brand :global(.wordmark) {
      width: 25rem;
      margin-top: -0.8rem;
    }

    .sub {
      margin-top: 0.8rem;
      font-size: 1.15rem;
    }

    .donate {
      width: 13rem;
      min-height: max(44px, 3.2rem);
      margin-top: 1.25rem;
      font-size: 1.26rem;
    }

    .sign-off {
      margin-top: 0.95rem;
      font-size: 1.02rem;
    }

    .col {
      padding-bottom: 2.4rem;
    }

    .col--connect {
      padding-left: 2.5rem;
    }

    /* The divider: a hairline that brightens in over its first quarter and
       fades out above the rule, the reference's profile. */
    .col--connect::before {
      content: "";
      position: absolute;
      left: 0;
      top: -0.6rem;
      bottom: 0.4rem;
      width: var(--hairline);
      background: linear-gradient(
        180deg,
        transparent 0%,
        rgb(224 220 240 / 0.45) 8%,
        rgb(224 220 240 / 0.8) 17%,
        #e0dcf0 25%,
        #e0dcf0 42%,
        rgb(224 220 240 / 0.87) 54%,
        rgb(224 220 240 / 0.76) 71%,
        rgb(224 220 240 / 0.5) 87%,
        rgb(224 220 240 / 0.2) 96%,
        transparent 100%
      );
    }

    .col-title {
      font-size: 1.7rem;
    }

    .col-title::after {
      top: calc(100% + 0.85rem);
      width: 3.8rem;
      height: 0.28rem;
    }

    .links,
    .contact {
